@import "styles/icons.wxss";

page {
  --ink: #403735;
  --muted: #897c76;
  --orange: #e67b5d;
  --orange-soft: #fff0e7;
  --cream: #fffaf7;
  --line: #f4e7e0;
  background: var(--cream);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 56rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.eyebrow {
  color: var(--orange);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 600;
}

.section-title {
  margin: 38rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  background: #fff;
  box-shadow: none;
}

.primary-btn,
.ghost-btn {
  width: 100%!important;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.primary-btn {
  color: #643b2d;
  background: #ffbd9c;
  box-shadow: none;
}

.ghost-btn {
  border: 2rpx solid #f1dfd4;
  color: var(--orange);
  background: #fff;
}

button::after{ border: 0; }

/* Keep touch scrolling available without exposing platform scroll tracks. */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
  color: transparent;
}

.muted{ color: var(--muted); }

.empty {
  padding: 60rpx 30rpx;
  text-align: center;
  color: var(--muted);
}

.overlay {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(43, 34, 28, .38);
}

.sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 34rpx 30rpx calc(38rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  font-size: 34rpx;
  font-weight: 600;
  gap: 20rpx;
}

.sheet-head > .close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  color: var(--muted);
  font-size: 40rpx;
}

.field{ margin-bottom: 22rpx; }
.label{ display: block; margin-bottom: 10rpx; color: #766d66; font-size: 24rpx; font-weight: 700; }
.input {
  width: 100%;
  height: 84rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--cream);
  font-size: 28rpx;
}

.empty-companion { display:flex;align-items:center;justify-content:center;width:112rpx;height:112rpx;margin:0 auto 24rpx;border-radius:40rpx;background:#fff0e5; }
.empty-companion .warm-icon { width:60rpx;height:60rpx; }

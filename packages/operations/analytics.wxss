/* 覆盖小程序原生 button 的默认定宽，保证表头和数据列对齐。 */
.stats-page .refresh,.stats-page .section-heading button{width:auto!important;flex:none;max-width:240rpx}
.stats-page .module-row{width:100%!important;box-sizing:border-box}
.stats-page .source-switch button,.stats-page .range-switch button{width:0;min-width:0}
.dashboard-tabs{margin:22rpx 0;white-space:nowrap}.dashboard-tabs>view{display:flex;gap:10rpx}.stats-page .dashboard-tabs button{width:auto!important;flex:none;margin:0;padding:12rpx 20rpx;border-radius:30rpx;background:#f0f5ee;color:#7b8e7f;font-size:24rpx;line-height:1.6}.dashboard-tabs button.active,.feedback-filters button.active{background:#52785e!important;color:white!important}.ops-totals{grid-template-columns:repeat(2,minmax(0,1fr))}.retention-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.retention-grid .stats-card{padding:24rpx}.retention-value{font-size:40rpx;line-height:1.4;color:#52785e;margin-bottom:12rpx;font-weight:600}.daily-metrics{display:flex;flex-wrap:wrap;gap:12rpx 28rpx;margin-top:26rpx;font-size:21rpx;color:#87998b}.daily-metrics>view{display:flex;gap:12rpx}.daily-metrics>view>text:first-child{color:#52785e}.funnel-step{display:flex;gap:16rpx;align-items:center;padding:18rpx 0;border-top:1rpx solid #edf2ec}.step-number{width:38rpx;height:38rpx;line-height:38rpx;text-align:center;background:#edf4eb;color:#688d6e;border-radius:50%;font-size:22rpx;flex:none}.step-label{flex:1;min-width:0;font-size:26rpx}.step-label>text{font-size:21rpx;color:#8a9a8e}.step-count{text-align:right;font-size:30rpx;font-weight:600;color:#52785e}.step-count>text{display:block;font-size:21rpx;font-weight:400;color:#91a096}.channel-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx;text-align:center}.channel-metrics>view>text{display:block;font-size:34rpx;color:#52785e}.channel-metrics>view>text+text{font-size:21rpx;color:#8a9a8d;margin-top:8rpx}.feedback-filters{display:flex;gap:12rpx;margin-top:22rpx}.stats-page .feedback-filters button{flex:1;min-width:0;width:0!important;margin:0;background:#edf4eb;color:#718b77;font-size:23rpx;line-height:2.5;padding:0}.feedback-status{font-size:23rpx;color:#75917d;font-weight:400}.feedback-item .section-heading{display:flex;justify-content:space-between}.feedback-message{displa
/* scroll-view 会插入内部节点，使用明确类名保证页签横向排列。 */
.dashboard-tabs-inner{display:inline-flex;align-items:center;gap:10rpx;white-space:nowrap}
.stats-page .stats-heading .refresh{margin:0 0 0 auto}


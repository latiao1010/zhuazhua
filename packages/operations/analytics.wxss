page{background:#f8fbf7;color:#344b3e}.stats-page{padding:28rpx 24rpx 60rpx}.stats-heading,.section-heading{display:flex;align-items:center;justify-content:space-between}.eyebrow{font-size:23rpx;color:#87988a}.stats-title{font-size:38rpx;font-weight:650;margin-top:8rpx}.refresh,.section-heading button{margin:0;padding:8rpx 20rpx;line-height:1.8;font-size:24rpx;color:#52785e;background:#ecf3ed;border-radius:16rpx}button::after{border:0}.source-switch,.range-switch{display:flex;gap:12rpx;margin:26rpx 0 16rpx}.source-switch button,.range-switch button{flex:1;margin:0;padding:14rpx 0;font-size:25rpx;line-height:1.4;background:#fff;border:1rpx solid #e2eae3;border-radius:16rpx;color:#6e8074}.source-switch .active,.range-switch .active{background:#52785e;color:white;border-color:#52785e}.stats-note,.date-caption{font-size:23rpx;color:#829087;line-height:1.7}.date-caption{margin:18rpx 0}.totals{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rpx;background:#e6eee7;border:1rpx solid #e6eee7;border-radius:24rpx;overflow:hidden}.totals>view{background:#fff;padding:25rpx 8rpx;display:flex;flex-direction:column;align-items:center;gap:8rpx}.totals>view>text:first-child{font-size:40rpx;font-weight:650}.totals>view>text:last-child{font-size:23rpx;color:#829087}.stats-card{margin-top:22rpx;padding:24rpx 18rpx;background:white;border:1rpx solid #e3ece4;border-radius:24rpx}.section-heading{font-size:28rpx;font-weight:600;margin-bottom:18rpx}.trend{display:flex;gap:4rpx;height:174rpx;align-items:flex-end}.trend-day{flex:1;min-width:0;height:100%;position:relative}.trend-bar-space{height:138rpx;display:flex;align-items:flex-end;justify-content:center}.trend-bar{background:#9dbca3;width:70%;max-width:40rpx;border-radius:6rpx 6rpx 0 0}.trend-day>text{position:absolute;bottom:0;left:50%;transform:translateX(-50%);font-size:17rpx;white-space:nowrap;color:#829087}.table-head,.module-row{display:grid;grid-template-columns:minmax(190rpx,2.4fr) repeat(4,minmax(0,1fr));gap:8rpx;
<template name="place-card">
  <view class="place-card" data-id="{{item.id}}" bindtap="openPlace">
    <view class="place-top">
      <view class="place-heading">
        <view class="place-name">{{item.name}}</view>
        <view class="place-meta"><text class="place-category {{item.categoryId}}">{{item.category}}</text><text wx:if="{{showCity}}">{{item.city}}</text><text wx:if="{{showCity}}" class="meta-divider">·</text><text>{{item.sourceCount}} 条参考</text></view>
      </view>
      <button class="save-button {{item.saved ? 'is-saved' : ''}}" data-id="{{item.id}}" catchtap="toggleSaved" aria-label="{{item.saved ? '取消收藏' : '收藏地点'}}">{{item.saved ? '♥' : '♡'}}</button>
    </view>
    <view class="place-address"><view class="location-mark" aria-hidden="true"></view><text class="place-location">{{item.location}}</text></view>
    <view class="place-tags" wx:if="{{item.tags.length}}"><text class="tag-label">携宠线索</text><text class="policy-tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view>
    <view class="place-bottom"><text class="status {{item.status}}">{{item.statusLabel}}</text><view class="place-action">携宠详情<text>›</text></view></view>
  </view>
</template>

<import src="cards.wxml" />
<view class="outing-page">
  <view class="outing-header"><button class="city-button" bindtap="openCities">{{city}}<text>⌄</text></button><button class="text-button" bindtap="openSaved">我的清单<text wx:if="{{favoriteCount}}"> · {{favoriteCount}}</text> ›</button></view>
  <view class="outing-hero"><view class="hero-copy"><text class="eyebrow">带狗出门</text><view class="hero-title"><view>下一站，</view><view>也带上它。</view></view><text class="hero-sub">找个能一起吃饭、散步的地方</text></view><view class="hero-art" aria-hidden="true"><view class="art-sun"></view><view class="art-hill hill-back"></view><view class="art-hill hill-front"></view><view class="art-path"></view><view class="art-paw">🐾</view></view></view>
  <view class="browse-tools"><view class="search-row"><view class="search-box"><text class="search-mark">⌕</text><input value="{{query}}" bindinput="search" bindconfirm="searchNow" placeholder="搜店名、商圈或区县" confirm-type="search" maxlength="60"/><button wx:if="{{query}}" class="clear-button" bindtap="clearSearch" aria-label="清空搜索">×</button></view><button class="filter-button {{filterCount ? 'active' : ''}}" bindtap="openFilters">筛选{{filterCount ? ' · ' + filterCount : ''}}</button></view>
    <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}"><view class="category-list"><button wx:for="{{categories}}" wx:key="id" id="outing-category-{{item.id}}" data-id="{{item.id}}" bindtap="chooseCategory" class="category-chip {{categoryId === item.id ? 'selected' : ''}}">{{item.label}}</button></view></scroll-view>
  </view>
  <view class="list-heading"><view>{{hasSearch ? '找到 ' + total + ' 处地点' : '在' + city + '，一起去看看'}}</view><text wx:if="{{!hasSearch}}">{{total}} 处地点</text><button wx:else class="text-button" bindtap="resetFilters">重置</button></view>
  <view class="list-note">整理自携宠出行分享，门店规则请出发前确认。</view>
  <template wx:for="{{rows}}" wx:key="id" is="place-card" data="{{item}}" />
  <view class="outing-empty" wx:if="{{!total}}"><view class="empty-symbol">⌕</view><view>{{cityCount ? '暂时没有符合条件的地点' : '这个城市的地点正在整理'}}</view><text>{{cityCount ? '未写明携宠条件的地点不会出现在对应筛选中。试试减少条件，或换个关键词。' : '可以切换到已有资料的城市，或下次再来看看。'}}</text><button class="outing-primary" bindtap="emptyAction">{{cityCount ? '查看本城全部地点' : '查看其他城市'}}</button></view>
  <button class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">再看看更多地点 ↓</button>
  <view class="end-note" wx:elif="{{total}}">愿每次出门，都有它的位置。</view>
</view>
<view class="outing-mask" wx:if="{{cityOpen}}" catchtap="closeCities" catchtouchmove="noop"><view class="outing-sheet" catchtap="noop"><view class="sheet-title"><view>想去哪个城市？</view><button class="close-button" bindtap="closeCities">×</button></view><view class="search-box"><text class="search-mark">⌕</text><input value="{{cityQuery}}" bindinput="searchCity" placeholder="输入城市或省份" maxlength="40"/></view><view class="sheet-hint">{{cityQuery ? '选择城市后查看已有地点' : availableCityCount + ' 个城市已有地点资料'}}</view><scroll-view scroll-y class="city-scroll"><button class="city-row {{city === item.name ? 'current' : ''}}" wx:for="{{cityOptions}}" wx:key="name" data-city="{{item.name}}" bindtap="chooseCity"><view>{{item.name}}<text>{{item.province}}</text></view><text>{{item.count ? item.count + ' 处地点' : '正在整理'}}</text></button><view class="outing-empty compact" wx:if="{{!cityOptions.length}}">没有找到这个城市，试试输入省份或完整城市名。</view></scroll-view></view></view>
<view class="outing-mask" wx:if="{{filterOpen}}" catchtap="closeFilters" catchtouchmove="noop"><view class="outing-sheet" catchtap="noop"><view class="sheet-title"><view>这次出门，有什么需要？</view><button class="close-button" bindtap="closeFilters">×</button></view><view class="sheet-hint">多项条件同时满足。仅根据明确线索筛选，仍需向门店确认当前规则。</view><button wx:for="{{filterOptions}}" wx:key="id" class="filter-option {{item.selected ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggleFilter"><text>{{item.label}}</text><text class="check-box">{{item.selected ? '✓' : ''}}</text></button><view class="sheet-actions"><button class="outing-secondary" bindtap="clearDraft">清空</button><button class="outing-primary" bindtap="applyFilters">查看地点{{draftFilters.length ? ' · ' + draftFilters.length + ' 项条件' : ''}}</button></view></view></view>

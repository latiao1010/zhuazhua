<import src="cards.wxml" />
<view class="outing-page">
  <view class="outing-header"><button class="city-button" bindtap="openCities">{{city}}<text>⌄</text></button><button class="text-button" bindtap="openSaved">我的清单<text wx:if="{{favoriteCount}}"> · {{favoriteCount}}</text> ›</button></view>
  <view class="outing-intro">
    <view class="intro-title">今天，带它去哪？</view>
    <text class="intro-sub">一起吃饭、散步，也一起看新风景</text>
  </view>
  <view class="browse-tools">
    <view class="search-row">
      <view class="search-box"><view class="search-mark" aria-hidden="true"></view><input value="{{query}}" bindinput="search" bindconfirm="searchNow" placeholder="搜店名、商圈或区县" confirm-type="search" maxlength="60"/><button wx:if="{{query}}" class="clear-button" bindtap="clearSearch" aria-label="清空搜索">×</button></view>
      <button class="filter-button {{filterCount ? 'active' : ''}}" bindtap="openFilters">筛选{{filterCount ? ' · ' + filterCount : ''}}</button>
    </view>
    <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}" scroll-into-view="outing-category-{{categoryId}}" scroll-with-animation><view class="category-list"><button wx:for="{{categories}}" wx:key="id" id="outing-category-{{item.id}}" data-id="{{item.id}}" bindtap="chooseCategory" class="category-chip {{categoryId === item.id ? 'selected' : ''}}">{{item.label}}</button></view></scroll-view>
    <scroll-view wx:if="{{activeFilters.length}}" class="active-filter-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="active-filter-list"><text class="active-filter-label">已选</text><button wx:for="{{activeFilters}}" wx:key="id" class="active-filter" data-id="{{item.id}}" bindtap="removeFilter" aria-label="取消{{item.short}}条件">{{item.short}}<text>×</text></button></view>
    </scroll-view>
  </view>
  <view class="list-heading">
    <view class="list-title">{{resultTitle}}<text class="list-count">{{total}} 处</text></view>
    <button wx:if="{{hasSearch}}" class="text-button" bindtap="resetFilters">查看全部</button>
  </view>
  <view class="list-note"><text class="note-dot"></text>整理自出行分享，携宠规则请在出发前确认</view>
  <template wx:for="{{rows}}" wx:key="id" is="place-card" data="{{item}}" />
  <view class="outing-empty" wx:if="{{!total}}">
    <view class="empty-symbol">⌕</view>
    <view>{{cityCount ? '暂时没有符合条件的地点' : '这个城市的地点正在整理'}}</view>
    <text>{{cityCount ? (filterCount ? '只展示已写明携宠条件的地点。可以先取消条件，保留当前分类和关键词再看看。' : '试试搜索店名、商圈或区县，也可以换个分类。') : '可以切换到已有资料的城市，或下次再来看看。'}}</text>
    <button wx:if="{{cityCount && filterCount}}" class="outing-primary" bindtap="clearFilters">仅清除携宠条件</button>
    <button class="{{cityCount && filterCount ? 'empty-secondary' : 'outing-primary'}}" bindtap="emptyAction">{{cityCount ? '查看本城全部地点' : '查看其他城市'}}</button>
  </view>
  <button class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">再看看更多地点 ↓</button>
  <view class="end-note" wx:elif="{{total}}">愿每次出门，都有它的位置。</view>
</view>
<view class="outing-mask" wx:if="{{cityOpen}}" catchtap="closeCities" catchtouchmove="noop"><view class="outing-sheet" catchtap="noop"><view class="sheet-title"><view>想去哪个城市？</view><button class="close-button" bindtap="closeCities">×</button></view><view class="search-box"><text class="search-mark">⌕</text><input value="{{cityQuery}}" bindinput="searchCity" placeholder="输入城市或省份" maxlength="40"/></view><view class="sheet-hint">{{cityQuery ? '选择城市后查看已有地点' : availableCityCount + ' 个城市已有地点资料'}}</view><scroll-view scroll-y class="city-scroll"><button class="city-row {{city === item.name ? 'current' : ''}}" wx:for="{{cityOptions}}" wx:key="name" data-city="{{item.name}}" bindtap="chooseCity"><view>{{item.name}}<text>{{item.province}}</text></view><text>{{item.count ? item.count + ' 处地点' : '正在整理'}}</text></button><view class="outing-empty compact" wx:if="{{!cityOptions.length}}">没有找到这个城市，试试输入省份或完整城市名。</view></scroll-view></view></view>
<view class="outing-mask" wx:if="{{filterOpen}}" catchtap="closeFilters" catchtouchmove="noop">
  <view class="outing-sheet filter-sheet" catchtap="noop">
    <view class="sheet-title"><view>按携宠需要筛选</view><button class="close-button" bindtap="closeFilters" aria-label="关闭筛选">×</button></view>
    <view class="filter-scope">{{city}} · {{categoryId === 'all' ? '全部分类' : categoryLabel}}<text wx:if="{{query}}"> · 关键词：{{query}}</text></view>
    <view class="sheet-hint">多选时需同时满足，未写明条件的地点不展示。</view>
    <button wx:for="{{filterOptions}}" wx:key="id" class="filter-option {{item.selected ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggleFilter"><text>{{item.label}}</text><text class="check-box">{{item.selected ? '✓' : ''}}</text></button>
    <view wx:if="{{!draftTotal}}" class="filter-empty-note">暂时没有匹配地点，试试减少条件或更换关键词。</view>
    <view class="sheet-actions"><button class="outing-secondary" bindtap="clearDraft">清空条件</button><button class="outing-primary" bindtap="applyFilters">{{draftTotal ? '查看 ' + draftTotal + ' 处地点' : '查看筛选结果'}}</button></view>
  </view>
</view>

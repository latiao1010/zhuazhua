.account-page .care-dashboard{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;padding:0;border-radius:0;background:transparent;box-shadow:none}.care-dashboard .care-divider{display:none}.account-page .care-dashboard .care-plan-row{display:grid;grid-template-columns:52rpx 1fr 26rpx;grid-template-rows:52rpx auto auto;box-sizing:border-box;min-height:158rpx;margin:0;padding:17rpx;border:0;border-radius:28rpx;box-shadow:0 12rpx 30rpx rgba(75,63,55,.055)}.care-dashboard .care-plan-icon{grid-column:1;grid-row:1;width:52rpx;height:52rpx;border-radius:18rpx;background:rgba(255,255,255,.7);box-shadow:0 6rpx 16rpx rgba(80,65,55,.06)}.care-dashboard .care-arrow{grid-column:3;grid-row:1;align-self:center;justify-self:end;margin:0;color:rgba(77,65,58,.45);font-size:31rpx}.care-dashboard .care-plan-copy{grid-column:1/4;grid-row:2;margin:12rpx 0 0}.care-dashboard .care-plan-copy>view{font-size:23rpx}.account-page .care-dashboard .care-countdown{grid-column:1/4;grid-row:3;align-self:end;justify-self:start;margin:10rpx 0 0;padding:7rpx 12rpx;border:1rpx solid rgba(255,255,255,.7);background:rgba(255,255,255,.64);font-size:18rpx;box-shadow:none}.care-dashboard .care-deworming{background:linear-gradient(145deg,#f3efdc,#faf7ed)}.care-dashboard .care-vaccine{background:linear-gradient(145deg,#ffe9e2,#fff5f1)}.care-dashboard .care-bath{background:linear-gradient(145deg,#e3f2f0,#f2f9f7)}.care-dashboard .care-dental{background:linear-gradient(145deg,#e9ecf8,#f6f7fc)}.account-page .care-dashboard .care-nail{grid-column:1/-1;grid-template-columns:52rpx 1fr auto 26rpx;grid-template-rows:52rpx;min-height:94rpx;background:linear-gradient(145deg,#f3e8f0,#fbf5f9)}.care-dashboard .care-nail .care-plan-icon{grid-column:1;grid-row:1}.care-dashboard .care-nail .care-plan-copy{grid-column:2;grid-row:1;align-self:center;margin:0 0 0 15rpx}.account-page .care-dashboard .care-nail .care-countdown{grid-column:3;grid-row:1;align-self:center;margin:0 9rpx 0 0}.care-dashboard .care-nail 
.care-full-page{position:fixed;z-index:100;inset:0;box-sizing:border-box;overflow-y:auto;padding:calc(30rpx + env(safe-area-inset-top)) 28rpx 50rpx;background:#f7f8fa;color:#111}.care-full-top{position:relative;display:grid;grid-template-columns:90rpx 1fr 90rpx;align-items:start;min-height:120rpx}.care-back{display:flex;align-items:center;width:90rpx;height:80rpx;margin:-6rpx 0 0 -12rpx;padding-left:12rpx;box-sizing:border-box}.care-back text{font-size:54rpx;font-weight:300;line-height:68rpx}.care-top-title{text-align:center}.care-top-title>view{font-size:34rpx;font-weight:900;line-height:48rpx}.care-top-title picker text{display:block;margin-top:4rpx;font-size:24rpx}.care-more{font-size:50rpx;line-height:62rpx;text-align:right}.care-more-space{width:90rpx}.care-menu{position:absolute;z-index:3;right:0;top:72rpx;width:300rpx;padding:15rpx 0;border-radius:28rpx;background:#fff;box-shadow:0 18rpx 50rpx rgba(0,0,0,.15)}.care-menu view{padding:22rpx 38rpx;font-size:27rpx;font-weight:800}.care-calendar-card{margin-top:72rpx;padding:38rpx 30rpx 24rpx;border-radius:34rpx;background:#fff;box-shadow:0 10rpx 35rpx rgba(55,63,73,.035)}.calendar-summary>view{font-size:38rpx;font-weight:800}.calendar-summary>text{display:block;margin-top:10rpx;color:#aaa;font-size:22rpx}.calendar-divider{height:1rpx;margin:30rpx 0;background:#ededed}.calendar-legend{display:flex;gap:50rpx;color:#9f9f9f;font-size:20rpx}.calendar-legend view{display:flex;align-items:center}.legend-dot{width:22rpx;height:22rpx;margin-right:9rpx;border-radius:50%}.legend-dot.recorded{background:#ff795c}.legend-dot.selected{box-sizing:border-box;border:3rpx solid #ff795c;background:#fff}.calendar-week,.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr)}.calendar-week{margin-top:34rpx}.calendar-week text{text-align:center;font-size:20rpx;font-weight:700}.calendar-grid{margin-top:19rpx;row-gap:12rpx}.calendar-day{display:flex;align-items:center;justify-content:center;height:64rpx;font-size:24rpx}.calendar-day text{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;border-radius:50%}.calendar-day.muted{color:#c9c9c9}.calendar-day.disabled{color:#d9d9d9}.calendar-day.recorded text{color:#fff;background:#ff795c}.calendar-day.selected text{box-sizing:border-box;border:3rpx solid #151515}.calendar-day.today:not(.recorded) text{color:#ff6748;background:#fff0eb}.calendar-divider.bottom{margin:28rpx 0 20rpx}.calendar-record-row{display:flex;align-items:center;justify-content:space-between}.calendar-record-row>view>text{font-size:27rpx;font-weight:900}.calendar-record-row>view>view{margin-top:6rpx;color:#aaa;font-size:18rpx}.calendar-record-row button{height:66rpx;margin:0;padding:0 24rpx;border-radius:99rpx;color:#fff;background:#ff795c;font-size:22rpx;font-weight:800;line-height:66rpx}.care-subtitle{margin:70rpx 12rpx 22rpx;font-size:42rpx;font-weight:900}.history-list-card,.care-settings-card{padding:0 25rpx;border-radius:30rpx;background:#fff}.history-empty{padding:70rpx 0;color:#aaa;text-align:center}.history-list-row{display:flex;align-items:center;justify-content:space-between;min-height:104rpx;border-bottom:1rpx solid #eee}.history-list-row:last-child{border-bottom:0}.history-list-row>view>text{font-size:25rpx;font-weight:900}.history-list-row>view>view{margin-top:5rpx;color:#999;font-size:19rpx}.history-list-row>text{color:#999;font-size:19rpx}.settings-group-title{margin:34rpx 12rpx 14rpx;color:#9297a8;font-size:24rpx}.care-settings-row{display:flex;align-items:center;justify-content:space-between;min-height:112rpx;border-bottom:1rpx solid #eee}.care-settings-row:last-child{border-bottom:0}.care-settings-row>view:first-child>text{font-size:27rpx;font-weight:900}.care-settings-row>view:first-child>view{margin-top:5rpx;color:#aaa;font-size:20rpx}.care-settings-row picker text{color:#777;font-size:22rpx}.settings-save-btn{height:86rpx;margin-top:34rpx;border-radius:24rpx;color:#fff;background:#ff795c;font-size:26rpx;font-weight:900;line-height:86rpx}

/* Supply tracker */
.supply-heading{display:flex;align-items:flex-end;justify-content:space-between;margin:38rpx 2rpx 14rpx}.supply-heading>view{color:#332c28;font-size:30rpx;font-weight:900}.supply-heading>text{color:#8c8179;font-size:18rpx}.supply-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx}.supply-card{box-sizing:border-box;min-width:0;padding:18rpx;border-radius:28rpx;box-shadow:0 12rpx 30rpx rgba(75,63,55,.055)}.supply-food{background:linear-gradient(145deg,#f4edda,#fcf8ef)}.supply-snack{background:linear-gradient(145deg,#f8e8df,#fff5f0)}.supply-card-top{display:flex;align-items:center}.supply-icon{display:flex;align-items:center;justify-content:center;flex:none;width:48rpx;height:48rpx;border-radius:16rpx;color:#75684e;background:rgba(255,255,255,.72);font-size:20rpx;font-weight:900}.supply-snack .supply-icon{color:#a56b58}.supply-title{min-width:0;flex:1;margin-left:12rpx}.supply-title>view{font-size:22rpx;font-weight:900}.supply-title>text{display:block;overflow:hidden;margin-top:2rpx;color:#8e837b;font-size:16rpx;text-overflow:ellipsis;white-space:nowrap}.supply-arrow{color:#b5aaa2;font-size:28rpx}.supply-days{margin-top:20rpx;color:#403833;font-size:31rpx;font-weight:900}.supply-progress{overflow:hidden;height:8rpx;margin-top:14rpx;border-radius:99rpx;background:rgba(255,255,255,.8)}.supply-progress view{height:100%;border-radius:99rpx;background:#c9aa62}.supply-snack .supply-progress view{background:#db8c70}.supply-remaining{min-height:42rpx;margin-top:9rpx;color:#83776f;font-size:16rpx;line-height:1.35}.supply-card.low .supply-days{color:#c27843}.supply-card.urgent .supply-days,.supply-card.empty .supply-days{color:#c85e50}.supply-card.unset .supply-days{color:#a17a61;font-size:24rpx}.supply-sheet{max-height:84vh;overflow-y:auto}.supply-current{display:flex;align-items:center;margin-bottom:22rpx;padding:22rpx;border-radius:24rpx;background:linear-gradient(145deg,#fff0e7,#fff8f4)}.supply-current-icon{display:flex;align-items:center;justify-content:center;flex:none;width:64rpx;height:64rpx;margin-right:17rpx;border-radius:20rpx;color:#a86950;background:#fff;font-size:24rpx;font-weight:900}.supply-current>view:last-child>text{display:block;color:#9b877b;font-size:18rpx}.supply-current>view:last-child>view{margin:3rpx 0;color:#423731;font-size:30rpx;font-weight:900}.supply-form-note{margin-bottom:20rpx;padding:16rpx 18rpx;border-radius:18rpx;color:#7b716a;background:#f7f4f0;font-size:19rpx;line-height:1.5}.supply-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.supply-picker{display:flex;align-items:center;color:#423a35;font-size:21rpx;font-weight:800}.supply-save-btn{height:86rpx;margin-top:8rpx;border-radius:24rpx;color:#fff;background:linear-gradient(135deg,#ff8965,#ff674b);font-size:26rpx;font-weight:900;line-height:86rpx}.supply-history{margin-top:26rpx}.supply-history-title{margin-bottom:8rpx;font-size:24rpx;font-weight:900}.supply-history-row{display:flex;align-items:center;justify-content:space-between;min-height:82rpx;border-bottom:1rpx solid #eee5de}.supply-history-row>view>text{font-size:21rpx;font-weight:800}.supply-history-row>view>view{margin-top:4rpx;color:#9e938b;font-size:17rpx}.supply-history-row>text{color:#7e726a;font-size:20rpx;font-weight:800}

.supply-inline-head{grid-column:1/-1;display:flex;align-items:flex-end;justify-content:space-between;margin:8rpx 2rpx 0;padding-top:16rpx;border-top:1rpx dashed rgba(218,205,195,.8)}.supply-inline-head>view{color:#4a403a;font-size:24rpx;font-weight:900}.supply-inline-head>text{color:#8c8179;font-size:17rpx}.care-dashboard>.supply-card{width:100%}

.care-dashboard .care-plan-icon{width:44rpx;height:44rpx;border-radius:15rpx}
.care-dashboard .care-plan-copy{margin:6rpx 0 0}
.account-page .care-dashboard .care-countdown{margin:4rpx 0 0;padding:6rpx 11rpx}
.supply-inline-head{margin:0 2rpx;padding-top:8rpx}
.supply-inline-head>view{font-size:22rpx}
.account-page .privacy-note{margin-top:10rpx;font-size:16rpx}

/* 成长相册入口与相册页 */
.display-name-line>view:first-child{min-width:0}.growth-album-entry{display:flex;align-items:center;flex:none;margin:0 8rpx;padding:7rpx 9rpx;border:1rpx solid rgba(231,203,184,.8);border-radius:16rpx;background:rgba(255,255,255,.68);box-shadow:0 5rpx 12rpx rgba(124,88,65,.05)}.growth-album-entry>text:first-child{font-size:22rpx}.growth-album-entry>view{min-width:0;margin-left:5rpx}.growth-album-entry>view>text{display:block;color:#72594b;font-size:15rpx;font-weight:900;line-height:1.2}.growth-album-entry>view>view{margin-top:2rpx;color:#b09281;font-size:13rpx;line-height:1.1;white-space:nowrap}.growth-album-entry>text:last-child{margin-left:3rpx;color:#b49a8b;font-size:23rpx;line-height:1}.growth-album-page{position:fixed;z-index:120;inset:0;box-sizing:border-box;overflow-y:auto;padding:calc(28rpx + env(safe-area-inset-top)) 24rpx calc(40rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,#fff9f4 0%,#f8f5f1 100%)}.growth-album-top{display:grid;grid-template-columns:76rpx 1fr 76rpx;align-items:center;min-height:84rpx}.growth-album-back,.growth-album-add{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;border-radius:20rpx;background:rgba(255,255,255,.8);box-shadow:0 8rpx 20rpx rgba(92,67,51,.07)}.growth-album-back{font-size:44rpx;line-height:1}.growth-album-add{justify-self:end;color:#fff;background:linear-gradient(135deg,#ff926e,#ff6e50);font-size:37rpx;font-weight:400}.growth-album-top>view:nth-child(2){text-align:center}.growth-album-top>view:nth-child(2)>text{display:block;color:#302925;font-size:31rpx;font-weight:900}.growth-album-top>view:nth-child(2)>view{margin-top:4rpx;color:#a5978e;font-size:16rpx}.growth-album-summary{display:flex;align-items:center;margin-top:24rpx;padding:20rpx;border-radius:28rpx;background:linear-gradient(135deg,#ffe7d7,#fff7ee);box-shadow:0 12rpx 28rpx rgba(137,85,55,.06)}.growth-album-summary-icon{display:flex;align-items:center;justify-content:center;flex:none;width:62rpx;height:62rpx;margin-right:14rpx;border-radius:20rpx;background:rgba(255,255,255,.72);font-size:29rpx}.growth-album-summary>view:nth-child(2){min-width:0;flex:1}.growth-album-summary>view:nth-child(2)>text{display:block;color:#473933;font-size:22rpx;font-weight:900}.growth-album-summary>view:nth-child(2)>view{margin-top:5rpx;color:#947b6c;font-size:16rpx;line-height:1.3}.growth-album-summary button{flex:none;height:58rpx;margin:0 0 0 12rpx;padding:0 16rpx;border-radius:18rpx;color:#fff;background:#ee805d;font-size:18rpx;font-weight:900;line-height:58rpx}.growth-empty{display:flex;align-items:center;flex-direction:column;padding:118rpx 20rpx;color:#a89b92;text-align:center}.growth-empty>text:first-child{font-size:66rpx}.growth-empty>view{margin-top:18rpx;color:#51453e;font-size:26rpx;font-weight:900}.growth-empty>text:last-child{margin-top:8rpx;font-size:18rpx}.growth-photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-top:20rpx}.growth-photo-item{position:relative;aspect-ratio:1;overflow:hidden;border-radius:22rpx;background:#eee5de;box-shadow:0 9rpx 22rpx rgba(84,62,50,.07)}.growth-photo-item image{width:100%;height:100%}.growth-photo-item>view{position:absolute;right:0;bottom:0;left:0;display:flex;align-items:center;justify-content:space-between;padding:18rpx 10rpx 9rpx;color:#fff;background:linear-gradient(transparent,rgba(34,25,20,.68));font-size:14rpx}.growth-photo-item>view>text:last-child{margin-left:6rpx}

.profile-edit-page,
.care-full-page{padding-bottom:calc(50rpx + env(safe-area-inset-bottom))}

@media screen and (max-width:360px){
  .account-page{padding-left:16rpx;padding-right:16rpx}
  .display-profile-card{padding-left:16rpx;padding-right:16rpx}
  .display-avatar image{width:106rpx;height:106rpx}
  .profile-display-info{margin-left:14rpx}
  .growth-album-entry{margin-left:4rpx;margin-right:0;padding-left:6rpx;padding-right:6rpx}
  .growth-album-entry>view>view{display:none}
  .growth-photo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .supply-form-grid{grid-template-columns:1fr}
}

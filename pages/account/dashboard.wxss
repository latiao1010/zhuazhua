/* 我的：主屏固定高度，长资料和编辑内容放在独立面板内。 */
.account-dashboard {
  display:grid;
  grid-template-rows:auto auto;
  align-content:start;
  gap:14px;
  width:100%; max-width:540px; height:100vh; margin:0 auto;
  padding:14px 16px 12px; box-sizing:border-box;
  color:var(--ink); background:var(--cream);
}
.account-dashboard>view { min-width:0; min-height:0; }
.account-profile-card { display:grid; grid-template-rows:clamp(100px,16vh,120px) auto auto; border:1px solid var(--line); border-radius:22px; background:#fff; overflow:hidden; }
.account-profile-card>view { min-width:0; min-height:0; }
.account-button { display:block; width:100%!important; min-height:0; margin:0!important; padding:0; border:0; border-radius:0; background:transparent; color:inherit; font-size:14px; font-weight:400; line-height:1.5; text-align:left; box-sizing:border-box; }
.account-button::after { border:0; }
.account-pressed { opacity:.65; }
.account-hero { position:relative; display:flex; align-items:center; gap:16px; padding:14px 20px; border-bottom:1px solid var(--line); background:linear-gradient(115deg,#eaf3ec,#f7faf5); }
.account-portrait { position:relative; flex:none; width:clamp(70px,10vh,90px)!important; height:clamp(70px,10vh,90px); border:3px solid #fff; border-radius:26px; background:#fff8f0; overflow:hidden; box-shadow:0 3px 10px rgba(64,91,73,.06); }
.account-portrait image { display:block; width:100%; height:100%; }
.account-portrait>text { position:absolute; bottom:0; left:0; right:0; padding:2px 0; background:rgba(255,255,255,.9); color:#547563; font-size:10px; text-align:center; }
.account-identity { flex:1; min-width:0; }
.account-identity-top { display:flex; align-items:center; justify-content:space-between; gap:6px; color:#617e69; font-size:11px; }
.account-role { flex:none; padding:2px 6px; border:1px solid #d5e5d9; border-radius:6px; background:rgba(255,255,255,.6); font-size:10px; }
.account-button.account-feedback { width:auto!important; flex:none; color:#63806b; font-size:11px; margin-left:auto!important; padding:4px 0; }
.account-pet-name { display:flex; align-items:center; gap:8px; margin-top:6px!important; color:#304d3d; }
.account-pet-name>text:first-child { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:30px; font-weight:600; line-height:1.35; }
.account-pet-name>text:last-child { flex:none; color:#819d89; font-size:22px; }
.account-hero-note { display:block; margin-top:5px; color:#708574; font-size:11px; }
.account-basics { display:flex; flex-direction:column; padding:10px 22px 2px; background:#fff; }
.account-block-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; flex:none; }
.account-block-heading>text:first-child { color:#405b49; font-size:14px; font-weight:600; }
.account-block-heading>text:last-child { color:var(--muted); font-size:11px; }
.account-basics-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); grid-auto-rows:48px; gap:0 24px; flex:none; margin-top:4px; }
.account-fact { display:flex; flex-direction:column; justify-content:center; min-width:0; padding:4px 0; }
.account-fact:nth-child(n+3) { border-top:1px solid #f3f6f2; }
.account-fact>view { display:flex; align-items:center; justify-content:space-between; gap:8px; color:var(--muted); font-size:12px; }
.account-fact>view>text:last-child { color:#b4c0b7; font-size:15px; line-height:1; }
.account-fact>text { display:block; max-width:100%; margin-top:1px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#405b49; font-size:14px; font-weight:500; font-variant-numeric:tabular-nums; }
.account-fact>text.account-empty { color:#91a094; font-weight:400; }
.account-actions { padding:0 16px; border:1px solid var(--line); border-radius:22px; background:#fff; }
.account-action { display:flex; align-items:center; gap:12px; height:58px; }
.account-action+.account-action { border-top:1px solid #f0f4ef; }
.account-action-title { flex:1; min-width:0; color:#405b49; font-size:14px; font-weight:600; }
.account-action-meta { flex:none; color:var(--muted); font-size:12px; white-space:nowrap; }
.account-entry-icon { display:flex; align-items:center; justify-content:center; flex:none; width:32px; height:32px; border-radius:11px; }
.account-entry-icon .warm-icon { width:20px; height:20px; }
.account-icon-peach { background:#fff1e8; }
.account-icon-green { background:#edf4ee; }
.account-health { border-top:1px solid #eef3ed; }
.account-health .account-basics-grid { grid-auto-rows:70px; }
.account-health .account-fact { justify-content:flex-start; padding:4px 0; }
.account-health .account-fact>text { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; max-height:40px; line-height:20px; white-space:normal; overflow-wrap:anywhere; }
.account-chevron { flex:none; color:#9eb0a2; font-size:20px; }
.account-detail-overlay { position:fixed; z-index:120; inset:0; display:flex; align-items:flex-end; justify-content:center; background:rgba(37,55,44,.28); }
.account-detail-sheet { display:flex; flex-direction:column; width:100%; max-width:540px; max-height:86vh; box-sizing:border-box; padding:22px 18px calc(16px + env(safe-area-inset-bottom)); border-radius:26px 26px 0 0; background:var(--cream); }
.account-detail-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; flex:none; margin-bottom:18px; }
.account-detail-heading>view { min-width:0; }
.account-detail-heading>view>text:first-child { display:block; font-size:20px; font-weight:600; }
.account-detail-heading>view>text:last-child { display:block; margin-top:5px; color:var(--muted); font-size:12px; }
.account-detail-close { display:flex; align-items:center; justify-content:center; flex:none; width:44px!important; height:44px; border-radius:50%; color:var(--muted); background:#edf3ed; font-size:28px; }
.account-detail-content { min-height:0; height:384px; max-height:56vh; flex-shrink:1; }
.account-detail-editing .account-detail-content { height:60vh; max-height:60vh; }
.account-care-groups { display:flex; flex-direction:column; gap:10px; padding-bottom:2px; }
.account-care-group { padding:15px 16px; border:1px solid #e4ece5; border-radius:16px; background:#fff; }
.account-care-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.account-care-heading>text:first-child { color:#405b49; font-size:15px; font-weight:600; }
.account-care-heading>text:last-child:not(:first-child) { color:#91a094; font-size:11px; }
.account-care-copy { display:block; margin-top:8px; color:#526458; font-size:14px; line-height:1.7; white-space:pre-wrap; overflow-wrap:anywhere; }
.account-care-empty { color:#91a094; font-size:13px; }
.account-care-notes { background:#f1f6f1; }
.account-care-input { display:block; box-sizing:border-box; width:100%; height:86px; margin-top:10px; padding:10px 12px; border:1px solid #e7eee6; border-radius:10px; background:#fafcf9; color:var(--ink); font-size:14px; line-height:1.65; }
.account-care-placeholder { color:#95a097; }
.account-care-count { display:block; margin-top:5px; color:#91a094; font-size:11px; text-align:right; }
.account-care-label { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:12px 0 10px; color:#6f7d75; font-size:12px; }
.account-care-label>text:last-child:not(:first-child) { color:#91a094; font-size:11px; }
.account-care-tags { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
.account-care-tag { display:flex; align-items:center; justify-content:center; min-height:36px; padding:7px 4px; border:1px solid #e5ece5; border-radius:10px; background:#fafcf9; color:#6f7d75; font-size:12px; text-align:center; overflow-wrap:anywhere; }
.account-care-tag.selected { border-color:#a4c0aa; background:#eaf3eb; color:#365d40; }
.account-care-saved-tags { display:flex; flex-wrap:wrap; gap:7px; margin-top:10px; }
.account-care-saved-tags>text { padding:4px 10px; border-radius:7px; background:#edf5ed; color:#4b7054; font-size:12px; overflow-wrap:anywhere; }
.account-care-commands { margin-top:16px; }
.account-care-sublabel { display:block; margin-top:10px; color:#7c8b80; font-size:12px; }
.account-care-sublabel+.account-care-copy { margin-top:4px; }
.account-care-actions { display:flex; gap:12px; flex:none; margin-top:14px; padding-top:14px; border-top:1px solid #e8eee7; }
.account-care-actions .account-button { display:flex; align-items:center; justify-content:center; min-height:46px; padding:10px 14px; border-radius:13px; text-align:center; font-size:15px; font-weight:500; }
.account-care-actions .account-care-cancel { flex:1; width:auto!important; color:#6f7d75; background:#edf2ec; }
.account-care-actions .account-care-save { flex:2; width:auto!important; color:#fff; background:#52785e; }
.account-care-actions .account-button[disabled],.account-care-tag[disabled],.account-detail-close[disabled] { opacity:.6; }

@media(max-height:620px) {
  .account-dashboard { gap:10px; padding:10px 14px; }
  .account-profile-card { grid-template-rows:clamp(86px,17vh,104px) auto auto; border-radius:22px; }
  .account-hero { padding:12px 16px; gap:14px; }
  .account-portrait { width:66px!important; height:66px; border-radius:20px; }
  .account-pet-name>text:first-child { font-size:25px; }
  .account-hero-note { margin-top:2px; font-size:10px; }
  .account-basics { padding:10px 16px 0; }
  .account-basics-grid { margin-top:4px; }
  .account-block-heading>text:first-child { font-size:12px; }
  .account-health .account-basics-grid { grid-auto-rows:64px; }
  .account-health .account-fact { padding:2px 0; }
  .account-fact>text { font-size:14px; }
  .account-action { height:50px; }
  .account-entry-icon { width:28px; height:28px; border-radius:9px; }
}
@media(max-height:560px) {
  .account-profile-card { grid-template-rows:80px auto auto; }
  .account-basics { padding-top:8px; }
  .account-basics-grid { grid-auto-rows:46px; }
  .account-health .account-basics-grid { grid-auto-rows:60px; }
  .account-health .account-fact>text { max-height:36px; line-height:18px; }
}
@media(max-height:520px) {
  .account-dashboard { gap:6px; padding:8px 14px; }
  .account-profile-card { grid-template-rows:64px auto auto; }
  .account-hero-note { display:none; }
  .account-portrait { width:54px!important; height:54px; }
  .account-hero { padding:5px 14px; }
  .account-basics { padding-top:6px; }
  .account-basics-grid { grid-auto-rows:44px; margin-top:2px; }
  .account-fact { padding:3px 0; }
  .account-fact>text { margin-top:0; font-size:13px; }
  .account-health .account-basics-grid { grid-auto-rows:56px; }
  .account-health .account-fact { padding:0; }
  .account-health .account-fact>text { max-height:36px; line-height:18px; }
  .account-action { height:44px; }
  .account-entry-icon { width:26px; height:26px; }
}
@media(max-width:360px) {
  .account-identity-top { flex-wrap:wrap; gap:4px; }
  .account-role { font-size:9px; }
  .account-basics-grid { column-gap:18px; }
  .account-action { gap:10px; }
  .account-action-meta { font-size:11px; }
}
@media(min-width:600px) and (max-height:480px) {
  .account-dashboard { max-width:900px; grid-template-rows:minmax(166px,2fr) 58px; gap:10px; padding:10px 20px; }
  .account-profile-card { grid-template-columns:minmax(0,.8fr) repeat(2,minmax(0,1fr)); grid-template-rows:minmax(0,1fr); }
  .account-hero { border-bottom:0; border-right:1px solid var(--line); }
  .account-health { border-top:0; border-left:1px solid var(--line); }
  .account-actions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); padding:0; }
  .account-action { height:100%; gap:6px; padding:0 10px; }
  .account-action+.account-action { border-top:0; border-left:1px solid #f0f4ef; }
  .account-action-title { font-size:13px; }
  .account-action-meta { font-size:10px; }
}

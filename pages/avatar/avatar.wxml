<view class="page avatar-page">
  <view class="topbar">
    <view><view class="eyebrow">AI PET PORTRAIT</view><view class="page-title">把可爱永久收藏</view></view>
    <view class="sparkle">✦</view>
  </view>

  <view class="preview card">
    <view class="preview-bg"></view>
    <view class="before" wx:if="{{!generated}}">
      <image src="{{photo || pet.avatar}}" mode="aspectFill"></image>
      <view class="before-badge">原始照片</view>
    </view>
    <view class="result" wx:else bindtap="previewGenerated">
      <image src="{{generatedImage}}" mode="aspectFill"></image>
      <view class="ai-badge">即梦生成 · {{generatedStyle || style}}</view>
      <view class="result-hint" wx:if="{{!generationError}}">已生成，点击查看大图</view>
      <view class="float-star one">✦</view><view class="float-star two">✦</view>
    </view>
    <view class="generating" wx:if="{{generating}}"><view class="loader">✦</view><text>AI 正在施展魔法…</text><text class="small">正在捕捉毛孩子的可爱特征</text></view>
    <view class="generation-error" wx:if="{{generationError}}">
      <view class="generation-error-icon">!</view>
      <view><view>本次没有生成成功</view><text>{{generationError}}</text></view>
    </view>
  </view>

  <view class="controls-panel">
    <view class="steps-stack">
      <view class="step-card photo-step" bindtap="choosePhoto">
        <view class="step photo-head">
          <text>01</text>
          <view class="step-copy">
            <view class="bold">选择一张清晰照片</view>
            <text class="small">建议正脸、光线充足、无遮挡 · 支持 JPG / PNG</text>
          </view>
          <view class="photo-action"><text>＋</text><view>{{photo ? '重选' : '上传'}}</view></view>
        </view>
        <view class="photo-guides">
          <view><text>◉</text>正脸清晰</view>
          <view><text>☀</text>光线充足</view>
          <view><text>◇</text>没有遮挡</view>
        </view>
      </view>

      <view class="step-card style-block">
        <view class="step style-step"><text>02</text><view><view class="bold">选择喜欢的画风</view><text class="small">即梦图片 5.0 · 提示词画风</text></view></view>
        <view class="styles">
          <view class="style-list">
            <view class="style {{styleId === item.id ? 'selected' : ''}}" wx:for="{{styles}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="chooseStyle">
              <view class="style-art" style="background: {{item.bg}}">{{item.icon}}</view><view>{{item.name}}</view><text wx:if="{{styleId === item.id}}">✓</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="action-zone">
      <button class="generate-btn" disabled="{{generating}}" bindtap="generate"><text>✦</text>{{generated ? ' 再生成一张' : ' 生成 Q 版头像'}}</button>
      <view class="result-actions" wx:if="{{generated}}"><button class="ghost-btn" open-type="share">分享</button><button class="primary-btn" bindtap="saveAvatar">设为档案头像</button></view>
      <view class="privacy">🔒 照片会发送至即梦完成生成，本机临时原图在提交后删除</view>
    </view>
  </view>
</view>

<view class="page avatar-page">
  <view class="topbar">
    <view><view class="eyebrow">AI PET PORTRAIT</view><view class="page-title">把可爱永久收藏</view></view>
    <view class="sparkle">✦</view>
  </view>

  <view class="preview card">
    <view class="preview-bg"></view>
    <view class="before" wx:if="{{!generated}}">
      <image src="{{photo || pet.avatar}}" mode="aspectFill"></image>
      <view class="before-badge">原始照片</view>
    </view>
    <view class="result" wx:else>
      <image src="/assets/momo-chibi.png" mode="aspectFill"></image>
      <view class="ai-badge">AI 生成</view>
      <view class="float-star one">✦</view><view class="float-star two">✦</view>
    </view>
    <view class="generating" wx:if="{{generating}}"><view class="loader">✦</view><text>AI 正在施展魔法…</text><text class="small">正在捕捉毛孩子的可爱特征</text></view>
  </view>

  <view class="step"><text>01</text><view><view class="bold">选择一张清晰照片</view><text class="small">建议正脸、光线充足、无遮挡</text></view></view>
  <view class="upload" bindtap="choosePhoto"><text>＋</text><view>{{photo ? '重新选择照片' : '从相册选择照片'}}</view><text class="small">支持 JPG / PNG</text></view>

  <view class="step"><text>02</text><view><view class="bold">选择喜欢的画风</view><text class="small">每一种都独一无二</text></view></view>
  <scroll-view class="styles" scroll-x show-scrollbar="false">
    <view class="style-list">
      <view class="style {{style === item.name ? 'selected' : ''}}" wx:for="{{styles}}" wx:key="name" data-name="{{item.name}}" bindtap="chooseStyle">
        <view class="style-art" style="background: {{item.bg}}">{{item.icon}}</view><view>{{item.name}}</view><text wx:if="{{style === item.name}}">✓</text>
      </view>
    </view>
  </scroll-view>

  <button class="generate-btn" disabled="{{generating}}" bindtap="generate"><text>✦</text>{{generated ? ' 再生成一张' : ' 生成 Q 版头像'}}</button>
  <view class="result-actions" wx:if="{{generated}}"><button class="ghost-btn" open-type="share">分享</button><button class="primary-btn" bindtap="saveAvatar">设为档案头像</button></view>
  <view class="privacy">🔒 照片仅用于本次生成，演示版不会上传至服务器</view>
</view>

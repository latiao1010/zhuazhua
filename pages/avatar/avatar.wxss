page{
  height:100%;
  overflow:hidden;
}

.avatar-page{
  display:flex;
  flex-direction:column;
  height:100%;
  min-height:0;
  overflow:hidden;
  box-sizing:border-box;
  padding:16rpx 24rpx 12rpx;
}

.avatar-page>.topbar{display:none}

.preview{
  position:relative;
  flex:1;
  width:100%;
  height:420rpx;
  min-height:340rpx;
  overflow:hidden;
  border-radius:30rpx;
  background:linear-gradient(155deg,#ffeadd,#fff9ed);
  box-shadow:0 10rpx 26rpx rgba(200,140,100,.1);
}

.preview-bg{
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle at 15% 18%,rgba(255,255,255,.9) 0 5rpx,transparent 6rpx),
    radial-gradient(circle at 80% 25%,rgba(255,255,255,.9) 0 7rpx,transparent 8rpx);
}

.before,.result{
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
}

.before image{
  width:300rpx;
  height:300rpx;
  max-width:72%;
  max-height:72%;
  border:7rpx solid rgba(255,255,255,.8);
  border-radius:50%;
  box-shadow:0 14rpx 34rpx rgba(122,78,48,.13);
}

.result image{
  width:100%;
  height:100%;
  border-radius:0;
  box-shadow:none;
}

.before-badge,.ai-badge{
  position:absolute;
  left:18rpx;
  top:16rpx;
  padding:8rpx 14rpx;
  border-radius:99rpx;
  color:#fff;
  background:rgba(59,48,41,.55);
  font-size:18rpx;
}

.ai-badge{background:rgba(125,99,210,.84)}

.float-star{
  position:absolute;
  color:#fff;
  font-size:30rpx;
  text-shadow:0 3rpx 10rpx rgba(255,145,64,.3);
}

.float-star.one{right:42rpx;top:50rpx}
.float-star.two{left:36rpx;bottom:58rpx;font-size:24rpx}

.result-hint{
  position:absolute;
  left:50%;
  bottom:14rpx;
  transform:translateX(-50%);
  padding:8rpx 16rpx;
  border-radius:99rpx;
  color:#fff;
  background:rgba(52,43,38,.62);
  font-size:18rpx;
  white-space:nowrap;
}

.generating{
  position:absolute;
  z-index:3;
  inset:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  color:#fff;
  background:rgba(63,51,45,.88);
}

.loader{
  font-size:48rpx;
  animation:spin 1.3s linear infinite;
}

.generating>text{
  margin-top:12rpx;
  font-size:26rpx;
  font-weight:800;
}

.generating .small{
  margin-top:6rpx;
  color:#e5ddd8;
  font-size:18rpx;
  font-weight:400;
}

@keyframes spin{to{transform:rotate(360deg)}}

.generation-error{
  position:absolute;
  z-index:4;
  left:14rpx;
  right:14rpx;
  bottom:12rpx;
  display:flex;
  align-items:center;
  padding:13rpx 16rpx;
  border:1rpx solid #ffd7cb;
  border-radius:20rpx;
  color:#7c4639;
  background:rgba(255,241,236,.96);
  box-shadow:0 8rpx 20rpx rgba(112,62,48,.08);
}

.generation-error-icon{
  display:flex;
  align-items:center;
  justify-content:center;
  flex:none;
  width:32rpx;
  height:32rpx;
  margin-right:11rpx;
  border-radius:50%;
  color:#fff;
  background:#ff7658;
  font-size:19rpx;
  font-weight:900;
}

.generation-error>view:last-child{min-width:0}
.generation-error>view:last-child>view{font-size:19rpx;font-weight:900}
.generation-error text{
  display:block;
  overflow:hidden;
  margin-top:2rpx;
  color:#a56757;
  font-size:17rpx;
  line-height:1.35;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.controls-panel{
  display:flex;
  flex:1;
  min-height:0;
  flex-direction:column;
  grid-template-rows:minmax(0,1fr) minmax(0,1fr);
  /* 卡片内容较高时保持固有高度，避免操作区压到画风选择卡上。 */
  flex:0 0 auto;
  margin-top:14rpx;
}

.steps-stack{
  display:flex;
  flex-direction:column;
  flex:none;
  gap:14rpx;
}

.step-card{
  box-sizing:border-box;
  padding:18rpx 20rpx;
  border:1rpx solid rgba(240,226,216,.9);
  border-radius:24rpx;
  background:rgba(255,255,255,.92);
  box-shadow:0 8rpx 24rpx rgba(190,140,110,.07);
}

.step{
  display:flex;
  align-items:center;
  flex:none;
  margin:0 0 8rpx;
}

.step>text{
  display:flex;
  align-items:center;
  justify-content:center;
  width:54rpx;
  height:54rpx;
  margin-right:14rpx;
  border-radius:17rpx;
  color:#fff;
  background:linear-gradient(135deg,#ffb37e,#ff7a50);
  box-shadow:0 6rpx 14rpx rgba(255,122,80,.25);
  font-size:19rpx;
  font-weight:900;
}

.step .bold,.step .small{display:block}
.step .bold{font-size:26rpx;font-weight:800;line-height:1.15}
.step .small{margin-top:4rpx;color:#a39890;font-size:18rpx;line-height:1.25}

.photo-step{
  display:flex;
  flex-direction:column;
  border-style:dashed;
}

.photo-head{width:100%;margin:0}
.photo-head>text:first-child{margin-right:14rpx}
.step-copy{min-width:0;flex:1}

.photo-action{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  flex:none;
  margin-left:10rpx;
  color:#ff7352;
  font-size:18rpx;
  font-weight:800;
}

.photo-action>text{
  display:flex;
  align-items:center;
  justify-content:center;
  width:32rpx;
  height:32rpx;
  margin-right:6rpx;
  border-radius:10rpx;
  color:#fff;
  background:#ff7654;
  font-size:24rpx;
  line-height:1;
}

.photo-guides{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:10rpx;
  width:100%;
  margin-top:14rpx;
}

.photo-guides>view{
  display:flex;
  align-items:center;
  justify-content:center;
  min-width:0;
  height:60rpx;
  border:1rpx solid #ffe9db;
  border-radius:14rpx;
  color:#8a7d74;
  background:#fff9f4;
  font-size:17rpx;
  font-weight:700;
  white-space:nowrap;
}

.photo-guides text{
  margin-right:6rpx;
  color:#ff7654;
  font-size:17rpx;
}

.style-block{
  display:flex;
  flex-direction:column;
}

.style-step{width:100%;margin:0 0 12rpx}

.styles{
  flex:none;
  width:100%;
  overflow:hidden;
}

.style-list{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:10rpx;
  padding:1rpx 2rpx 4rpx;
}

.style{
  position:relative;
  min-width:0;
  box-sizing:border-box;
  padding:6rpx 5rpx 8rpx;
  border:2rpx solid #f6eae2;
  border-radius:18rpx;
  background:#fff;
  text-align:center;
  font-size:17rpx;
  font-weight:700;
}

.style.selected{
  border-color:#ff7b59;
  background:#fff7f2;
  box-shadow:0 6rpx 16rpx rgba(255,105,72,.14);
}

.style-art{
  height:56rpx;
  margin-bottom:6rpx;
  border-radius:12rpx;
  line-height:56rpx;
  font-size:30rpx;
}

.style>view:nth-child(2){
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.style>text{
  position:absolute;
  right:-4rpx;
  top:-5rpx;
  width:27rpx;
  height:27rpx;
  border:3rpx solid #fff;
  border-radius:50%;
  color:#fff;
  background:#ff704e;
  line-height:27rpx;
  font-size:16rpx;
}

.action-zone{
  flex:none;
  margin-top:14rpx;
}

.generate-btn{
  display:flex;
  align-items:center;
  justify-content:center;
  flex:none;
  width:100%;
  height:88rpx;
  margin:0;
  padding:0;
  border-radius:26rpx;
  color:#fff;
  background:linear-gradient(135deg,#9a8bf0,#6a5cd6);
  box-shadow:0 12rpx 26rpx rgba(102,89,196,.28);
  font-size:28rpx;
  font-weight:900;
  letter-spacing:2rpx;
}

.generate-btn text{margin-right:8rpx;font-size:30rpx}

.result-actions{
  display:grid;
  grid-template-columns:1fr 2fr;
  flex:none;
  gap:12rpx;
  margin-top:12rpx;
}

.result-actions button{
  width:100%;
  height:76rpx;
  margin:0;
  border-radius:24rpx;
  font-size:25rpx;
}

.privacy{
  flex:none;
  overflow:hidden;
  margin:12rpx 0 0;
  color:#b5aba3;
  text-align:center;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-size:16rpx;
  line-height:1.3;
}

@media (max-height:700px){
  .avatar-page{padding-top:8rpx}
  .preview{min-height:280rpx}
  .step-card{padding-top:12rpx;padding-bottom:12rpx}
  .photo-guides{margin-top:10rpx}
  .photo-guides>view{height:52rpx}
  .style-art{height:52rpx;line-height:52rpx}
  .generate-btn{height:78rpx}
  .result-actions button{height:62rpx}
}

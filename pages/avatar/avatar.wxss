page{
  height:100%;
  overflow:hidden;
}

.avatar-page{
  display:flex;
  flex-direction:column;
  height:100%;
  min-height:0;
  overflow:hidden;
  box-sizing:border-box;
  padding:14rpx 20rpx 10rpx;
}

.avatar-page>.topbar{display:none}

.preview{
  position:relative;
  flex:none;
  width:100%;
  height:420rpx;
  min-height:0;
  overflow:hidden;
  border-radius:28rpx;
  background:linear-gradient(155deg,#ffeadd,#fff9ed);
}

.preview-bg{
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle at 15% 18%,rgba(255,255,255,.9) 0 5rpx,transparent 6rpx),
    radial-gradient(circle at 80% 25%,rgba(255,255,255,.9) 0 7rpx,transparent 8rpx);
}

.before,.result{
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
}

.before image{
  width:300rpx;
  height:300rpx;
  max-width:72%;
  max-height:72%;
  border:7rpx solid rgba(255,255,255,.8);
  border-radius:50%;
  box-shadow:0 14rpx 34rpx rgba(122,78,48,.13);
}

.result image{
  width:100%;
  height:100%;
  border-radius:0;
  box-shadow:none;
}

.before-badge,.ai-badge{
  position:absolute;
  left:18rpx;
  top:16rpx;
  padding:8rpx 14rpx;
  border-radius:99rpx;
  color:#fff;
  background:rgba(59,48,41,.55);
  font-size:18rpx;
}

.ai-badge{background:rgba(125,99,210,.84)}

.float-star{
  position:absolute;
  color:#fff;
  font-size:30rpx;
  text-shadow:0 3rpx 10rpx rgba(255,145,64,.3);
}

.float-star.one{right:42rpx;top:50rpx}
.float-star.two{left:36rpx;bottom:58rpx;font-size:24rpx}

.result-hint{
  position:absolute;
  left:50%;
  bottom:14rpx;
  transform:translateX(-50%);
  padding:8rpx 16rpx;
  border-radius:99rpx;
  color:#fff;
  background:rgba(52,43,38,.62);
  font-size:18rpx;
  white-space:nowrap;
}

.generating{
  position:absolute;
  z-index:3;
  inset:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  color:#fff;
  background:rgba(63,51,45,.88);
}

.loader{
  font-size:48rpx;
  animation:spin 1.3s linear infinite;
}

.generating>text{
  margin-top:12rpx;
  font-size:26rpx;
  font-weight:800;
}

.generating .small{
  margin-top:6rpx;
  color:#e5ddd8;
  font-size:18rpx;
  font-weight:400;
}

@keyframes spin{to{transform:rotate(360deg)}}

.generation-error{
  position:absolute;
  z-index:4;
  left:14rpx;
  right:14rpx;
  bottom:12rpx;
  display:flex;
  align-items:center;
  padding:13rpx 16rpx;
  border:1rpx solid #ffd7cb;
  border-radius:20rpx;
  color:#7c4639;
  background:rgba(255,241,236,.96);
  box-shadow:0 8rpx 20rpx rgba(112,62,48,.08);
}

.generation-error-icon{
  display:flex;
  align-items:center;
  justify-content:center;
  flex:none;
  width:32rpx;
  height:32rpx;
  margin-right:11rpx;
  border-radius:50%;
  color:#fff;
  background:#ff7658;
  font-size:19rpx;
  font-weight:900;
}

.generation-error>view:last-child{min-width:0}
.generation-error>view:last-child>view{font-size:19rpx;font-weight:900}
.generation-error text{
  display:block;
  overflow:hidden;
  margin-top:2rpx;
  color:#a56757;
  font-size:17rpx;
  line-height:1.35;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.controls-panel{
  display:flex;
  flex:1;
  flex-direction:column;
  min-height:0;
  margin-top:10rpx;
}

.steps-stack{
  display:grid;
  grid-template-rows:minmax(0,1fr) minmax(0,1fr);
  flex:1;
  gap:10rpx;
  min-height:0;
}

.step-card{
  min-height:0;
  box-sizing:border-box;
  padding:12rpx 14rpx;
  border:1rpx solid rgba(238,224,214,.9);
  border-radius:22rpx;
  background:linear-gradient(145deg,rgba(255,255,255,.78),rgba(255,247,241,.7));
}

.step{
  display:flex;
  align-items:center;
  flex:none;
  margin:14rpx 0 8rpx;
}

.step>text{
  display:flex;
  align-items:center;
  justify-content:center;
  width:54rpx;
  height:54rpx;
  margin-right:14rpx;
  border-radius:17rpx;
  color:#ff704e;
  background:#ffe6d9;
  font-size:19rpx;
  font-weight:900;
}

.step .bold,.step .small{display:block}
.step .bold{font-size:24rpx;font-weight:800;line-height:1.15}
.step .small{margin-top:3rpx;color:#9e948d;font-size:17rpx;line-height:1.2}

.photo-step{
  display:flex;
  flex-direction:column;
  justify-content:center;
  border-style:dashed;
}

.photo-head{width:100%;margin:0}
.photo-head>text:first-child{margin-right:14rpx}
.step-copy{min-width:0;flex:1}

.photo-action{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  flex:none;
  margin-left:10rpx;
  color:#ff7352;
  font-size:18rpx;
  font-weight:800;
}

.photo-action>text{
  display:flex;
  align-items:center;
  justify-content:center;
  width:32rpx;
  height:32rpx;
  margin-right:6rpx;
  border-radius:10rpx;
  color:#fff;
  background:#ff7654;
  font-size:24rpx;
  line-height:1;
}

.photo-guides{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:7rpx;
  width:100%;
  margin-top:12rpx;
}

.photo-guides>view{
  display:flex;
  align-items:center;
  justify-content:center;
  min-width:0;
  height:56rpx;
  border-radius:12rpx;
  color:#8a7d74;
  background:#fff6f0;
  font-size:16rpx;
  font-weight:700;
  white-space:nowrap;
}

.photo-guides text{
  margin-right:6rpx;
  color:#ff7654;
  font-size:17rpx;
}

.style-block{
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.style-step{width:100%;margin:0 0 12rpx}

.styles{
  flex:none;
  width:100%;
  overflow:hidden;
}

.style-list{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:7rpx;
  padding:1rpx 2rpx 4rpx;
}

.style{
  position:relative;
  min-width:0;
  box-sizing:border-box;
  padding:4rpx 5rpx 6rpx;
  border:2rpx solid transparent;
  border-radius:17rpx;
  background:#fff;
  text-align:center;
  font-size:16rpx;
  font-weight:700;
}

.style.selected{
  border-color:#ff7b59;
  box-shadow:0 5rpx 15rpx rgba(255,105,72,.12);
}

.style-art{
  height:56rpx;
  margin-bottom:4rpx;
  border-radius:12rpx;
  line-height:56rpx;
  font-size:29rpx;
}

.style>view:nth-child(2){
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.style>text{
  position:absolute;
  right:-4rpx;
  top:-5rpx;
  width:27rpx;
  height:27rpx;
  border:3rpx solid #fff;
  border-radius:50%;
  color:#fff;
  background:#ff704e;
  line-height:27rpx;
  font-size:16rpx;
}

.action-zone{
  flex:none;
  margin-top:10rpx;
}

.generate-btn{
  flex:none;
  height:70rpx;
  margin-top:0;
  border-radius:22rpx;
  color:#fff;
  background:linear-gradient(135deg,#8b7be4,#675ac4);
  box-shadow:0 10rpx 22rpx rgba(102,89,196,.22);
  font-size:24rpx;
  font-weight:900;
  line-height:70rpx;
}

.generate-btn text{font-size:28rpx}

.result-actions{
  display:grid;
  grid-template-columns:1fr 2fr;
  flex:none;
  gap:10rpx;
  margin-top:9rpx;
}

.result-actions button{
  width:100%;
  height:68rpx;
  border-radius:21rpx;
  font-size:23rpx;
}

.privacy{
  flex:none;
  overflow:hidden;
  margin:9rpx 0 0;
  color:#aaa098;
  text-align:center;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-size:15rpx;
  line-height:1.3;
}

@media (max-height:700px){
  .avatar-page{padding-top:8rpx}
  .preview{height:350rpx}
  .step{margin-top:9rpx}
  .step-card{padding-top:8rpx;padding-bottom:8rpx}
  .photo-head{margin-top:0}
  .style-step{margin-top:0;margin-bottom:7rpx}
  .photo-guides{margin-top:7rpx}
  .photo-guides>view{height:50rpx}
  .style-art{height:50rpx;line-height:50rpx}
  .generate-btn{height:64rpx;line-height:64rpx}
  .result-actions button{height:62rpx}
}

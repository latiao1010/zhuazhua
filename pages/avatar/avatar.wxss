.sparkle{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border-radius:22rpx;color:#fff;background:linear-gradient(135deg,#9a89ea,#7061cf);font-size:34rpx;box-shadow:0 10rpx 24rpx rgba(113,98,207,.22);}.preview{position:relative;overflow:hidden;height:620rpx;background:linear-gradient(155deg,#ffeadd,#fff9ed);}.preview-bg{position:absolute;inset:0;background:radial-gradient(circle at 15% 18%,rgba(255,255,255,.9) 0 5rpx,transparent 6rpx),radial-gradient(circle at 80% 25%,rgba(255,255,255,.9) 0 7rpx,transparent 8rpx);}.before,.result{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}.before image{width:430rpx;height:430rpx;border-radius:50%;}.result image{width:100%;height:100%;}.before-badge,.ai-badge{position:absolute;left:24rpx;top:24rpx;padding:10rpx 18rpx;border-radius:99rpx;color:#fff;background:rgba(59,48,41,.55);font-size:20rpx;}.ai-badge{background:rgba(125,99,210,.82);}.float-star{position:absolute;color:#fff;font-size:38rpx;text-shadow:0 3rpx 10rpx rgba(255,145,64,.3);}.float-star.one{right:54rpx;top:70rpx}.float-star.two{left:45rpx;bottom:90rpx;font-size:28rpx}.generating{position:absolute;z-index:3;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;background:rgba(63,51,45,.88);}.loader{font-size:60rpx;animation:spin 1.3s linear infinite;}.generating>text{margin-top:20rpx;font-size:30rpx;font-weight:800;}.generating .small{margin-top:10rpx;color:#e5ddd8;font-size:21rpx;font-weight:400;}@keyframes spin{to{transform:rotate(360deg)}}.step{display:flex;align-items:center;margin:38rpx 0 18rpx;}.step>text{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;margin-right:16rpx;border-radius:17rpx;color:#ff704e;background:#ffe6d9;font-size:20rpx;font-weight:900;}.step .bold,.step .small{display:block;}.step .bold{font-size:27rpx;font-weight:800;}.step .small{margin-top:4rpx;color:#9e948d;font-size:20rpx;}.upload{padding:28rpx;border:2rpx dashed #e8d6ca;border-radius:28rpx;text-align:center;color:#6f655e;background:rgba(255,255,255,.55);font-weight:800;}.upload>text:first-child{display:block;color:#ff7654;font-size:42rpx;}.upload .small{display:block;margin-top:7rpx;color:#aaa097;font-size:19rpx;font-weight:400;}.styles{width:100%;}.style-list{display:flex;gap:16rpx;padding:2rpx 4rpx 12rpx;}.style{position:relative;flex:none;width:176rpx;padding:10rpx 10rpx 16rpx;border:3rpx solid transparent;border-radius:25rpx;background:#fff;text-align:center;font-size:22rpx;font-weight:700;box-sizing:border-box;}.style.selected{border-color:#ff7b59;box-shadow:0 7rpx 20rpx rgba(255,105,72,.12);}.style-art{height:126rpx;margin-bottom:12rpx;border-radius:19rpx;line-height:126rpx;font-size:50rpx;}.style>text{position:absolute;right:-6rpx;top:-8rpx;width:34rpx;height:34rpx;border:4rpx solid #fff;border-radius:50%;color:#fff;background:#ff704e;line-height:34rpx;font-size:20rpx;}.generate-btn{margin-top:32rpx;border-radius:27rpx;color:#fff;background:linear-gradient(135deg,#8b7be4,#675ac4);box-shadow:0 14rpx 28rpx rgba(102,89,196,.25);font-size:29rpx;font-weight:900;}.generate-btn text{font-size:34rpx;}.result-actions{display:grid;grid-template-columns:1fr 2fr;gap:14rpx;margin-top:16rpx;}.result-actions button{width:100%;}.privacy{margin:20rpx 0;color:#aaa098;text-align:center;font-size:19rpx;}

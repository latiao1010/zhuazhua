@import "../account/account.wxss";
.care-page .topbar{margin-bottom:24rpx}.care-page .eyebrow{margin-bottom:10rpx;letter-spacing:0;color:var(--muted);font-weight:400;font-size:24rpx}
.care-advisor-entry{display:flex;align-items:center;gap:20rpx;padding:28rpx;border:1rpx solid #f8dfcf;border-radius:28rpx;background:#fff0e5}
.care-advisor-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;flex:none;border-radius:24rpx;background:#fff}
.care-advisor-entry>view:nth-child(2){min-width:0;flex:1}.care-advisor-entry>view>view{font-size:30rpx;font-weight:600}.care-advisor-entry>view>text{display:block;margin-top:8rpx;font-size:24rpx;line-height:1.6;color:#957969}.care-advisor-entry>text{font-size:34rpx;color:#b68b72}
.care-footer{padding:24rpx 4rpx;color:var(--muted);font-size:23rpx;line-height:1.7}

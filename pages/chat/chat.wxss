page{height:100%;overflow:hidden;background:#fff9f2;}
.chat-page{display:flex;flex-direction:column;height:100vh;background:linear-gradient(180deg,#fff 0,#fffaf6 28%,#faf7f4 100%);}
.chat-head{flex:none;display:flex;align-items:center;margin:18rpx 24rpx 8rpx;padding:18rpx 20rpx;border:1rpx solid rgba(232,223,216,.9);border-radius:25rpx;background:rgba(255,255,255,.96);box-shadow:0 10rpx 28rpx rgba(75,57,45,.06);}
.advisor-avatar,.bubble-avatar{display:flex;align-items:center;justify-content:center;flex:none;color:#fff;background:linear-gradient(135deg,#ff9a76,#ff6d50);box-shadow:0 8rpx 18rpx rgba(255,111,77,.18);}
.advisor-avatar{width:66rpx;height:66rpx;border-radius:22rpx;font-size:30rpx;}
.head-copy{min-width:0;flex:1;margin-left:16rpx;font-weight:800;}
.head-title{display:flex;align-items:center;color:#2f2925;font-size:29rpx;font-weight:900;}
.head-title text{margin-left:10rpx;padding:4rpx 10rpx;border-radius:99rpx;color:#46a66d;background:#eaf8ef;font-size:17rpx;font-weight:800;}
.status{overflow:hidden;margin-top:5rpx;color:#9a918a;font-size:20rpx;font-weight:400;text-overflow:ellipsis;white-space:nowrap;}
.status-dot{display:inline-block;width:12rpx;height:12rpx;margin-right:8rpx;border-radius:50%;background:#68ce8a;}
.head-action{padding:18rpx 8rpx;color:#9b9189;font-size:30rpx;letter-spacing:3rpx;}
.chat-scroll{flex:1;height:0;padding:0 24rpx;box-sizing:border-box;background:transparent;}
.date-chip{display:table;margin:22rpx auto;padding:8rpx 18rpx;border-radius:99rpx;color:#aaa19a;background:#f2ebe5;font-size:19rpx;}
.welcome{text-align:center;padding:26rpx 40rpx 28rpx;}
.welcome-icon{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;margin:0 auto;border-radius:50%;background:#fff1e9;box-shadow:0 12rpx 35rpx rgba(255,117,82,.12);font-size:42rpx;}
.welcome-title{margin:18rpx 0 8rpx;color:#2f2925;font-size:34rpx;font-weight:900;}
.welcome-sub{color:#9d938c;font-size:22rpx;line-height:1.55;}
.quick-list{display:flex;flex-direction:column;gap:14rpx;margin:0 10rpx 30rpx;}
.quick{display:flex;align-items:center;justify-content:space-between;padding:24rpx 24rpx;border:1rpx solid #eee3db;border-radius:22rpx;color:#6d635c;background:#fff;font-size:24rpx;box-shadow:0 8rpx 22rpx rgba(80,59,43,.05);}
.quick text{color:#ff7552;font-size:34rpx;}
.advisor-groups{display:flex;flex-direction:column;gap:14rpx;margin:0 10rpx 30rpx;}
.advisor-group{padding:18rpx;border:1rpx solid #eee3db;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(80,59,43,.05);}
.advisor-group-head{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin:0 4rpx 12rpx;}
.advisor-group-title{color:#3e352f;font-size:25rpx;font-weight:900;white-space:nowrap;}
.advisor-group-desc{overflow:hidden;color:#aaa098;font-size:18rpx;text-overflow:ellipsis;white-space:nowrap;}
.advisor-group-items{display:flex;flex-wrap:wrap;gap:10rpx;}
.advisor-item{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;min-width:46%;flex:1;padding:15rpx 16rpx;border-radius:16rpx;color:#6d635c;background:#fff8f3;font-size:21rpx;}
.advisor-arrow{margin-left:8rpx;color:#ff7552;font-size:28rpx;line-height:1;}
.messages{padding-bottom:34rpx;}
.message-row{display:flex;align-items:flex-start;margin:26rpx 0;}
.message-row.user{justify-content:flex-end;}
.bubble-avatar{width:54rpx;height:54rpx;margin-right:12rpx;border-radius:18rpx;font-size:24rpx;}
.bubble{max-width:74%;padding:20rpx 22rpx 12rpx;border-radius:25rpx;line-height:1.65;font-size:25rpx;white-space:pre-wrap;word-break:break-word;}
.ai-bubble{border-top-left-radius:7rpx;color:#4a413b;background:#fff;box-shadow:0 8rpx 24rpx rgba(80,59,43,.08);}
.user-bubble{border-top-right-radius:7rpx;color:#fff;background:linear-gradient(135deg,#ff8965,#ff6a4c);}
.msg-time{margin-top:6rpx;text-align:right;opacity:.6;font-size:17rpx;}
.typing{display:flex;gap:7rpx;padding:26rpx;}
.typing text{width:10rpx;height:10rpx;border-radius:50%;background:#ff8a67;animation:bounce 1s infinite alternate;}
.typing text:nth-child(2){animation-delay:.2s}
.typing text:nth-child(3){animation-delay:.4s}
@keyframes bounce{to{transform:translateY(-7rpx);opacity:.5;}}
.medical-tip{margin:30rpx 20rpx 0;color:#b1a69e;text-align:center;font-size:19rpx;line-height:1.5;}
.composer{flex:none;display:flex;align-items:center;gap:14rpx;padding:18rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eee4dc;background:#fff;}
.input-wrap{display:flex;align-items:center;flex:1;height:82rpx;padding:0 22rpx;border-radius:26rpx;background:#f7f2ee;}
.input-wrap input{flex:1;font-size:26rpx;}
.input-wrap text{color:#aca29a;font-size:30rpx;}
.send{display:flex;align-items:center;justify-content:center;width:82rpx!important;height:82rpx;padding:0!important;border-radius:25rpx;color:#fff;background:#d8d0ca;font-size:38rpx;font-weight:900;line-height:1;}
.send.ready{background:linear-gradient(135deg,#ff8965,#ff6246);box-shadow:0 10rpx 24rpx rgba(255,98,70,.22);}

@media (max-width:360px){
  .chat-head{margin-left:16rpx;margin-right:16rpx}
  .chat-scroll{padding-left:16rpx;padding-right:16rpx}
  .bubble{max-width:78%;font-size:24rpx}
  .welcome-title{font-size:31rpx}
}

@media (max-height:620px){
  .chat-head{margin-top:12rpx;padding-top:14rpx;padding-bottom:14rpx}
  .welcome{padding-top:14rpx;padding-bottom:16rpx}
  .welcome-icon{width:62rpx;height:62rpx;font-size:34rpx}
  .quick{padding-top:18rpx;padding-bottom:18rpx}
  .advisor-item{min-width:100%;}
}

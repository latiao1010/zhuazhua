/* 问答页：顶部轻量展示，回答优先，追问以紧凑选项排列。 */
page { height:100%; overflow:hidden; background:var(--cream); }
.chat-page { display:flex; flex-direction:column; height:100vh; background:var(--cream); }
.chat-head { flex:none; display:flex; align-items:center; gap:14rpx; margin:0 28rpx; padding:16rpx 0; border-bottom:1rpx solid var(--line); }
.advisor-avatar,.bubble-avatar { display:flex; align-items:center; justify-content:center; flex:none; background:var(--orange-soft); }
.advisor-avatar { width:56rpx; height:56rpx; border-radius:18rpx; }
.advisor-avatar .warm-icon { width:36rpx; height:36rpx; }
.head-copy { min-width:0; flex:1; }
.head-title { display:flex; align-items:center; flex-wrap:wrap; gap:10rpx; color:var(--ink); font-size:28rpx; font-weight:600; }
.head-title text { padding:3rpx 10rpx; border-radius:8rpx; color:var(--brand); background:var(--brand-soft); font-size:20rpx; font-weight:400; }
.status { margin-top:4rpx; color:var(--muted); font-size:22rpx; line-height:1.5; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.status-dot { display:inline-block; width:10rpx; height:10rpx; margin-right:8rpx; border-radius:50%; background:#86ae93; }
.head-action { display:flex; align-items:center; justify-content:center; flex:none; width:64rpx; min-height:76rpx; color:var(--muted); font-size:30rpx; letter-spacing:3rpx; }
.topic-navigation { display:flex; align-items:center; justify-content:space-between; flex:none; gap:12rpx; padding:8rpx 28rpx 0; }
.topic-breadcrumb { min-width:0; flex:1; color:var(--muted); font-size:23rpx; line-height:1.5; }
.topic-breadcrumb text { color:var(--ink); }
.topic-return { display:flex; align-items:center; flex:none; min-height:64rpx; padding:0 12rpx; color:var(--brand); font-size:23rpx; }
.history-search { flex:none; padding:8rpx 28rpx 12rpx; }
.history-search input { display:block; box-sizing:border-box; width:100%; height:60rpx; padding:0 20rpx; border:1rpx solid var(--line); border-radius:16rpx; background:#fff; color:var(--ink); font-size:24rpx; }
.search-summary { display:flex; justify-content:space-between; gap:16rpx; margin-top:10rpx; color:var(--muted); font-size:22rpx; line-height:1.5; }
.search-summary text:last-child { flex:none; color:var(--brand); }
.chat-scroll { flex:1; height:0; min-height:0; padding:0 28rpx; box-sizing:border-box; }
.welcome { padding:28rpx 0 24rpx; }
.welcome-title { margin-bottom:12rpx; color:var(--ink); font-size:36rpx; font-weight:600; line-height:1.4; }
.welcome-sub { color:var(--muted); font-size:25rpx; line-height:1.7; }
.unified-prompts { margin:0 0 24rpx; padding:24rpx; border:1rpx solid var(--line); border-radius:26rpx; background:#fff; }
.followup-heading { color:var(--ink); font-size:27rpx; font-weight:600; line-height:1.5; }
.followup-subtitle { margin:8rpx 0 20rpx; color:var(--muted); font-size:23rpx; line-height:1.6; }
.welcome-topic-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; }
.welcome-topic-item { display:flex; align-items:center; min-width:0; min-height:84rpx; padding:12rpx 16rpx; box-sizing:border-box; border:1rpx solid var(--line); border-radius:16rpx; background:var(--cream); color:var(--ink); font-size:25rpx; line-height:1.5; }
.welcome-topic-item>text:first-child { flex:1; min-width:0; overflow-wrap:anywhere; }
.advisor-arrow { flex:none; margin-left:8rpx; color:#8ca394; font-size:28rpx; }
.visited-note { flex:none; margin-left:8rpx; color:var(--muted); font-size:21rpx; font-weight:400; }
.welcome-topic-item.visited,.followup-option.visited { color:var(--muted); background:var(--cream); }
.all-topic-groups { display:flex; flex-direction:column; gap:26rpx; }
.welcome-topic-title { margin-bottom:14rpx; color:var(--ink); font-size:27rpx; font-weight:600; }
.expand-topics,.resume-conversation { margin-top:22rpx; padding:20rpx; border-radius:16rpx; color:var(--brand); background:var(--brand-soft); text-align:center; font-size:25rpx; font-weight:500; line-height:1.5; }
.expand-topics text { margin-left:8rpx; }
.resume-conversation { margin:20rpx 0 28rpx; }
.messages { padding-bottom:24rpx; }
.date-chip { display:table; margin:18rpx auto; padding:6rpx 16rpx; border-radius:99rpx; color:var(--muted); background:var(--brand-soft); font-size:21rpx; }
.message-row { display:flex; align-items:flex-start; margin:22rpx 0; }
.message-row.user { justify-content:flex-end; }
.bubble-avatar { width:44rpx; height:44rpx; margin-right:12rpx; border-radius:14rpx; }
.bubble-avatar .warm-icon { width:28rpx; height:28rpx; }
.bubble { box-sizing:border-box; max-width:calc(100% - 56rpx); padding:24rpx; border-radius:26rpx; color:var(--ink); font-size:28rpx; line-height:1.75; white-space:pre-wrap; word-break:break-word; }
.ai-bubble { border:1rpx solid var(--line); border-top-left-radius:8rpx; background:#fff; }
.user-bubble { border-top-right-radius:8rpx; background:#e8f2eb; color:#355c43; }
.msg-time { margin-top:8rpx; text-align:right; color:var(--muted); font-size:20rpx; }
.answer-title { margin-bottom:16rpx; color:var(--ink); font-size:28rpx; font-weight:600; }
.answer-paragraph { margin-top:16rpx; line-height:1.8; white-space:pre-wrap; }
.answer-lead { margin-top:0; font-weight:500; }
.record-link { margin-top:20rpx; padding:16rpx; border-radius:14rpx; color:var(--brand); background:var(--brand-soft); font-size:24rpx; }
.typing { display:flex; gap:8rpx; padding:26rpx; }
.typing text { width:10rpx; height:10rpx; border-radius:50%; background:#86ae93; animation:bounce 1s infinite alternate; }
.typing text:nth-child(2) { animation-delay:.2s; }
.typing text:nth-child(3) { animation-delay:.4s; }
@keyframes bounce { to { transform:translateY(-7rpx); opacity:.5; } }
.reply-error { margin:20rpx 0; padding:20rpx; border-radius:20rpx; color:#a45640; background:var(--orange-soft); font-size:24rpx; line-height:1.6; }
.reply-error button { margin-top:12rpx; color:#a45640; background:#fff; font-size:24rpx; }
.followup-thread { margin-top:-6rpx; }
.followup-row { margin:0 0 14rpx 56rpx; }
.followup-panel { flex:1; min-width:0; max-width:none; padding:4rpx 0; border:0; border-radius:0; background:transparent; white-space:normal; }
.followup-panel .followup-heading { color:var(--muted); font-size:23rpx; font-weight:400; }
.followup-options { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:12rpx; }
.followup-option { display:flex; align-items:center; box-sizing:border-box; min-height:80rpx; max-width:100%; padding:12rpx 18rpx; border:1rpx solid #dce8de; border-radius:18rpx; background:#fff; color:var(--brand); font-size:24rpx; line-height:1.5; }
.followup-label { min-width:0; overflow-wrap:anywhere; }
.followup-arrow { flex:none; margin-left:12rpx; color:#8ca394; font-size:26rpx; }
.followup-option.back { color:var(--muted); background:var(--brand-soft); border-color:transparent; }
.prompt-pressed { background:#e7f0e9!important; }
.medical-tip { margin:22rpx 12rpx 0; color:var(--muted); text-align:center; font-size:22rpx; line-height:1.7; }
.composer { flex:none; display:flex; align-items:center; gap:14rpx; padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:1rpx solid var(--line); background:#fff; }
.input-wrap { display:flex; align-items:center; flex:1; min-width:0; height:88rpx; padding:0 22rpx; border-radius:24rpx; background:var(--cream); border:1rpx solid var(--line); box-sizing:border-box; }
.input-wrap input { flex:1; min-width:0; color:var(--ink); font-size:27rpx; }
.send { display:flex; align-items:center; justify-content:center; flex:none; width:88rpx!important; height:88rpx; margin:0; padding:0; border-radius:24rpx; color:#fff; background:#b8c8bb; font-size:38rpx; font-weight:500; line-height:1; }
.send.ready { background:var(--brand); }
@media(max-width:360px) {
  .chat-head { margin-left:22rpx; margin-right:22rpx; }
  .chat-scroll,.history-search,.topic-navigation,.composer { padding-left:22rpx; padding-right:22rpx; }
  .head-title { font-size:27rpx; }
  .head-title text { font-size:19rpx; }
  .head-action { width:48rpx; }
  .welcome-title { font-size:33rpx; }
  .bubble { padding:20rpx; }
  .followup-row { margin-left:0; }
}
@media(max-height:620px) {
  .chat-head { padding-top:8rpx; padding-bottom:8rpx; }
  .welcome { padding-top:22rpx; padding-bottom:20rpx; }
}

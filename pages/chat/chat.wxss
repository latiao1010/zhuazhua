page{height:100%;overflow:hidden;background:#fff9f2;}
.chat-page{display:flex;flex-direction:column;height:100vh;background:linear-gradient(180deg,#fff 0,#fffaf6 28%,#faf7f4 100%);}
.chat-head{flex:none;display:flex;align-items:center;margin:18rpx 24rpx 8rpx;padding:18rpx 20rpx;border:1rpx solid rgba(232,223,216,.9);border-radius:25rpx;background:rgba(255,255,255,.96);box-shadow:0 10rpx 28rpx rgba(75,57,45,.06);}
.advisor-avatar,.bubble-avatar{display:flex;align-items:center;justify-content:center;flex:none;color:#fff;background:linear-gradient(135deg,#ff9a76,#ff6d50);box-shadow:0 8rpx 18rpx rgba(255,111,77,.18);}
.advisor-avatar{width:66rpx;height:66rpx;border-radius:22rpx;font-size:30rpx;}
.head-copy{min-width:0;flex:1;margin-left:16rpx;font-weight:800;}
.head-title{display:flex;align-items:center;color:#2f2925;font-size:29rpx;font-weight:900;}
.head-title text{margin-left:10rpx;padding:4rpx 10rpx;border-radius:99rpx;color:#46a66d;background:#eaf8ef;font-size:17rpx;font-weight:800;}
.status{overflow:hidden;margin-top:5rpx;color:#9a918a;font-size:20rpx;font-weight:400;text-overflow:ellipsis;white-space:nowrap;}
.status-dot{display:inline-block;width:12rpx;height:12rpx;margin-right:8rpx;border-radius:50%;background:#68ce8a;}
.head-action{padding:18rpx 8rpx;color:#9b9189;font-size:30rpx;letter-spacing:3rpx;}
.chat-scroll{flex:1;height:0;padding:0 24rpx;box-sizing:border-box;background:transparent;}
.date-chip{display:table;margin:22rpx auto;padding:8rpx 18rpx;border-radius:99rpx;color:#aaa19a;background:#f2ebe5;font-size:19rpx;}
.welcome{text-align:center;padding:26rpx 40rpx 28rpx;}
.welcome-icon{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;margin:0 auto;border-radius:50%;background:#fff1e9;box-shadow:0 12rpx 35rpx rgba(255,117,82,.12);font-size:42rpx;}
.welcome-title{margin:18rpx 0 8rpx;color:#2f2925;font-size:34rpx;font-weight:900;}
.welcome-sub{color:#9d938c;font-size:22rpx;line-height:1.55;}
.quick-list{display:flex;flex-direction:column;gap:14rpx;margin:0 10rpx 30rpx;}
.quick{display:flex;align-items:center;justify-content:space-between;padding:24rpx 24rpx;border:1rpx solid #eee3db;border-radius:22rpx;color:#6d635c;background:#fff;font-size:24rpx;box-shadow:0 8rpx 22rpx rgba(80,59,43,.05);}
.quick text{color:#ff7552;font-size:34rpx;}
.advisor-groups{display:flex;flex-direction:column;gap:20rpx;margin:0 10rpx 30rpx;}
.advisor-group{padding:24rpx;border:1rpx solid #eee3db;border-radius:28rpx;background:linear-gradient(135deg,#fff,#fffbf7);box-shadow:0 6rpx 20rpx rgba(80,59,43,.04);}
.advisor-group-head{display:flex;flex-direction:column;gap:7rpx;margin:0 4rpx 20rpx;}
.advisor-group-title{color:#3e352f;font-size:25rpx;font-weight:900;white-space:nowrap;}
.advisor-group-desc{color:#8e8178;font-size:21rpx;line-height:1.5;}
.advisor-group-items{display:flex;flex-wrap:wrap;gap:10rpx;}
.advisor-item{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;min-width:46%;flex:1;min-height:80rpx;padding:18rpx;border:1rpx solid #f3e7de;border-radius:18rpx;color:#6b4d3d;background:#fff5ed;font-size:23rpx;line-height:1.5;}
.advisor-arrow{margin-left:8rpx;color:#ff7552;font-size:28rpx;line-height:1;}
.messages{padding-bottom:34rpx;}
.message-row{display:flex;align-items:flex-start;margin:26rpx 0;}
.message-row.user{justify-content:flex-end;}
.bubble-avatar{width:54rpx;height:54rpx;margin-right:12rpx;border-radius:18rpx;font-size:24rpx;}
.bubble{max-width:74%;padding:20rpx 22rpx 12rpx;border-radius:25rpx;line-height:1.65;font-size:25rpx;white-space:pre-wrap;word-break:break-word;}
.ai-bubble{border-top-left-radius:7rpx;color:#4a413b;background:#fff;box-shadow:0 8rpx 24rpx rgba(80,59,43,.08);}
.user-bubble{border-top-right-radius:7rpx;color:#fff;background:linear-gradient(135deg,#ff8965,#ff6a4c);}
.msg-time{margin-top:6rpx;text-align:right;opacity:.6;font-size:17rpx;}
.typing{display:flex;gap:7rpx;padding:26rpx;}
.typing text{width:10rpx;height:10rpx;border-radius:50%;background:#ff8a67;animation:bounce 1s infinite alternate;}
.typing text:nth-child(2){animation-delay:.2s}
.typing text:nth-child(3){animation-delay:.4s}
@keyframes bounce{to{transform:translateY(-7rpx);opacity:.5;}}
.medical-tip{margin:30rpx 20rpx 0;color:#b1a69e;text-align:center;font-size:19rpx;line-height:1.5;}
.composer{flex:none;display:flex;align-items:center;gap:14rpx;padding:18rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eee4dc;background:#fff;}
.input-wrap{display:flex;align-items:center;flex:1;height:82rpx;padding:0 22rpx;border-radius:26rpx;background:#f7f2ee;}
.input-wrap input{flex:1;font-size:26rpx;}
.input-wrap text{color:#aca29a;font-size:30rpx;}
.send{display:flex;align-items:center;justify-content:center;width:82rpx!important;height:82rpx;padding:0!important;border-radius:25rpx;color:#fff;background:#d8d0ca;font-size:38rpx;font-weight:900;line-height:1;}
.send.ready{background:linear-gradient(135deg,#ff8965,#ff6246);box-shadow:0 10rpx 24rpx rgba(255,98,70,.22);}

@media (max-width:360px){
  .chat-head{margin-left:16rpx;margin-right:16rpx}
  .chat-scroll{padding-left:16rpx;padding-right:16rpx}
  .bubble{max-width:78%;font-size:24rpx}
  .welcome-title{font-size:31rpx}
}

@media (max-height:620px){
  .chat-head{margin-top:12rpx;padding-top:14rpx;padding-bottom:14rpx}
  .welcome{padding-top:14rpx;padding-bottom:16rpx}
  .welcome-icon{width:62rpx;height:62rpx;font-size:34rpx}
  .quick{padding-top:18rpx;padding-bottom:18rpx}
  .advisor-item{min-width:100%;}
}

.followup-thread{margin-top:-10rpx}
.followup-row{margin:0 0 14rpx}
.followup-panel{flex:1;min-width:0;max-width:none;padding:24rpx;border:1rpx solid #efdfd2;border-radius:8rpx 28rpx 28rpx;color:#604c40;background:linear-gradient(145deg,#fffaf4,#fff);box-shadow:0 8rpx 24rpx rgba(92,65,44,.05);box-sizing:border-box;white-space:normal}
.followup-heading{display:flex;align-items:center;gap:10rpx;color:#594235;font-size:25rpx;font-weight:700;line-height:1.5}
.prompt-spark{color:#e48a59;font-size:28rpx}
.followup-subtitle{margin:6rpx 0 22rpx;color:#938276;font-size:21rpx;line-height:1.5}
.followup-option{display:flex;align-items:center;box-sizing:border-box;min-height:84rpx;margin-top:12rpx;padding:18rpx 20rpx;border:1rpx solid #f0e3d9;border-radius:18rpx;background:#fff;font-size:24rpx;font-weight:500;line-height:1.5;transition:background .15s}
.followup-option.back{min-height:72rpx;margin-top:20rpx;padding-top:14rpx;padding-bottom:14rpx;color:#8a776b;background:transparent;border-color:transparent;border-top-color:#eee2d8;border-radius:0;font-size:22rpx}
.followup-label{flex:1;min-width:0;word-break:break-word}
.followup-arrow{display:flex;align-items:center;justify-content:center;flex:none;width:38rpx;height:38rpx;margin-left:16rpx;border-radius:50%;color:#cf8059;background:#fff2e8;font-size:29rpx;line-height:1}
.followup-option.back .followup-arrow{color:#8a776b;background:transparent}
.prompt-pressed{background:#ffeadb!important}
.unified-prompts{margin:0 10rpx 30rpx}
.unified-prompts .advisor-group-items{flex-direction:column}
.unified-prompts .advisor-item{width:100%;flex:none}

.advisor-item.visited,.followup-option.visited{color:#999;background:#f2f2f2;border-color:#e6e6e6}
.advisor-item.visited .advisor-arrow,.followup-option.visited .followup-arrow{color:#aaa;background:#e9e9e9}

.topic-navigation{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:16rpx 24rpx;border-bottom:1rpx solid #eee3da;background:#fffaf5;flex:none}
.topic-breadcrumb{min-width:0;flex:1;color:#88766a;font-size:22rpx;line-height:1.5}
.topic-breadcrumb text{color:#5c493d}
.topic-return{flex:none;padding:12rpx 16rpx;border-radius:16rpx;background:#f5e9df;color:#875b40;font-size:22rpx}
.visited-note{flex:none;margin-left:12rpx;color:#909090;font-size:19rpx;font-weight:400}
.answer-title{margin-bottom:16rpx;color:#71523e;font-size:24rpx;font-weight:700}
.answer-paragraph{margin-top:16rpx;line-height:1.75;white-space:pre-wrap}
.answer-lead{margin-top:0;font-weight:600;color:#433a34}
.record-link{margin-top:20rpx;padding:16rpx;border-radius:14rpx;background:#fff0e4;color:#9c5c37;font-size:23rpx}
.chat-page,.chat-scroll{scrollbar-width:none}.chat-page::-webkit-scrollbar,.chat-scroll::-webkit-scrollbar{display:none;width:0;height:0}
.followup-panel.topics-mode{padding:18rpx}.topics-mode .followup-subtitle{margin-bottom:12rpx}.topics-mode .followup-option{position:relative;min-height:62rpx;margin-top:8rpx;padding:11rpx 14rpx;font-size:21rpx}.topics-mode .followup-option.topic-category-start{margin-top:22rpx}.topics-mode .topic-group-title{position:absolute;left:0;bottom:100%;padding-bottom:5rpx;color:#a87559;font-size:19rpx;font-weight:700}.topics-mode .followup-arrow{width:30rpx;height:30rpx;margin-left:8rpx;font-size:24rpx}.topic-category{display:none;color:#b07a5b;font-size:17rpx;font-weight:700}
.topic-group-card{margin-top:12rpx;padding:13rpx;border:1rpx solid #f0dfd2;border-radius:18rpx;background:#fffaf6}.topic-group-head{margin-bottom:9rpx;color:#9a6345;font-size:20rpx;font-weight:700}.topic-group-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8rpx}.topic-item{display:flex;align-items:center;min-width:0;min-height:52rpx;padding:8rpx 10rpx;border-radius:13rpx;background:#fff;color:#5f5047;font-size:19rpx}.topic-item>text:first-child{overflow:hidden;min-width:0;flex:1;text-overflow:ellipsis;white-space:nowrap}.topic-item.visited{color:#999;background:#f0f0f0}.topic-item .visited-note{margin-left:5rpx;font-size:16rpx}.topic-item .followup-arrow{width:26rpx;height:26rpx;margin-left:5rpx;font-size:20rpx}
.welcome-topic-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10rpx}.welcome-topic-group{padding:12rpx;border:1rpx solid #f0dfd2;border-radius:17rpx;background:#fffaf6}.welcome-topic-group:first-child{grid-column:1/-1}.welcome-topic-title{margin-bottom:8rpx;color:#9a6345;font-size:19rpx;font-weight:700}.welcome-topic-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7rpx}.welcome-topic-group:not(:first-child) .welcome-topic-grid{grid-template-columns:1fr}.welcome-topic-item{display:flex;align-items:center;min-width:0;min-height:48rpx;padding:7rpx 9rpx;border-radius:12rpx;background:#fff;color:#5f5047;font-size:18rpx}.welcome-topic-item>text:first-child{overflow:hidden;min-width:0;flex:1;text-overflow:ellipsis;white-space:nowrap}.welcome-topic-item.visited{color:#999;background:#f0f0f0}.welcome-topic-item .advisor-arrow{margin-left:4rpx}.welcome-topic-item .visited-note{margin-left:4rpx;font-size:15rpx}

/* 首屏主题面板：五个轻量分区，共用一个外层卡片。 */
.unified-prompts{padding:22rpx;border-radius:28rpx;background:linear-gradient(160deg,#fffdfb 0%,#fff8f3 100%);box-shadow:0 12rpx 34rpx rgba(97,68,49,.07)}
.unified-prompts>.followup-heading{font-size:27rpx}.unified-prompts>.followup-subtitle{margin-bottom:18rpx}
.welcome-topic-groups{gap:12rpx}
.welcome-topic-group{position:relative;overflow:hidden;padding:14rpx;border:0;border-radius:20rpx;box-shadow:inset 0 0 0 1rpx rgba(120,89,68,.07)}
.welcome-topic-group:nth-child(1){background:#fff2e9}.welcome-topic-group:nth-child(2){background:#eef8f3}.welcome-topic-group:nth-child(3){background:#f3f1fb}.welcome-topic-group:nth-child(4){background:#eef6fb}.welcome-topic-group:nth-child(5){background:#fff7df}
.welcome-topic-title{display:flex;align-items:center;margin-bottom:10rpx;color:#58483e;font-size:21rpx;font-weight:800}
.welcome-topic-title::before{content:'';width:12rpx;height:12rpx;margin-right:9rpx;border-radius:50%;background:#eb8763;box-shadow:0 0 0 6rpx rgba(235,135,99,.12)}
.welcome-topic-group:nth-child(2) .welcome-topic-title::before{background:#67aa83;box-shadow:0 0 0 6rpx rgba(103,170,131,.12)}
.welcome-topic-group:nth-child(3) .welcome-topic-title::before{background:#8f83bf;box-shadow:0 0 0 6rpx rgba(143,131,191,.12)}
.welcome-topic-group:nth-child(4) .welcome-topic-title::before{background:#699db9;box-shadow:0 0 0 6rpx rgba(105,157,185,.12)}
.welcome-topic-group:nth-child(5) .welcome-topic-title::before{background:#c99b3f;box-shadow:0 0 0 6rpx rgba(201,155,63,.12)}
.welcome-topic-grid{gap:8rpx}
.welcome-topic-item{min-height:52rpx;padding:8rpx 11rpx;border:1rpx solid rgba(255,255,255,.8);border-radius:14rpx;background:rgba(255,255,255,.78);box-shadow:0 3rpx 10rpx rgba(83,58,42,.025);font-size:19rpx;font-weight:600}
.welcome-topic-item .advisor-arrow{display:flex;align-items:center;justify-content:center;width:27rpx;height:27rpx;border-radius:50%;color:#c77b57;background:rgba(255,255,255,.9);font-size:21rpx}
.welcome-topic-item.visited{color:#999;border-color:transparent;background:rgba(235,235,235,.76);box-shadow:none}
.welcome-topic-item.visited .advisor-arrow{color:#aaa;background:rgba(255,255,255,.5)}
.welcome{padding-top:18rpx}

/* 顾问空白首屏适配一页：保留五组层级，压缩装饰占用。 */
.chat-page .welcome{padding:15rpx 0 11rpx}
.chat-page .welcome-title{font-size:32rpx}
.chat-page .welcome-sub{margin-top:7rpx;font-size:20rpx;line-height:1.4}
.chat-page .unified-prompts{margin-bottom:12rpx;padding:18rpx 20rpx;border-radius:25rpx}
.chat-page .unified-prompts>.followup-heading{font-size:25rpx}
.chat-page .unified-prompts>.followup-subtitle{margin:5rpx 0 12rpx;font-size:19rpx}
.chat-page .welcome-topic-groups{gap:9rpx}
.chat-page .welcome-topic-group{padding:11rpx 12rpx;border-radius:17rpx}
.chat-page .welcome-topic-title{margin-bottom:7rpx;font-size:19rpx}
.chat-page .welcome-topic-title::before{width:10rpx;height:10rpx;margin-right:8rpx;box-shadow:none}
.chat-page .welcome-topic-grid{gap:6rpx}
.chat-page .welcome-topic-item{min-height:46rpx;padding:7rpx 9rpx;border-radius:12rpx;font-size:18rpx}
.chat-page .welcome-topic-item .advisor-arrow{width:25rpx;height:25rpx;font-size:19rpx}

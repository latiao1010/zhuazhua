.streak{display:flex;align-items:center;padding:13rpx 17rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(80,60,45,.07);}.streak>text{margin-right:9rpx;font-size:32rpx;}.streak .bold,.streak .small{display:block;}.streak .bold{font-size:24rpx;font-weight:800;}.streak .small{color:#a0968e;font-size:16rpx;}.ai-create{display:flex;align-items:center;padding:24rpx;background:linear-gradient(135deg,#f1edff,#fff);}.magic{display:flex;align-items:center;justify-content:center;flex:none;width:74rpx;height:74rpx;border-radius:24rpx;color:#fff;background:linear-gradient(135deg,#9c89ed,#7062cf);font-size:32rpx;}.create-copy{flex:1;margin-left:18rpx;}.create-copy view{font-weight:900;}.create-copy text{display:block;margin-top:6rpx;color:#91879a;font-size:20rpx;}.ai-create button{width:auto!important;margin:0;padding:0 23rpx;border-radius:999rpx;color:#7668d0;background:#fff;border:2rpx solid #ddd5ff;font-size:22rpx;font-weight:800;}.section-row,.diary-head,.diary-foot{display:flex;align-items:center;justify-content:space-between;}.count{color:#a19891;font-size:21rpx;}.diary-list{display:flex;flex-direction:column;gap:24rpx;}.diary{position:relative;padding:30rpx;background:#fffefb;}.paper-tape{position:absolute;left:50%;top:-13rpx;width:110rpx;height:26rpx;background:rgba(255,218,144,.55);transform:translateX(-50%) rotate(-2deg);}.diary-date{color:#a0968e;font-size:20rpx;}.diary-title{margin-top:8rpx;font-size:31rpx;font-weight:900;}.mood{font-size:50rpx;}.chips{display:flex;gap:12rpx;margin:19rpx 0;}.chips text{padding:8rpx 14rpx;border-radius:99rpx;color:#907f70;background:#f8f0e8;font-size:19rpx;}.diary-body{color:#5d554f;line-height:1.9;font-size:25rpx;}.highlight{margin-top:22rpx;padding:18rpx 20rpx;border-radius:18rpx;color:#9c6e32;background:#fff3cf;font-size:22rpx;line-height:1.5;}.diary-foot{margin-top:24rpx;padding-top:18rpx;border-top:1rpx dashed #e9ded5;color:#a59b93;font-size:22rpx;}.diary-foot>view:last-child{display:flex;gap:30rpx;font-size:30rpx;}.paw{color:#bb7659;font-weight:700;}.close{color:#aaa;font-size:42rpx;font-weight:400;}.moods{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin:14rpx 0 28rpx;}.mood-item{padding:20rpx 5rpx;border:2rpx solid #eee3dc;border-radius:22rpx;text-align:center;color:#8f857e;}.mood-item text{display:block;margin-bottom:7rpx;font-size:38rpx;}.mood-item.active{border-color:#ff9275;color:#ff6849;background:#fff1e9;font-weight:800;}.note{width:100%;height:160rpx;padding:20rpx 22rpx;border:2rpx solid #f0e6df;border-radius:22rpx;background:#fffcf9;box-sizing:border-box;font-size:25rpx;}.data-source{display:flex;align-items:center;margin:10rpx 0 26rpx;padding:20rpx;border-radius:20rpx;color:#6e62c8;background:#f3f0ff;}.data-source>text{margin-right:16rpx;font-size:30rpx;}.data-source .bold,.data-source .small{display:block;}.data-source .bold{font-size:23rpx;font-weight:800;}.data-source .small{margin-top:5rpx;color:#938bb7;font-size:19rpx;}

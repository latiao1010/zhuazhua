<view class="page">
  <view class="topbar">
    <view><view class="eyebrow">{{detailEyebrow}}</view><view class="page-title">{{detailTitle}}</view></view>
    <picker class="calendar-picker" mode="date" value="{{selectedDate}}" end="{{today}}" bindchange="onRecordDate">
      <view class="calendar">{{day}}<text>{{month}}月</text></view>
    </picker>
  </view>

  <view class="record-tabs" wx:if="{{!singleMode}}">
    <view class="record-tab {{currentType === item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-type="{{item.key}}" bindtap="switchType"><text>{{item.icon}}</text>{{item.tab}}</view>
  </view>

  <view class="summary card" wx:if="{{summary.kind === 'progress'}}">
    <view class="summary-top">
      <view><view class="summary-label">{{summary.label}}</view><view><text class="summary-num">{{summary.value}}</text><text class="summary-unit"> {{summary.unit}}</text></view></view>
      <view class="goal editable" wx:if="{{currentType === 'feed' && !readOnly}}" bindtap="openFeedGoalEditor">{{summary.goalText}}<text> ✎</text></view>
      <view class="goal editable" wx:elif="{{currentType === 'water' && !readOnly}}" bindtap="openWaterGoalEditor">{{summary.goalText}}<text> ✎</text></view>
      <view class="goal" wx:else>{{summary.goalText}}</view>
    </view>
    <view class="progress"><view class="progress-inner" style="width: {{summary.progress}}%"></view></view>
    <view class="summary-foot"><text>{{summary.footLeft}}</text><text>{{summary.footRight}}</text></view>
  </view>
  <view class="stool-summary card" wx:else>
    <view class="stool-score {{summary.warning ? 'warning' : ''}}">{{summary.score}}</view>
    <view class="stool-summary-copy"><view>{{summary.headline}}</view><text>{{summary.sub}}</text></view>
    <view class="stool-count"><text class="count-number">{{summary.count}}</text><text>{{summary.countUnit}}</text></view>
  </view>

  <view class="section-row"><view class="section-title">{{typeMeta.title}}</view><view class="record-toolbar"><text>{{dateFilterText}}</text><button wx:if="{{selectingRecords}}" bindtap="toggleRecordSelectionMode">取消选择</button><button wx:else bindtap="openRecordTools" aria-label="搜索、筛选与批量管理">管理 ···</button></view></view>
  <view class="record-filters" wx:if="{{showFilters}}"><input cursor-spacing="24" value="{{recordSearch}}" placeholder="搜索名称、备注或状态" bindinput="onRecordSearch" confirm-type="search" /><picker mode="selector" range="{{authorOptions}}" value="{{authorFilterIndex}}" range-key="label" bindchange="onAuthorFilter"><view>{{authorFilterLabel}} ›</view></picker></view>
  <view class="filter-state" wx:if="{{filtersActive}}"><text>筛选结果 {{rows.length}} 条 · 上方为当日总计</text><button bindtap="clearRecordFilters">清除筛选</button></view>

  <view class="timeline" wx:if="{{rows.length}}">
    <view class="feed-row" wx:for="{{rows}}" wx:key="id">
      <view class="time"><text>{{item.time}}</text><text class="date">{{item.date}}</text></view>
      <view class="rail"><view class="dot {{item.dotClass}}"></view><view class="line" wx:if="{{index < rows.length - 1}}"></view></view>
      <view class="feed-card card">
        <view class="record-select {{item.selected ? 'selected' : ''}}" wx:if="{{selectingRecords}}" data-id="{{item.id}}" bindtap="toggleSelectedRecord">{{item.selected ? '✓' : ''}}</view>
        <view class="food-icon {{item.iconClass}}">{{item.icon}}</view>
        <view class="food-copy"><view class="food-head"><text>{{item.title}}</text><text class="{{item.metaClass}}">{{item.meta}}</text></view><view class="food-name" wx:if="{{item.sub}}">{{item.sub}}</view><view class="record-author" wx:if="{{item.authorText}}">{{item.authorText}}</view></view>
        <view class="more" wx:if="{{!readOnly && !selectingRecords}}" data-id="{{item.id}}" bindtap="openRecordActions">···</view>
      </view>
    </view>
  </view>
  <view class="empty card" wx:else><view class="empty-companion"><view class="warm-icon warm-icon-paw"></view></view><view>{{emptyText}}</view></view>
  <button class="batch-delete" wx:if="{{selectingRecords}}" disabled="{{!selectedRecordIds.length}}" bindtap="removeSelectedRecords">删除已选 {{selectedRecordIds.length}} 条</button>

  <view class="feed-trend-card card {{feedTrend.theme}}" wx:if="{{feedTrend.days.length}}">
    <view class="trend-range"><view class="trend-range-item {{trendRange === 7 ? 'active' : ''}}" data-range="7" bindtap="setTrendRange">7 天</view><view class="trend-range-item {{trendRange === 30 ? 'active' : ''}}" data-range="30" bindtap="setTrendRange">30 天</view><view class="trend-range-item {{trendRange === 180 ? 'active' : ''}}" data-range="180" bindtap="setTrendRange">半年</view></view>
    <view class="feed-trend-head"><view><view>{{feedTrend.title}}</view><text>截至 {{feedTrend.endLabel}} · 每天合并显示</text></view><view class="feed-trend-change {{feedTrend.changeClass}}">{{feedTrend.changeText}}</view></view>
    <view class="feed-trend-metrics"><view wx:for="{{feedTrend.metrics}}" wx:key="label"><text>{{item.value}}</text><view>{{item.label}}</view></view></view>
    <scroll-view class="feed-trend-scroll" scroll-x enhanced show-scrollbar="false" scroll-left="{{feedTrend.scrollLeft}}"><view class="feed-trend-chart" style="width:{{feedTrend.chartWidth}}rpx"><view class="feed-trend-column {{item.selected ? 'selected' : ''}}" wx:for="{{feedTrend.days}}" wx:key="dayKey" data-date="{{item.dayKey}}" bindtap="onTrendDay"><text class="feed-trend-value">{{item.total || ''}}</text><view class="feed-trend-bar-track"><view class="feed-trend-goal" style="bottom:{{feedTrend.goalBottom}}%"></view><view class="feed-trend-bar {{item.warning ? 'warning' : ''}} {{item.isLatest ? 'latest' : ''}}" style="height:{{item.barHeight}}rpx"></view></view><text class="feed-trend-date">{{item.dateLabel}}</text><text class="feed-trend-count">{{item.countText}}</text></view></view></scroll-view>
    <view class="feed-trend-foot"><view><text class="feed-trend-legend-line"></text><text>{{feedTrend.goalText}}</text></view><text>{{feedTrend.footText}}</text></view>
  </view>

  <button class="add-btn" wx:if="{{!readOnly}}" bindtap="openAdd"><text>＋</text> {{typeMeta.addText}}</button>
  <view class="readonly-hint" wx:else>只读共享成员可查看记录，不能修改</view>
</view>

<view class="overlay" wx:if="{{editingWaterGoal}}" catchtap="closeWaterGoalEditor">
  <view class="sheet goal-sheet" catchtap="noop">
    <view class="sheet-head"><text>修改每日饮水目标</text><text class="close" bindtap="closeWaterGoalEditor">×</text></view>
    <view class="goal-editor-copy">设置后，今日剩余饮水量、完成进度和趋势图目标线会立即更新。</view>
    <view class="goal-editor-field">
      <input cursor-spacing="24" type="number" focus maxlength="5" value="{{waterGoalDraft}}" bindinput="onWaterGoalInput" bindconfirm="saveWaterGoal" />
      <text>毫升 / 天</text>
    </view>
    <view class="goal-editor-tip">当前建议值根据体重估算；可结合食物含水量、天气、活动量及兽医建议调整。</view>
    <button class="primary-btn" bindtap="saveWaterGoal">保存目标</button>
  </view>
</view>

<view class="overlay" wx:if="{{editingFeedGoal}}" catchtap="closeFeedGoalEditor">
  <view class="sheet goal-sheet" catchtap="noop">
    <view class="sheet-head"><text>修改每日喂食目标</text><text class="close" bindtap="closeFeedGoalEditor">×</text></view>
    <view class="goal-editor-copy">设置后，今日剩余克数、完成进度和趋势图目标线会立即更新。</view>
    <view class="goal-editor-field">
      <input cursor-spacing="24" type="number" focus maxlength="4" value="{{feedGoalDraft}}" bindinput="onFeedGoalInput" bindconfirm="saveFeedGoal" />
      <text>克 / 天</text>
    </view>
    <view class="goal-editor-tip">请根据宠物体重、年龄、活动量和所用粮食说明合理设置。</view>
    <button class="primary-btn" bindtap="saveFeedGoal">保存目标</button>
  </view>
</view>

<view class="overlay" wx:if="{{adding}}" catchtap="closeAdd">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head"><text>{{editingRecordId !== null ? '编辑记录' : (draft.dayKey !== today ? '补记记录' : typeMeta.sheetTitle)}}</text><text class="close" bindtap="closeAdd">×</text></view>
    <picker mode="date" value="{{draft.dayKey}}" end="{{today}}" bindchange="onDraftDate"><view class="record-date-field">记录日期 <text>{{draft.dayKey}} ›</text></view></picker>
    <block wx:if="{{currentType === 'feed'}}">
      <view class="meal-tabs"><view wx:for="{{mealTypes}}" wx:key="*this" class="meal-tab {{draft.type === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseType">{{item}}</view></view>
      <view class="field"><text class="label">吃了什么</text><input cursor-spacing="24" class="input" placeholder="例如：低敏犬粮" value="{{draft.food}}" data-key="food" bindinput="onInput" /></view>
      <view class="form-grid"><view class="field"><text class="label">分量（g）</text><input cursor-spacing="24" class="input" type="number" placeholder="90" value="{{draft.amount}}" data-key="amount" bindinput="onInput" /></view><view class="field"><text class="label">时间</text><picker mode="time" value="{{draft.time}}" bindchange="onTime"><view class="input picker">{{draft.time}}</view></picker></view></view>
    </block>
    <block wx:elif="{{currentType === 'stool'}}">
      <view class="label">便便状态</view>
      <view class="condition-grid"><view wx:for="{{stoolConditions}}" wx:key="*this" class="condition-option {{draft.condition === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseCondition">{{item}}</view></view>
      <view class="label">颜色</view>
      <view class="color-list"><view wx:for="{{stoolColors}}" wx:key="*this" class="color-option {{draft.color === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseColor">{{item}}</view></view>
      <view class="form-grid"><view class="field"><text class="label">备注（选填）</text><input cursor-spacing="24" class="input" placeholder="气味、异物等" value="{{draft.note}}" data-key="note" bindinput="onInput" /></view><view class="field"><text class="label">时间</text><picker mode="time" value="{{draft.time}}" bindchange="onTime"><view class="input picker">{{draft.time}}</view></picker></view></view>
      <view class="stool-alert" wx:if="{{draft.condition === '稀便' || draft.condition === '便秘/干硬' || draft.color === '黑色' || draft.color === '红色'}}">⚠ 已标记为需观察；若反复出现或伴随精神、食欲异常，请联系兽医。</view>
    </block>
    <block wx:elif="{{currentType === 'water'}}">
      <view class="form-grid"><view class="field"><text class="label">饮水量（ml）</text><input cursor-spacing="24" class="input" type="number" placeholder="150" value="{{draft.amount}}" data-key="amount" bindinput="onInput" /></view><view class="field"><text class="label">时间</text><picker mode="time" value="{{draft.time}}" bindchange="onTime"><view class="input picker">{{draft.time}}</view></picker></view></view>
      <view class="field"><text class="label">备注（选填）</text><input cursor-spacing="24" class="input" placeholder="例如：加了羊奶粉" value="{{draft.note}}" data-key="note" bindinput="onInput" /></view>
    </block>
    <block wx:else>
      <view class="form-grid"><view class="field"><text class="label">时长（分钟）</text><input cursor-spacing="24" class="input" type="number" placeholder="30" value="{{draft.duration}}" data-key="duration" bindinput="onInput" /></view><view class="field"><text class="label">距离（km，选填）</text><input cursor-spacing="24" class="input" type="digit" placeholder="1.5" value="{{draft.distance}}" data-key="distance" bindinput="onInput" /></view></view>
      <view class="form-grid"><view class="field"><text class="label">备注（选填）</text><input cursor-spacing="24" class="input" placeholder="例如：小区一圈" value="{{draft.note}}" data-key="note" bindinput="onInput" /></view><view class="field"><text class="label">时间</text><picker mode="time" value="{{draft.time}}" bindchange="onTime"><view class="input picker">{{draft.time}}</view></picker></view></view>
    </block>
    <button class="primary-btn" bindtap="saveRecord">保存记录</button>
  </view>
</view>

<view class="page">
  <view class="topbar">
    <view><view class="eyebrow">{{detailEyebrow}}</view><view class="page-title">{{detailTitle}}</view></view>
    <picker class="calendar-picker" mode="date" value="{{selectedDate}}" end="{{today}}" bindchange="onRecordDate">
      <view class="calendar">{{day}}<text>{{month}}月</text></view>
    </picker>
  </view>

  <view class="record-tabs" wx:if="{{!singleMode}}">
    <view class="record-tab {{currentType === item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-type="{{item.key}}" bindtap="switchType"><text>{{item.icon}}</text>{{item.tab}}</view>
  </view>

  <view class="summary card" wx:if="{{summary.kind === 'progress'}}">
    <view class="summary-top">
      <view><view class="summary-label">{{summary.label}}</view><view><text class="summary-num">{{summary.value}}</text><text class="summary-unit"> {{summary.unit}}</text></view></view>
      <view class="goal">{{summary.goalText}}</view>
    </view>
    <view class="progress"><view class="progress-inner" style="width: {{summary.progress}}%"></view></view>
    <view class="summary-foot"><text>{{summary.footLeft}}</text><text>{{summary.footRight}}</text></view>
  </view>
  <view class="stool-summary card" wx:else>
    <view class="stool-score {{summary.warning ? 'warning' : ''}}">{{summary.score}}</view>
    <view class="stool-summary-copy"><view>{{summary.headline}}</view><text>{{summary.sub}}</text></view>
    <view class="stool-count"><text class="count-number">{{summary.count}}</text><text>{{summary.countUnit}}</text></view>
  </view>

  <view class="feed-trend-card card {{feedTrend.theme}}" wx:if="{{feedTrend.days.length}}">
    <view class="feed-trend-head">
      <view><view>{{feedTrend.title}}</view><text>截至 {{feedTrend.endLabel}} · 每天合并显示</text></view>
      <view class="feed-trend-change {{feedTrend.changeClass}}">{{feedTrend.changeText}}</view>
    </view>
    <view class="feed-trend-metrics">
      <view wx:for="{{feedTrend.metrics}}" wx:key="label"><text>{{item.value}}</text><view>{{item.label}}</view></view>
    </view>
    <scroll-view class="feed-trend-scroll" scroll-x enhanced show-scrollbar="false" scroll-left="{{feedTrend.scrollLeft}}">
      <view class="feed-trend-chart" style="width:{{feedTrend.chartWidth}}rpx">
        <view class="feed-trend-column {{item.selected ? 'selected' : ''}}" wx:for="{{feedTrend.days}}" wx:key="dayKey" data-date="{{item.dayKey}}" bindtap="onTrendDay">
          <text class="feed-trend-value">{{item.total || ''}}</text>
          <view class="feed-trend-bar-track">
            <view class="feed-trend-goal" style="bottom:{{feedTrend.goalBottom}}%"></view>
            <view class="feed-trend-bar {{item.warning ? 'warning' : ''}} {{item.isLatest ? 'latest' : ''}}" style="height:{{item.barHeight}}rpx"></view>
          </view>
          <text class="feed-trend-date">{{item.dateLabel}}</text>
          <text class="feed-trend-count">{{item.countText}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="feed-trend-foot"><view><text class="feed-trend-legend-line"></text><text>{{feedTrend.goalText}}</text></view><text>{{feedTrend.footText}}</text></view>
  </view>

  <view class="section-row"><view class="section-title">{{typeMeta.title}}</view><view class="filter">{{dateFilterText}}</view></view>

  <view class="timeline" wx:if="{{rows.length}}">
    <view class="feed-row" wx:for="{{rows}}" wx:key="id">
      <view class="time"><text>{{item.time}}</text><text class="date">{{item.date}}</text></view>
      <view class="rail"><view class="dot {{item.dotClass}}"></view><view class="line" wx:if="{{index < rows.length - 1}}"></view></view>
      <view class="feed-card card">
        <view class="food-icon {{item.iconClass}}">{{item.icon}}</view>
        <view class="food-copy"><view class="food-head"><text>{{item.title}}</text><text class="{{item.metaClass}}">{{item.meta}}</text></view><view class="food-name" wx:if="{{item.sub}}">{{item.sub}}</view></view>
        <view class="more" data-id="{{item.id}}" bindtap="removeRecord">···</view>
      </view>
    </view>
  </view>
  <view class="empty card" wx:else>{{emptyText}}</view>

  <button class="add-btn" bindtap="openAdd"><text>＋</text> {{typeMeta.addText}}</button>
</view>

<view class="overlay" wx:if="{{adding}}" catchtap="closeAdd">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head"><text>{{typeMeta.sheetTitle}}</text><text class="close" bindtap="closeAdd">×</text></view>
    <block wx:if="{{currentType === 'feed'}}">
      <view class="meal-tabs"><view wx:for="{{mealTypes}}" wx:key="*this" class="meal-tab {{draft.type === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseType">{{item}}</view></view>
      <view class="field"><text class="label">吃了什么</text><input class="input" placeholder="例如：低敏犬粮" value="{{draft.food}}" data-key="food" bindinput="onInput" /></view>
      <view class="form-grid"><view class="field"><text class="label">分量（g）</text><input class="input" type="number" placeholder="90" value="{{draft.amount}}" data-key="amount" bindinput="onInput" /></view><view class="field"><text class="label">时间</text><picker mode="time" value="{{draft.time}}" bindchange="onTime"><view class="input picker">{{draft.time}}</view></picker></view></view>
    </block>
    <block wx:elif="{{currentType === 'stool'}}">
      <view class="label">便便状态</view>
      <view class="condition-grid"><view wx:for="{{stoolConditions}}" wx:key="*this" class="condition-option {{draft.condition === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseCondition">{{item}}</view></view>
      <view class="label">颜色</view>
      <view class="color-list"><view wx:for="{{stoolColors}}" wx:key="*this" class="color-option {{draft.color === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseColor">{{item}}</view></view>
      <view class="form-grid"><view class="field"><text class="label">备注（选填）</text><input class="input" placeholder="气味、异物等" value="{{draft.note}}" data-key="note" bindinput="onInput" /></view><view class="field"><text class="label">时间</text><picker mode="time" value="{{draft.time}}" bindchange="onTime"><view class="input picker">{{draft.time}}</view></picker></view></view>
      <view class="stool-alert" wx:if="{{draft.condition === '稀便' || draft.condition === '便秘/干硬' || draft.color === '黑色' || draft.color === '红色'}}">⚠ 已标记为需观察；若反复出现或伴随精神、食欲异常，请联系兽医。</view>
    </block>
    <block wx:elif="{{currentType === 'water'}}">
      <view class="form-grid"><view class="field"><text class="label">饮水量（ml）</text><input class="input" type="number" placeholder="150" value="{{draft.amount}}" data-key="amount" bindinput="onInput" /></view><view class="field"><text class="label">时间</text><picker mode="time" value="{{draft.time}}" bindchange="onTime"><view class="input picker">{{draft.time}}</view></picker></view></view>
      <view class="field"><text class="label">备注（选填）</text><input class="input" placeholder="例如：加了羊奶粉" value="{{draft.note}}" data-key="note" bindinput="onInput" /></view>
    </block>
    <block wx:else>
      <view class="form-grid"><view class="field"><text class="label">时长（分钟）</text><input class="input" type="number" placeholder="30" value="{{draft.duration}}" data-key="duration" bindinput="onInput" /></view><view class="field"><text class="label">距离（km，选填）</text><input class="input" type="digit" placeholder="1.5" value="{{draft.distance}}" data-key="distance" bindinput="onInput" /></view></view>
      <view class="form-grid"><view class="field"><text class="label">备注（选填）</text><input class="input" placeholder="例如：小区一圈" value="{{draft.note}}" data-key="note" bindinput="onInput" /></view><view class="field"><text class="label">时间</text><picker mode="time" value="{{draft.time}}" bindchange="onTime"><view class="input picker">{{draft.time}}</view></picker></view></view>
    </block>
    <button class="primary-btn" bindtap="saveRecord">保存记录</button>
  </view>
</view>

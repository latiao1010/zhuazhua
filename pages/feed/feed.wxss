.calendar-picker{flex:none}.calendar{display:flex;flex-direction:column;align-items:center;justify-content:center;width:74rpx;height:74rpx;border-radius:22rpx;color:#fff;background:#ff7856;font-size:28rpx;font-weight:900;box-shadow:0 10rpx 24rpx rgba(255,105,70,.24)}.calendar text{font-size:18rpx;font-weight:500}.record-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:6rpx;margin-bottom:20rpx;padding:8rpx;border-radius:25rpx;background:#eee7e1}.record-tab{padding:18rpx 4rpx;border-radius:19rpx;color:#938a83;text-align:center;font-size:23rpx;font-weight:700}.record-tab text{margin-right:6rpx}.record-tab.active{color:#ff6849;background:#fff;box-shadow:0 5rpx 15rpx rgba(80,60,45,.08)}
.summary{padding:30rpx;color:#fff;background:linear-gradient(140deg,#3e3935,#5d5148)}.summary-top,.summary-foot,.section-row,.food-head{display:flex;align-items:center;justify-content:space-between}.summary-label{margin-bottom:8rpx;color:#d6cec8;font-size:23rpx}.summary-num{font-size:56rpx;font-weight:900}.summary-unit{color:#ded7d1}.goal{padding:10rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.1);font-size:21rpx}.goal.editable{border:1rpx solid rgba(255,255,255,.15);background:rgba(255,255,255,.16)}.goal.editable:active{opacity:.72}.goal.editable text{margin-left:3rpx;color:#ffb89f;font-size:19rpx}.progress{overflow:hidden;height:14rpx;margin:25rpx 0 12rpx;border-radius:99rpx;background:rgba(255,255,255,.14)}.progress-inner{height:100%;border-radius:99rpx;background:linear-gradient(90deg,#ffb277,#ff6d4e)}.summary-foot{color:#d7cec8;font-size:21rpx}
.stool-summary{display:flex;align-items:center;padding:28rpx;background:linear-gradient(135deg,#f0fff5,#fff)}.stool-score{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:24rpx;color:#fff;background:#65c98a;font-size:36rpx;font-weight:900}.stool-score.warning{background:#f4a24f}.stool-summary-copy{flex:1;margin-left:20rpx}.stool-summary-copy view{font-weight:900}.stool-summary-copy text{display:block;margin-top:8rpx;color:#8e847c;font-size:21rpx}.stool-count{display:flex;align-items:baseline;color:#6d635c}.stool-count .count-number{font-size:42rpx;font-weight:900}.stool-count text{margin-left:5rpx;font-size:20rpx}
.section-row{margin-top:4rpx}.filter{color:#978b83;font-size:23rpx}.timeline{margin-top:2rpx}.feed-row{display:grid;grid-template-columns:90rpx 30rpx 1fr;min-height:150rpx}.time{padding-top:23rpx;text-align:right;font-size:24rpx;font-weight:700}.date{display:block;margin-top:4rpx;color:#aaa098;font-size:19rpx;font-weight:400}.rail{position:relative;display:flex;justify-content:center}.dot{z-index:1;width:17rpx;height:17rpx;margin-top:32rpx;border:6rpx solid #ffe3d5;border-radius:50%;background:#ff7654}.stool-dot{border-color:#d9f3e3;background:#63c887}.water-dot{border-color:#d8ecf7;background:#57a8d6}.walk-dot{border-color:#e5efd8;background:#89b95e}.warning-dot{border-color:#ffe6c8;background:#f2a14e}.line{position:absolute;top:52rpx;bottom:-4rpx;width:2rpx;background:#eadfd8}.feed-card{align-self:start;display:flex;align-items:center;margin:0 0 18rpx 12rpx;padding:22rpx}.food-icon{flex:none;width:66rpx;height:66rpx;border-radius:20rpx;background:#fff1e7;text-align:center;line-height:66rpx;font-size:34rpx}.stool-icon{background:#edf9f1}.water-icon{background:#e8f4fa}.walk-icon{background:#eff6e5}.food-copy{flex:1;margin-left:18rpx}.food-head{font-weight:800}.food-name{margin-top:6rpx;color:#998f87;font-size:22rpx}.amount{color:#ff6f4d}.condition{padding:5rpx 10rpx;border-radius:99rpx;color:#54a976;background:#eaf8ef;font-size:18rpx}.warning-text{color:#d67b2e;background:#fff0dd}.more{padding-left:12rpx;color:#b8ada5;letter-spacing:2rpx}
.page{padding-bottom:150rpx}.add-btn{position:fixed;right:32rpx;bottom:calc(34rpx + env(safe-area-inset-bottom));z-index:5;width:auto!important;padding:0 30rpx;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,#ff8966,#ff6246);box-shadow:0 14rpx 34rpx rgba(255,98,70,.3);font-size:26rpx;font-weight:800}.add-btn text{font-size:34rpx}.close{color:#aaa;font-size:42rpx;font-weight:400}.meal-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-bottom:28rpx}.meal-tab{padding:20rpx 0;border:2rpx solid #f1e5de;border-radius:18rpx;text-align:center;color:#8f857d}.meal-tab.active{border-color:#ff987d;color:#ff6648;background:#fff0e9;font-weight:800}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.picker{line-height:84rpx}.condition-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin:12rpx 0 24rpx}.condition-option,.color-option{padding:18rpx 10rpx;border:2rpx solid #eee3dc;border-radius:18rpx;text-align:center;color:#8c827b}.condition-option.active,.color-option.active{border-color:#ff8e70;color:#ff6749;background:#fff0e9;font-weight:800}.color-list{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin:12rpx 0 24rpx}.color-option{font-size:22rpx}.stool-alert{margin-bottom:22rpx;padding:18rpx;border-radius:18rpx;color:#ac662e;background:#fff1df;font-size:21rpx;line-height:1.5}

.feed-trend-card{overflow:hidden;margin-top:22rpx;padding:26rpx 22rpx 20rpx}.feed-trend-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.feed-trend-head>view:first-child{min-width:0}.feed-trend-head>view:first-child>view{font-size:27rpx;font-weight:900}.feed-trend-head>view:first-child>text{display:block;margin-top:7rpx;color:#9c9189;font-size:19rpx}.feed-trend-change{flex:none;max-width:210rpx;padding:8rpx 12rpx;border-radius:999rpx;color:#80766f;background:#f4efeb;text-align:center;font-size:18rpx;line-height:1.3}.feed-trend-change.up{color:#d66645;background:#fff0e8}.feed-trend-change.down{color:#4d8b69;background:#eaf7ef}.feed-trend-metrics{display:grid;grid-template-columns:repeat(3,1fr);margin-top:22rpx;padding:17rpx 4rpx;border-radius:20rpx;background:#fff8f3}.feed-trend-metrics>view{border-right:1rpx solid #f0e4dc;text-align:center}.feed-trend-metrics>view:last-child{border-right:0}.feed-trend-metrics text{font-size:29rpx;font-weight:900}.feed-trend-metrics view view{margin-top:4rpx;color:#9f948c;font-size:17rpx}.feed-trend-scroll{width:100%;margin-top:20rpx;white-space:nowrap}.feed-trend-chart{display:flex;align-items:flex-end;height:216rpx}.feed-trend-column{flex:none;display:flex;flex-direction:column;align-items:center;width:70rpx}.feed-trend-value{height:26rpx;color:#7f746d;font-size:16rpx;line-height:26rpx}.feed-trend-bar-track{position:relative;display:flex;align-items:flex-end;justify-content:center;width:34rpx;height:132rpx;border-radius:12rpx 12rpx 5rpx 5rpx;background:#f4efeb}.feed-trend-goal{position:absolute;z-index:1;left:-7rpx;width:48rpx;border-top:2rpx dashed #f0a071}.feed-trend-bar{z-index:2;width:26rpx;border-radius:9rpx 9rpx 4rpx 4rpx;background:linear-gradient(180deg,#ffc28d,#ff8a64)}.feed-trend-bar.latest{background:linear-gradient(180deg,#ff9c76,#ff674d);box-shadow:0 5rpx 12rpx rgba(255,103,77,.22)}.feed-trend-column.selected .feed-trend-bar-track{box-shadow:0 0 0 4rpx rgba(255,105,77,.34)}.feed-trend-column.selected .feed-trend-value,.feed-trend-column.selected .feed-trend-date,.feed-trend-column.selected .feed-trend-count{color:#ff684b;font-weight:800}.feed-trend-date{height:26rpx;margin-top:7rpx;color:#857a73;font-size:17rpx;line-height:26rpx}.feed-trend-count{height:24rpx;color:#b0a59d;font-size:15rpx;line-height:24rpx}.feed-trend-foot{display:flex;align-items:center;justify-content:space-between;margin-top:8rpx;color:#9b9088;font-size:17rpx}.feed-trend-foot>view{display:flex;align-items:center}.feed-trend-legend-line{display:inline-block;width:24rpx;margin-right:7rpx;border-top:2rpx dashed #f0a071}
.feed-trend-card.water .feed-trend-metrics{background:#f2f9fc}.feed-trend-card.water .feed-trend-bar{background:linear-gradient(180deg,#9edaf1,#54add8)}.feed-trend-card.water .feed-trend-bar.latest{background:linear-gradient(180deg,#72c6e8,#399acb);box-shadow:0 5rpx 12rpx rgba(57,154,203,.22)}.feed-trend-card.water .feed-trend-goal,.feed-trend-card.water .feed-trend-legend-line{border-color:#6ab9dc}.feed-trend-card.water .feed-trend-column.selected .feed-trend-bar-track{box-shadow:0 0 0 4rpx rgba(72,166,208,.3)}.feed-trend-card.water .feed-trend-column.selected .feed-trend-value,.feed-trend-card.water .feed-trend-column.selected .feed-trend-date,.feed-trend-card.water .feed-trend-column.selected .feed-trend-count{color:#318db9}
.feed-trend-card.stool .feed-trend-metrics{background:#f2faf5}.feed-trend-card.stool .feed-trend-bar{background:linear-gradient(180deg,#aaddb8,#62bd82)}.feed-trend-card.stool .feed-trend-bar.latest{background:linear-gradient(180deg,#84cf9c,#48a96b);box-shadow:0 5rpx 12rpx rgba(72,169,107,.2)}.feed-trend-card.stool .feed-trend-bar.warning{background:linear-gradient(180deg,#ffc17e,#ed8b3e)}.feed-trend-card.stool .feed-trend-goal,.feed-trend-card.stool .feed-trend-legend-line{border-color:#6fbd89}.feed-trend-card.stool .feed-trend-column.selected .feed-trend-bar-track{box-shadow:0 0 0 4rpx rgba(77,174,111,.3)}.feed-trend-card.stool .feed-trend-column.selected .feed-trend-value,.feed-trend-card.stool .feed-trend-column.selected .feed-trend-date,.feed-trend-card.stool .feed-trend-column.selected .feed-trend-count{color:#449c64}

.goal-sheet{padding-bottom:calc(42rpx + env(safe-area-inset-bottom))}.goal-editor-copy{margin:-5rpx 0 24rpx;color:#81766f;font-size:22rpx;line-height:1.55}.goal-editor-field{display:flex;align-items:center;padding:20rpx 24rpx;border:2rpx solid #f0dfd5;border-radius:24rpx;background:#fffaf6}.goal-editor-field input{min-width:0;height:72rpx;flex:1;color:#3f3732;font-size:42rpx;font-weight:900}.goal-editor-field>text{flex:none;margin-left:16rpx;color:#8d8179;font-size:23rpx;font-weight:700}.goal-editor-tip{margin:16rpx 3rpx 26rpx;color:#a0958d;font-size:19rpx;line-height:1.5}

/* 页面样式按原有级联顺序整理；媒体规则独立保留。 */
.calendar-picker { flex: none; }
.calendar { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; border-radius: 26rpx; color: #fff; background: var(--orange); font-size: 28rpx; font-weight: 600; box-shadow: none; }
.calendar text { font-size: 22rpx; font-weight: 500; }
.record-tabs { display: grid; grid-template-columns: repeat(4,1fr); gap: 6rpx; margin-bottom: 20rpx; padding: 8rpx; border-radius: 25rpx; background: #eee7e1; }
.record-tab { padding: 18rpx 4rpx; border-radius: 19rpx; color: #938a83; text-align: center; font-size: 23rpx; font-weight: 700; }
.record-tab text { margin-right: 6rpx; }
.record-tab.active { background: #fff; }
.feed-card .food-copy { min-width: 0; overflow-wrap: anywhere; }
.food-head { gap: 10rpx; flex-wrap: wrap; }
.record-filters picker { max-width: 40%; overflow: hidden; }
.record-filters picker view { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 22rpx 12rpx; font-size: 24rpx; }
.summary { padding: 30rpx; background: #edf8f2; color: #456557; border: 1rpx solid #dceee3; }
.summary-top,.summary-foot,.section-row,.food-head { display: flex; align-items: center; justify-content: space-between; }
.summary-label { margin-bottom: 8rpx; color: #678979; font-size: 23rpx; }
.summary-num { font-size: 56rpx; font-weight: 600; }
.summary-unit { color: #678979; }
.goal { padding: 10rpx 16rpx; border-radius: 999rpx; background: #fff; font-size: 22rpx; color: #527b66; }
.goal.editable { border: 1rpx solid #d4e8da; background: #fff; }
.goal.editable:active { opacity: .72; }
.goal.editable text { margin-left: 3rpx; color: #638e75; font-size: 22rpx; }
.progress { overflow: hidden; height: 14rpx; margin: 25rpx 0 12rpx; border-radius: 99rpx; background: #dceee2; }
.progress-inner { height: 100%; border-radius: 99rpx; background: #94c4a8; }
.summary-foot { color: #678979; font-size: 22rpx; gap: 16rpx; flex-wrap: wrap; line-height: 1.6; }
.stool-summary { display: flex; align-items: center; padding: 28rpx; background: #fff1e6; }
.stool-score { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 24rpx; color: #fff; background: #65c98a; font-size: 36rpx; font-weight: 600; }
.stool-score.warning { background: #f4a24f; }
.stool-summary-copy { flex: 1; margin-left: 20rpx; }
.stool-summary-copy view { font-weight: 600; }
.stool-summary-copy text { display: block; margin-top: 8rpx; color: #8e847c; font-size: 22rpx; }
.stool-count { display: flex; align-items: baseline; color: #6d635c; }
.stool-count .count-number { font-size: 42rpx; font-weight: 600; }
.stool-count text { margin-left: 5rpx; font-size: 22rpx; }
.section-row { margin-top: 30rpx; gap: 16rpx; flex-wrap: wrap; margin-bottom: 18rpx; }
.filter { color: #978b83; font-size: 23rpx; }
.timeline { margin-top: 2rpx; }
.feed-row { display: grid; grid-template-columns: 90rpx 30rpx 1fr; min-height: 150rpx; }
.time { padding-top: 23rpx; text-align: right; font-size: 24rpx; font-weight: 700; }
.date { display: block; margin-top: 4rpx; color: var(--muted); font-size: 22rpx; font-weight: 400; }
.rail { position: relative; display: flex; justify-content: center; }
.dot { z-index: 1; width: 17rpx; height: 17rpx; margin-top: 32rpx; border: 6rpx solid #ffe3d5; border-radius: 50%; background: #ff7654; }
.stool-dot { border-color: #d9f3e3; background: #63c887; }
.water-dot { border-color: #d8ecf7; background: #57a8d6; }
.walk-dot { border-color: #e5efd8; background: #89b95e; }
.warning-dot { border-color: #ffe6c8; background: #f2a14e; }
.line { position: absolute; top: 52rpx; bottom: -4rpx; width: 2rpx; background: #eadfd8; }
.feed-card { align-self: start; display: flex; align-items: center; margin: 0 0 18rpx 12rpx; padding: 22rpx; }
.food-icon { flex: none; width: 66rpx; height: 66rpx; border-radius: 26rpx; background: #fff1e7; text-align: center; line-height: 66rpx; font-size: 34rpx; display: none; }
.stool-icon { background: #edf9f1; }
.water-icon { background: #e8f4fa; }
.walk-icon { background: #eff6e5; }
.food-copy { flex: 1; margin-left: 0; }
.food-head { font-weight: 600; }
.food-name { margin-top: 6rpx; color: #998f87; font-size: 22rpx; }
.amount { color: #e67b5d; }
.condition { padding: 5rpx 10rpx; border-radius: 99rpx; color: #54a976; background: #eaf8ef; font-size: 22rpx; }
.warning-text { color: #d67b2e; background: #fff0dd; }
.more { padding-left: 12rpx; color: var(--muted); letter-spacing: 2rpx; flex: none; padding: 18rpx 10rpx; min-width: 36rpx; font-size: 30rpx; }
.page { padding-bottom: 150rpx; }
.add-btn { position: fixed; right: 32rpx; bottom: calc(34rpx + env(safe-area-inset-bottom)); z-index: 5; width: auto!important; padding: 0 30rpx; border-radius: 28rpx; color: #643b2d; background: #ffbd9c; font-size: 26rpx; font-weight: 600; }
.add-btn text { font-size: 34rpx; }
.close { color: var(--muted); font-size: 42rpx; font-weight: 400; }
.meal-tabs { display: grid; grid-template-columns: repeat(4,1fr); gap: 12rpx; margin-bottom: 28rpx; }
.meal-tab { padding: 20rpx 0; border: 2rpx solid #f1e5de; border-radius: 26rpx; text-align: center; color: #8f857d; }
.meal-tab.active { border-color: #ff987d; color: var(--orange); background: #fff0e9; font-weight: 600; }
.form-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18rpx; }
.picker { line-height: 84rpx; }
.condition-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin: 12rpx 0 24rpx; }
.condition-option,.color-option { padding: 18rpx 10rpx; border: 2rpx solid #eee3dc; border-radius: 26rpx; text-align: center; color: #8c827b; }
.condition-option.active,.color-option.active { border-color: #ff8e70; color: var(--orange); background: #fff0e9; font-weight: 600; }
.color-list { display: grid; grid-template-columns: repeat(4,1fr); gap: 10rpx; margin: 12rpx 0 24rpx; }
.color-option { font-size: 22rpx; }
.stool-alert { margin-bottom: 22rpx; padding: 18rpx; border-radius: 26rpx; color: #ac662e; background: #fff1df; font-size: 22rpx; line-height: 1.5; }
.feed-trend-card { overflow: hidden; margin-top: 22rpx; padding: 26rpx 22rpx 20rpx; }
.feed-trend-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; flex-wrap: wrap; }
.feed-trend-head>view:first-child { min-width: 0; }
.feed-trend-head>view:first-child>view { font-size: 27rpx; font-weight: 600; }
.feed-trend-head>view:first-child>text { display: block; margin-top: 7rpx; color: var(--muted); font-size: 22rpx; }
.feed-trend-change { flex: none; max-width: 210rpx; padding: 8rpx 12rpx; border-radius: 999rpx; color: #80766f; background: #fff5ef; text-align: center; font-size: 22rpx; line-height: 1.3; }
.feed-trend-change.up { color: #d66645; background: #fff0e8; }
.feed-trend-change.down { color: #4d8b69; background: #eaf7ef; }
.feed-trend-metrics { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 22rpx; padding: 17rpx 4rpx; border-radius: 26rpx; background: #fff8f3; }
.feed-trend-metrics>view { border-right: 1rpx solid #f0e4dc; text-align: center; }
.feed-trend-metrics>view:last-child { border-right: 0; }
.feed-trend-metrics text { font-size: 29rpx; font-weight: 600; }
.feed-trend-metrics view view { margin-top: 4rpx; color: var(--muted); font-size: 22rpx; }
.feed-trend-scroll { width: 100%; margin-top: 20rpx; white-space: nowrap; }
.feed-trend-chart { display: flex; align-items: flex-end; height: 250rpx; }
.feed-trend-column { flex: none; display: flex; flex-direction: column; align-items: center; width: 82rpx; }
.feed-trend-value { height: 34rpx; color: #7f746d; font-size: 20rpx; line-height: 34rpx; }
.feed-trend-bar-track { position: relative; display: flex; align-items: flex-end; justify-content: center; width: 34rpx; height: 132rpx; border-radius: 12rpx 12rpx 5rpx 5rpx; background: #fff5ef; }
.feed-trend-goal { position: absolute; z-index: 1; left: -7rpx; width: 48rpx; border-top: 2rpx dashed #f0a071; }
.feed-trend-bar { z-index: 2; width: 26rpx; border-radius: 9rpx 9rpx 4rpx 4rpx; background: #fff1e6; }
.feed-trend-bar.latest { background: var(--orange); box-shadow: none; }
.feed-trend-column.selected .feed-trend-bar-track { box-shadow: none; }
.feed-trend-column.selected .feed-trend-value,.feed-trend-column.selected .feed-trend-date,.feed-trend-column.selected .feed-trend-count { color: var(--orange); font-weight: 600; }
.feed-trend-date { height: 34rpx; margin-top: 7rpx; color: #857a73; font-size: 20rpx; line-height: 34rpx; }
.feed-trend-count { height: 34rpx; color: var(--muted); font-size: 20rpx; line-height: 34rpx; }
.feed-trend-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; color: #9b9088; font-size: 22rpx; }
.feed-trend-foot>view { display: flex; align-items: center; }
.feed-trend-legend-line { display: inline-block; width: 24rpx; margin-right: 7rpx; border-top: 2rpx dashed #f0a071; }
.feed-trend-card.water .feed-trend-metrics { background: #f2f9fc; }
.feed-trend-card.water .feed-trend-bar { background: #fff1e6; }
.feed-trend-card.water .feed-trend-bar.latest { background: #fff1e6; box-shadow: none; }
.feed-trend-card.water .feed-trend-goal,.feed-trend-card.water .feed-trend-legend-line { border-color: #6ab9dc; }
.feed-trend-card.water .feed-trend-column.selected .feed-trend-bar-track { box-shadow: none; }
.feed-trend-card.water .feed-trend-column.selected .feed-trend-value,.feed-trend-card.water .feed-trend-column.selected .feed-trend-date,.feed-trend-card.water .feed-trend-column.selected .feed-trend-count { color: #318db9; }
.feed-trend-card.stool .feed-trend-metrics { background: #f2faf5; }
.feed-trend-card.stool .feed-trend-bar { background: #fff1e6; }
.feed-trend-card.stool .feed-trend-bar.latest { background: #fff1e6; box-shadow: none; }
.feed-trend-card.stool .feed-trend-bar.warning { background: #fff1e6; }
.feed-trend-card.stool .feed-trend-goal,.feed-trend-card.stool .feed-trend-legend-line { border-color: #6fbd89; }
.feed-trend-card.stool .feed-trend-column.selected .feed-trend-bar-track { box-shadow: none; }
.feed-trend-card.stool .feed-trend-column.selected .feed-trend-value,.feed-trend-card.stool .feed-trend-column.selected .feed-trend-date,.feed-trend-card.stool .feed-trend-column.selected .feed-trend-count { color: #449c64; }
.feed-trend-card.walk .feed-trend-metrics { background: #f5f9ef; }
.feed-trend-card.walk .feed-trend-bar { background: #fff1e6; }
.feed-trend-card.walk .feed-trend-bar.latest { background: #fff1e6; box-shadow: none; }
.feed-trend-card.walk .feed-trend-goal,.feed-trend-card.walk .feed-trend-legend-line { border-color: #91b96a; }
.feed-trend-card.walk .feed-trend-column.selected .feed-trend-bar-track { box-shadow: none; }
.feed-trend-card.walk .feed-trend-column.selected .feed-trend-value,.feed-trend-card.walk .feed-trend-column.selected .feed-trend-date,.feed-trend-card.walk .feed-trend-column.selected .feed-trend-count { color: #6e9c3f; }
.goal-sheet { padding-bottom: calc(42rpx + env(safe-area-inset-bottom)); }
.goal-editor-copy { margin: -5rpx 0 24rpx; color: #81766f; font-size: 22rpx; line-height: 1.55; }
.goal-editor-field { display: flex; align-items: center; padding: 20rpx 24rpx; border: 2rpx solid #f0dfd5; border-radius: 24rpx; background: #fffaf6; }
.goal-editor-field input { min-width: 0; height: 72rpx; flex: 1; color: #3f3732; font-size: 42rpx; font-weight: 600; }
.goal-editor-field>text { flex: none; margin-left: 16rpx; color: #8d8179; font-size: 23rpx; font-weight: 700; }
.goal-editor-tip { margin: 16rpx 3rpx 26rpx; color: #a0958d; font-size: 22rpx; line-height: 1.5; }
.record-date-field { display: flex; justify-content: space-between; padding: 20rpx; margin-bottom: 20rpx; border-radius: 16rpx; background: #fff5ec; font-size: 25rpx; }
.feed-card .more { font-size: 22rpx; padding: 12rpx; }
.page { scrollbar-width: none; }
.page::-webkit-scrollbar { display: none; width: 0; height: 0; }
.record-author { margin-top: 7rpx; color: #a38f82; font-size: 22rpx; line-height: 1.35; }
.record-filters { display: flex; gap: 14rpx; margin: 4rpx 0 18rpx; margin-bottom: 18rpx; }
.record-filters input,.record-filters picker { box-sizing: border-box; height: 66rpx; border: 1rpx solid #eee1d8; border-radius: 16rpx; background: #fff; color: #786c64; font-size: 22rpx; line-height: 66rpx; }
.record-filters input { min-width: 0; flex: 1; padding: 0 16rpx; height: 80rpx; font-size: 25rpx; }
.record-filters picker { flex: none; padding: 0 14rpx; }
.trend-range { display: flex; justify-content: flex-end; gap: 8rpx; margin-bottom: 14rpx; }
.trend-range-item { padding: 7rpx 12rpx; border-radius: 99rpx; color: #978b83; background: #f6f0eb; font-size: 22rpx; }
.trend-range-item.active { color: #fff; background: #ef835c; font-weight: 600; }
.select-records { margin-left: 14rpx; color: #d16d4e; font-size: 22rpx; }
.record-select { display: flex; align-items: center; justify-content: center; flex: none; width: 34rpx; height: 34rpx; margin-right: 12rpx; border: 2rpx solid #d6c8be; border-radius: 10rpx; color: #fff; font-size: 22rpx; }
.record-select.selected { border-color: #ef835c; background: #ef835c; }
.batch-delete { display: block; margin: 20rpx auto 0; color: #b65143; background: #fff0ea; }
.readonly-hint { position: fixed; right: 32rpx; bottom: calc(38rpx + env(safe-area-inset-bottom)); z-index: 5; padding: 18rpx 22rpx; border-radius: 999rpx; color: #806f65; background: #fff7f1; box-shadow: none; font-size: 22rpx; }
.feed-trend-head { flex-wrap: wrap; }
.feed-trend-change.insufficient { flex-basis: 100%; max-width: none; box-sizing: border-box; border-radius: 14rpx; text-align: left; font-size: 22rpx; line-height: 1.6; }
.page { background: var(--cream); }
.record-tabs { background: #fff1e9; }
.record-tab.active { background: #fff; color: var(--orange); box-shadow: none; }
.summary.card,.feed-trend-card.card { border-color: var(--line); border-radius: 26rpx; box-shadow: none; }
.food-name { font-weight: 600; }
.add-btn { background: #ffbd9c; box-shadow: none; border-radius: 28rpx; color: #643b2d; }
.section-row { margin-top: 30rpx; gap: 16rpx; flex-wrap: wrap; margin-bottom: 18rpx; }
.feed-card { box-shadow: none; border-color: var(--line); }
.summary { background: #edf8f2; color: #456557; border: 1rpx solid #dceee3; }
.summary-label,.summary-unit { color: #678979; }
.progress-inner { background: #94c4a8; }
.stool-summary { background: #fff; }
.feed-trend-bar { background: #eba184; }
.feed-trend-card.water .feed-trend-bar { background: #9ccad4; }
.feed-trend-card.stool .feed-trend-bar { background: #a1c8b5; }
.feed-trend-card.stool .feed-trend-bar.warning { background: #bc8058; }
.feed-trend-card.walk .feed-trend-bar { background: #a1c8af; }
.section-row .section-title { margin: 0; font-size: 30rpx; }
.record-toolbar { display: flex; align-items: center; gap: 12rpx; color: var(--muted); font-size: 23rpx; }
.record-toolbar button { width: auto!important; margin: 0; padding: 14rpx 16rpx; border-radius: 14rpx; background: #fff1e9; color: #906b59; font-size: 24rpx; line-height: 1.5; }
.filter-state { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 20rpx; color: var(--muted); font-size: 23rpx; line-height: 1.6; }
.filter-state>text { flex: 1; }
.filter-state button { flex: none; width: auto!important; margin: 0; padding: 12rpx; color: var(--orange); background: transparent; font-size: 23rpx; line-height: 1.5; }
.batch-delete[disabled] { color: #8b8178; background: #f7efe9; }
.sheet { max-height: 88vh; overflow-y: auto; }
.form-grid .field { min-width: 0; }
.meal-tab.active,.condition-option.active,.color-option.active { border-color: var(--orange); color: #875238; background: var(--orange-soft); }
.summary-top { gap: 18rpx; flex-wrap: wrap; }
@media(max-width:360px) {
  .form-grid { grid-template-columns: 1fr; }
  .meal-tabs,.color-list { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .feed-row { grid-template-columns: 78rpx 22rpx minmax(0,1fr); }
  .feed-card { padding: 20rpx 16rpx; }
  .feed-trend-metrics view view { line-height: 1.5; }
}

.reply-card{background:#f0f6ef;border-radius:16rpx;padding:20rpx;margin-top:20rpx}.reply-heading{font-size:24rpx;font-weight:600;color:#52785e}.reply-card .message{margin:12rpx 0}.reply-pending{margin-top:16rpx}

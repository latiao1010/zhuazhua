page{background:#fafcf9;color:#344b3e}.feedback-page{padding:32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));max-width:900rpx;margin:auto}.feedback-heading{font-size:40rpx;font-weight:600;margin-bottom:10rpx}.muted{color:#7d8e81;font-size:23rpx;line-height:1.7}.feedback-card{background:#fff;border:1rpx solid #e1eae2;border-radius:24rpx;padding:26rpx;margin-top:24rpx}.debug-note{font-size:23rpx;background:#fff4e9;color:#a27959;padding:18rpx;border-radius:16rpx;margin-top:20rpx}.pickers{display:flex;gap:20rpx}.pickers picker{flex:1;min-width:0}.pickers picker>view>text{color:#7d8e81;font-size:23rpx}.pickers picker>view>view{padding:18rpx 0;font-size:27rpx}.pickers picker>view>view>text{float:right;color:#9aaa9e}textarea{width:100%;height:250rpx;box-sizing:border-box;padding:22rpx;background:#f6f9f5;border-radius:16rpx;font-size:27rpx;line-height:1.6;margin-top:10rpx}.count{text-align:right;color:#91a094;font-size:21rpx;margin:8rpx 0 18rpx}.feedback-page button{width:100%;box-sizing:border-box}.feedback-page button::after{border:0}.primary{margin-top:24rpx;background:#52785e;color:white;font-size:29rpx;border-radius:18rpx;line-height:2.7}.section-heading{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:600}.feedback-page .text-button{padding:0;background:transparent;font-size:24rpx;line-height:1.8;color:#63846a;margin:0;width:auto}.row-heading{display:flex;justify-content:space-between;gap:12rpx;font-size:24rpx}.status{color:#708f74;flex:none}.feedback-row{padding:22rpx 0;border-top:1rpx solid #edf2ec;margin-top:14rpx}.message{display:block;white-space:pre-wrap;overflow-wrap:anywhere;font-size:26rpx;line-height:1.6;margin:14rpx 0}.error{color:#b96e55!important;font-size:24rpx;margin-top:18rpx}.empty{padding:20rpx 0}.setting{display:flex;align-items:center;justify-content:space-between;font-size:26rpx;margin:24rpx 0 8rpx}.privacy .section-heading{width:100%;text-align:left;font-size:26rpx}.privacy .muted{margin-top:16rpx}.feedback-page .admin-entry{margin:28rpx auto 0}

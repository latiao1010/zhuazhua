/* 数据页共用浅绿操作色，导出与摘要保持明确的主次层级。 */
.manage-page { padding:28rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); background:var(--cream); min-height:100vh; box-sizing:border-box; }
.section { padding:28rpx; margin-bottom:20rpx; border:1rpx solid var(--line); border-radius:26rpx; background:#fff; }
.title { font-size:30rpx; font-weight:600; margin-bottom:16rpx; color:var(--ink); }
.hint { font-size:24rpx; color:var(--muted); line-height:1.7; word-break:break-word; }
button { color:var(--brand); background:var(--brand-soft); font-size:25rpx; border-radius:20rpx; }
.load-more { display:block; margin:18rpx auto 0; padding:12rpx 28rpx; border:1rpx solid var(--line); background:#fff; color:var(--brand); font-size:24rpx; line-height:1.5; }
.visit-heading { display:flex; align-items:center; gap:18rpx; }
.visit-heading .title { margin:0 0 5rpx; font-size:32rpx; }
.visit-subtitle,.visit-description { color:var(--muted); font-size:24rpx; line-height:1.65; }
.visit-description { margin:22rpx 0 26rpx; }
.visit-mark { display:flex; flex-direction:column; justify-content:center; gap:7rpx; flex:none; width:64rpx; height:70rpx; padding:16rpx; border:1rpx solid #dae8dd; border-radius:18rpx; background:var(--brand-soft); box-sizing:border-box; }
.visit-mark view { height:3rpx; border-radius:3rpx; background:#8caf96; }
.visit-mark view:last-child { width:60%; }
.date-range-label { margin-bottom:14rpx; color:var(--ink); font-size:25rpx; font-weight:500; }
.visit-range-presets { display:flex; gap:12rpx; margin-bottom:16rpx; }
.visit-range-presets button { flex:1; margin:0; padding:16rpx 8rpx; border:1rpx solid var(--line); border-radius:16rpx; color:var(--muted); background:var(--cream); font-size:24rpx; line-height:1.4; font-weight:400; }
.visit-range-presets button.selected { color:var(--brand); background:var(--brand-soft); border-color:#aac5b2; font-weight:500; }
.visit-date-range { display:flex; align-items:center; gap:12rpx; }
.visit-date-range picker { flex:1; min-width:0; }
.visit-date { padding:18rpx 16rpx; border:1rpx solid var(--line); border-radius:20rpx; background:var(--cream); }
.date-caption { display:block; margin-bottom:8rpx; color:var(--muted); font-size:22rpx; }
.visit-date>view { display:flex; align-items:center; justify-content:space-between; gap:6rpx; color:var(--ink); font-size:25rpx; font-weight:500; font-variant-numeric:tabular-nums; white-space:nowrap; }
.visit-date>view text { color:#8ca394; font-size:23rpx; }
.date-connector { flex:none; color:#aab9ae; font-size:22rpx; }
.visit-record-count { margin-top:16rpx; color:var(--muted); font-size:23rpx; line-height:1.6; }
.visit-record-count.empty { color:#a45640; }
.visit-privacy { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin:24rpx 0; padding:6rpx 0; }
.visit-privacy>view { min-width:0; }
.visit-privacy>view>view { color:var(--ink); font-size:26rpx; font-weight:500; }
.visit-privacy>view>text { display:block; margin-top:6rpx; color:var(--muted); font-size:22rpx; line-height:1.6; }
.visit-privacy switch { flex:none; transform:scale(.84); transform-origin:right center; }
.visit-generate,.visit-export { display:flex; align-items:center; justify-content:center; gap:18rpx; width:100%!important; height:88rpx; margin:0; padding:0 24rpx; border-radius:26rpx; font-size:28rpx; font-weight:500; line-height:1.3; box-sizing:border-box; }
.visit-generate { color:#fff; background:var(--brand); }
.visit-generate text { font-size:30rpx; font-weight:400; }
.visit-export { margin-top:20rpx; border:1rpx solid #dce8df; color:var(--brand); background:var(--brand-soft); }
.visit-export[disabled] { color:#87988b; background:#e8eee8; }
.visit-pressed { opacity:.8; }
.visit-preview-title { display:flex; justify-content:space-between; gap:12rpx; margin-top:28rpx; color:var(--ink); font-size:25rpx; font-weight:500; }
.visit-preview-title text { color:var(--muted); font-size:22rpx; font-weight:400; }
.summary-header { margin:16rpx 0; padding:20rpx; border-radius:16rpx; background:var(--brand-soft); color:#526458; font-size:24rpx; line-height:1.75; white-space:pre-wrap; word-break:break-word; }
.summary-module { margin-top:12rpx; border:1rpx solid var(--line); border-radius:20rpx; overflow:hidden; }
.summary-module-heading { display:flex; justify-content:space-between; align-items:center; gap:12rpx; width:100%!important; margin:0; padding:22rpx 18rpx; border-radius:0; background:var(--cream); color:var(--ink); font-size:25rpx; line-height:1.5; text-align:left; }
.summary-module-heading>text:last-child { flex:none; color:var(--muted); font-size:22rpx; font-weight:400; }
.summary-module-content { padding:0 18rpx 18rpx; }
.summary-record { padding:18rpx 0; border-bottom:1rpx solid var(--line); color:var(--ink); font-size:24rpx; line-height:1.75; white-space:pre-wrap; word-break:break-word; }
.summary-module-content>.hint { padding-top:18rpx; }
.visit-share { display:flex; gap:14rpx; margin-top:14rpx; }
.visit-share button { flex:1; margin:0; padding:16rpx; font-size:24rpx; line-height:1.5; }
.shared-preview { border-color:#dce8df; }
.remote-change { display:flex; align-items:flex-start; padding:18rpx 0; border-bottom:1rpx solid var(--line); }
.change-check { display:flex; align-items:center; justify-content:center; flex:none; width:34rpx; height:34rpx; margin:3rpx 14rpx 0 0; border:2rpx solid #c6d8cb; border-radius:10rpx; color:#fff; font-size:20rpx; }
.remote-change.selected .change-check { border-color:var(--brand); background:var(--brand); }
.change-main { min-width:0; flex:1; }
.change-main>text { font-size:25rpx; font-weight:500; }
.change-main>view { margin-top:4rpx; color:var(--muted); font-size:23rpx; }
.remote-change>text { margin-left:16rpx; color:var(--muted); font-size:21rpx; text-align:right; }
.change-compare { display:flex; flex-direction:column; gap:6rpx; padding:12rpx; margin-top:10rpx!important; border-radius:12rpx; background:var(--cream); }
.change-compare text { color:var(--muted); font-size:22rpx; line-height:1.6; }
.apply-selected { margin-top:18rpx; color:#fff; background:var(--brand); }
@media(max-width:360px) {
  .manage-page { padding-left:24rpx; padding-right:24rpx; }
  .section { padding:22rpx; }
  .visit-date { padding:16rpx 12rpx; }
  .visit-date>view { font-size:23rpx; }
  .visit-date-range { gap:8rpx; }
}

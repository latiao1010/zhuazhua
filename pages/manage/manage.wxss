.manage-page{padding:24rpx;background:#faf7f3;min-height:100vh;box-sizing:border-box}.section{padding:24rpx;margin-bottom:20rpx;border-radius:24rpx;background:#fff;border:1rpx solid #eee3d9}.title{font-size:29rpx;font-weight:700;margin-bottom:16rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:18rpx 0;font-size:24rpx}.row>view{min-width:0;flex:1}.hint{font-size:21rpx;color:#8c7d71;line-height:1.6;word-break:break-all}button{background:#fff0e4;color:#965b37;font-size:25rpx;border-radius:16rpx}.row button{margin:0;flex:none}
.conflict-tip{margin-top:14rpx;padding:16rpx;border-radius:16rpx;color:#a5573c;background:#fff0e8;font-size:21rpx;line-height:1.55}
.conflict-tip button{margin:14rpx 0 0;background:#fff;color:#a5573c}
.load-more{display:block;margin:18rpx auto 0;padding:0 28rpx;background:#fff;color:#965b37;border:1rpx solid #eed9ca}
.visit-section{padding:30rpx;border-color:#efded1;box-shadow:0 10rpx 30rpx rgba(108,76,53,.035);background:linear-gradient(155deg,#fffaf5 0,#fff 36%)}
.visit-heading{display:flex;align-items:center;gap:18rpx}.visit-heading .title{margin:0 0 5rpx;color:#45382f;font-size:31rpx}.visit-subtitle{color:#a28a78;font-size:21rpx}
.visit-mark{display:flex;flex-direction:column;justify-content:center;gap:7rpx;box-sizing:border-box;width:64rpx;height:70rpx;padding:16rpx;border:1rpx solid #f1d6c1;border-radius:16rpx;background:#fff0e3;flex:none}.visit-mark view{height:3rpx;border-radius:3rpx;background:#d4976b}.visit-mark view:last-child{width:60%}
.visit-description{margin:22rpx 0 26rpx;color:#8c7d71;font-size:22rpx;line-height:1.65}.date-range-label{margin-bottom:12rpx;color:#766051;font-size:22rpx;font-weight:600}
.visit-date-range{display:flex;align-items:center;gap:12rpx}.visit-date-range picker{flex:1;min-width:0}.visit-date{padding:18rpx 16rpx;border:1rpx solid #eee3d9;border-radius:18rpx;background:#faf7f3}.date-caption{display:block;margin-bottom:8rpx;color:#a28f80;font-size:19rpx}.visit-date>view{display:flex;align-items:center;justify-content:space-between;gap:6rpx;color:#514338;font-size:25rpx;font-weight:600;white-space:nowrap}.visit-date>view text{color:#b2937c;font-size:23rpx}.date-connector{flex:none;color:#c9b5a4;font-size:22rpx}
.visit-privacy{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:24rpx 0;padding:6rpx 0}.visit-privacy>view{min-width:0}.visit-privacy>view>view{color:#5e4e43;font-size:24rpx;font-weight:500}.visit-privacy>view>text{display:block;margin-top:6rpx;color:#a08e80;font-size:19rpx;line-height:1.5}.visit-privacy switch{flex:none;transform:scale(.84);transform-origin:right center}
.visit-section button::after{border:0}.visit-section .visit-generate{display:flex;align-items:center;justify-content:center;gap:18rpx;width:100%;height:84rpx;margin:0;padding:0 24rpx;border-radius:20rpx;color:#fff;background:linear-gradient(110deg,#f29a70,#eb8059);box-shadow:0 8rpx 18rpx rgba(229,126,83,.18);font-size:27rpx;font-weight:600;line-height:1.3}.visit-generate text{font-size:30rpx;font-weight:400}.visit-pressed{opacity:.85}
.visit-preview-title{display:flex;justify-content:space-between;margin-top:28rpx;color:#725541;font-size:23rpx;font-weight:600}.visit-preview-title text{color:#a39183;font-size:19rpx;font-weight:400}.visit-share{display:flex;gap:14rpx;margin-top:14rpx}.visit-share button{flex:1;margin:0;font-size:23rpx;line-height:2.6}
@media(max-width:360px){.visit-section{padding:24rpx}.visit-date{padding:16rpx 12rpx}.visit-date>view{font-size:23rpx}.visit-date-range{gap:8rpx}}
.shared-preview{border-color:#f0cdbd;background:#fffaf7}.remote-change{display:flex;align-items:flex-start;padding:16rpx 0;border-bottom:1rpx solid #f0e7e1}.change-check{display:flex;align-items:center;justify-content:center;flex:none;width:34rpx;height:34rpx;margin:3rpx 14rpx 0 0;border:2rpx solid #d8c5ba;border-radius:10rpx;color:#fff;font-size:20rpx}.remote-change.selected .change-check{border-color:#ef835c;background:#ef835c}.change-main{min-width:0;flex:1}.change-main>text{font-size:22rpx;font-weight:800}.change-main>view{margin-top:4rpx;color:#765f52;font-size:20rpx}.remote-change>text{margin-left:16rpx;color:#a18f84;font-size:16rpx;text-align:right}.change-compare{display:flex;gap:6rpx;flex-direction:column;padding:10rpx;margin-top:9rpx!important;border-radius:12rpx;background:#fff}.change-compare text{color:#8b786d;font-size:17rpx;line-height:1.4}.apply-selected{margin-top:18rpx;color:#fff;background:#ef835c}

.visit-section .visit-export{width:100%;height:80rpx;margin:24rpx 0 0;padding:0 24rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #efd6c3;border-radius:20rpx;background:#fff3e9;color:#985c38;font-size:27rpx;font-weight:600;line-height:1.3}.visit-section .visit-export[disabled]{opacity:.6}

.visit-range-presets{display:flex;gap:12rpx;margin-bottom:16rpx}.visit-range-presets button{flex:1;margin:0;padding:14rpx 8rpx;border-radius:14rpx;background:#f7f3ef;color:#8c7d71;font-size:22rpx;line-height:1.4;font-weight:400}.visit-range-presets button.selected{background:#ffeadb;color:#a65d35;font-weight:600}.visit-record-count{margin-top:16rpx;font-size:21rpx;color:#947d6d;line-height:1.5}.visit-record-count.empty{color:#a76b4c}

.summary-header{margin:16rpx 0;padding:20rpx;border-radius:16rpx;background:#faf7f3;color:#897362;font-size:22rpx;line-height:1.7;white-space:pre-wrap;word-break:break-all}.summary-module{margin-top:12rpx;border:1rpx solid #eee3d9;border-radius:18rpx;overflow:hidden}.visit-section .summary-module-heading{display:flex;justify-content:space-between;align-items:center;gap:12rpx;width:100%;margin:0;padding:22rpx 18rpx;background:#fffaf5;border-radius:0;font-size:24rpx;line-height:1.5;text-align:left}.summary-module-heading>text:last-child{color:#a08b7b;font-size:21rpx;font-weight:400}.summary-module-content{padding:0 18rpx 18rpx}.summary-record{padding:18rpx 0;border-bottom:1rpx solid #f3ece6;font-size:22rpx;line-height:1.7;white-space:pre-wrap;word-break:break-all}.summary-module-content>.hint{padding-top:18rpx}

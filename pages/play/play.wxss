@import "../../styles/bingo.wxss";
.play-page{padding:30rpx 30rpx calc(48rpx + env(safe-area-inset-bottom))}.play-hero{position:relative;padding:20rpx 0 32rpx}.play-hero .eyebrow{letter-spacing:1rpx;color:#b87959}.play-hero .page-title{margin-top:18rpx;font-size:44rpx;line-height:1.45;white-space:pre-line;padding-right:75rpx}.play-icon{position:absolute;right:0;top:24rpx;display:flex;align-items:center;justify-content:center;width:80rpx;height:80rpx;border-radius:28rpx;background:#ffece0}.play-sub{margin-top:18rpx;font-size:25rpx;color:var(--muted);line-height:1.75}.play-form{padding:28rpx}.species-tabs{display:flex;gap:16rpx;margin:16rpx 0 28rpx}.species-tabs button{flex:1;width:auto!important;margin:0;padding:18rpx;border:1rpx solid var(--line);border-radius:20rpx;font-size:28rpx;line-height:1.5;background:#fffaf7;color:#8b7468}.species-tabs button.active{border-color:#e5a286;background:#ffeada;color:#84513c;font-weight:600}.play-picker{display:flex;align-items:center;justify-content:space-between;font-size:26rpx;gap:12rpx}.play-picker>text{color:#bda493;font-size:30rpx}.field-note{margin-top:10rpx;color:#99867a;font-size:22rpx;line-height:1.6}.field-label-row{display:flex;justify-content:space-between;gap:16rpx}.field-label-row>text:last-child:not(:first-child){font-size:23rpx;color:#b67858}.form-error{padding:18rpx 0;color:#ae503e;font-size:25rpx;line-height:1.6}.play-note{margin:24rpx 6rpx;color:var(--muted);font-size:23rpx;line-height:1.75}.quiz-top{display:flex;justify-content:space-between;margin:16rpx 0 20rpx;font-size:26rpx;color:#927b6e}.quiz-progress{height:10rpx;background:#f4e7df;border-radius:10rpx;overflow:hidden}.quiz-progress>view{height:100%;background:#e8a889;border-radius:10rpx;transition:width .2s}.quiz-restored{margin-top:16rpx;color:#709581;font-size:23rpx}.quiz-card{margin-top:30rpx;padding:32rpx 26rpx}.quiz-caption{color:#b5876c;font-size:23rpx}.quiz-title{margin:18rpx 0 30rpx;font-size:36rpx;font-weight:600;line-height:1.6}.quiz-options{display:flex;flex-direction:column;gap:18rpx}.quiz-option{display:flex;align-items:center;gap:20rpx;width:100%!important;margin:0;padding:25rpx 20rpx;box-sizing:border-box;background:#fffaf7;border:1rpx solid var(--line);border-radius:22rpx;text-align:left;font-size:28rpx;line-height:1.6;color:var(--ink)}.quiz-option.selected{background:#fff0e4;border-color:#e6a888}.option-marker{width:34rpx;height:34rpx;flex:none;display:flex;align-items:center;justify-content:center;border:2rpx solid #dfcfc3;border-radius:50%;font-size:24rpx;color:#b97150}.selected .option-marker{background:#ffe1ca;border-color:#daa080}.quiz-actions{display:flex;gap:16rpx;margin-top:28rpx}.quiz-actions button{flex:1;min-width:0;margin:0}.quiz-footer{display:flex;flex-direction:column;align-items:center;gap:24rpx;margin-top:28rpx;font-size:23rpx;color:var(--muted);line-height:1.6}.quiz-footer>text:last-child{padding:12rpx;color:#ac795c}

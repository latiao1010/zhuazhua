@import "../../styles/bingo.wxss";
.result-page{padding:28rpx 28rpx calc(50rpx + env(safe-area-inset-bottom))}.result-caption{margin:10rpx 0 26rpx;text-align:center;color:#a18b7b;font-size:24rpx;line-height:1.6}.result-card{padding:28rpx;border:1rpx solid #f6dfcd;border-radius:34rpx;background:#fffdf9;text-align:center;box-shadow:0 12rpx 40rpx rgba(205,143,103,.06)}.result-card.personality{border-color:#dfeddf;background:#fdfffb}.result-brand{text-align:left;color:#b79a85;letter-spacing:1rpx;font-size:21rpx}.pet-portrait{position:relative;width:160rpx;height:160rpx;margin:32rpx auto 26rpx;border-radius:50%;background:#fff1df}.pet-face{position:absolute;left:25rpx;top:35rpx;width:110rpx;height:100rpx;background:#ffe0b6;border-radius:48rpx 48rpx 42rpx 42rpx}.pet-ear{position:absolute;top:28rpx;width:38rpx;height:102rpx;border-radius:50%;background:#edc3a1}.pet-ear.left{left:14rpx;transform:rotate(14deg)}.pet-ear.right{right:14rpx;transform:rotate(-14deg)}.cat .pet-ear{top:12rpx;width:52rpx;height:72rpx;border-radius:10rpx 80% 0 0}.cat .pet-ear.left{left:23rpx;transform:rotate(-15deg)}.cat .pet-ear.right{right:23rpx;transform:rotate(15deg) scaleX(-1)}.pet-eye{position:absolute;top:34rpx;width:10rpx;height:12rpx;background:#63473a;border-radius:50%;z-index:2}.pet-eye.left{left:27rpx}.pet-eye.right{right:27rpx}.pet-muzzle{position:absolute;left:20rpx;bottom:5rpx;width:70rpx;height:47rpx;border-radius:50%;background:#fff7ec}.pet-nose{position:absolute;left:28rpx;top:8rpx;width:14rpx;height:10rpx;border-radius:4rpx 4rpx 9rpx 9rpx;background:#815e48}.pet-mouth{position:absolute;left:27rpx;top:24rpx;width:16rpx;height:7rpx;border-radius:0 0 50% 50%;border-bottom:2rpx solid #ac8066}.pet-cheek{position:absolute;top:54rpx;width:17rpx;height:9rpx;background:#f6bba0;border-radius:50%;z-index:2}.pet-cheek.left{left:7rpx}.pet-cheek.right{right:7rpx}.result-name{font-size:36rpx;font-weight:600;word-break:break-all}.result-age{margin-top:14rpx;color:#9b8170;font-size:26rpx}.human-label{margin-top:28rpx;color:#b0866d;font-size:24rpx}.human-age{font-size:100rpx;line-height:1.3;font-weight:600;color:#ce7b56}.human-age text{font-size:28rpx;font-weight:400;margin-left:10rpx}.out-of-range{margin:24rpx 0;font-size:35rpx;color:#bd815b}.together-panel{margin:18rpx 0;padding:24rpx;border-radius:24rpx;background:#fff1e6;color:#8c654b;font-size:27rpx}.together-panel>view>text{font-weight:600;font-size:34rpx}.together-panel>text{display:block;margin-top:10rpx;font-size:23rpx;color:#aa8b76}.birthday-count{margin:24rpx 0;color:#98765c;font-size:26rpx}.result-quote{margin:28rpx 0 18rpx;color:#b58d71;font-size:25rpx;line-height:1.7}.result-date{font-size:20rpx;color:#b9a797}.personality-title{margin:20rpx 0 12rpx;font-size:43rpx;font-weight:600;color:#6e937b}.personality-tag{font-size:23rpx;color:#8d9c88;line-height:1.6}.personality-metrics{margin:32rpx 0}.personality-metrics>view{display:flex;align-items:center;gap:18rpx;margin-top:22rpx;font-size:24rpx;color:#8c8070}.personality-metrics>view>text:first-child{width:108rpx;flex:none}.personality-metrics>view>text:last-child{width:65rpx;text-align:right;color:#729579;font-weight:600}.metric-track{flex:1;height:13rpx;overflow:hidden;background:#edf3e8;border-radius:9rpx}.metric-track>view{height:100%;border-radius:9rpx;background:#adcaae}.result-note{margin:24rpx 6rpx;font-size:23rpx;color:var(--muted);line-height:1.8}.result-note>view{margin-top:12rpx}.result-actions{display:flex;flex-direction:column;gap:16rpx}.result-actions button{margin:0}.poster-status{margin:20rpx 4rpx;font-size:23rpx;color:#a3846d;line-height:1.7}.poster-status>text{display:block;margin-top:10rpx;padding:8rpx 0;color:#b47550}.poster-status.error{color:#b3654d}.poster-preview{margin-top:30rpx;padding:24rpx;border:1rpx solid var(--line);border-radius:24rpx;background:#fff}.poster-preview>view{display:flex;justify-content:space-between;gap:16rpx;font-size:25rpx}.poster-preview>view>text{color:#aa8064;font-size:23rpx}.poster-preview image{display:block;width:100%;margin:22rpx 0;border-radius:18rpx}.try-again{margin:28rpx auto 0;width:100%!important;background:transparent;color:#a6795b;font-size:26rpx;line-height:1.6;padding:18rpx}.share-canvas{position:fixed;left:-2000px;top:0;width:600px;height:880px;pointer-events:none}.empty .primary-btn{margin-top:24rpx}
.custom-pet-photo{display:block;width:160rpx;height:160rpx;border-radius:50%;margin:32rpx auto 26rpx;background:#fff1df}.photo-editor{margin:24rpx 0;padding:24rpx;border-radius:24rpx;background:#fff;border:1rpx solid var(--line)}.photo-editor>text{display:block;font-size:22rpx;color:var(--muted);line-height:1.7;margin-top:14rpx}.photo-editor button{margin:0}.photo-editor .photo-remove{margin-top:14rpx;background:transparent;font-size:24rpx;color:#9a8375;line-height:1.6;padding:14rpx}

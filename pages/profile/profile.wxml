<view class="page journal-home {{largeText ? 'home-large-text' : ''}}">
  <view class="home-header">
    <view class="home-topline">
      <text>{{homeDashboard.greeting}} · {{homeDashboard.dateLabel}}</text>
      <view class="home-badges">
        <button class="home-button home-notice" wx:if="{{syncLabel || !pet.weight || !pet.birthday}}" bindtap="goAccount" aria-label="{{syncLabel || '完善体重与生日'}}">{{syncLabel ? '同步待处理' : '完善资料'}} ›</button>
        <text class="demo-badge" wx:if="{{demoMode}}">演示数据</text>
        <text class="demo-badge shared-badge" wx:elif="{{readOnly}}">只读共享</text>
      </view>
    </view>
    <view class="home-pet-head">
      <button class="home-button pet-avatar" bindtap="goAccount" aria-label="查看宠物档案" hover-class="home-pressed"><image src="{{pet.avatar}}" mode="aspectFill" /></button>
      <view class="home-pet-copy">
        <view class="home-title">{{pet.name}}<text>的日常</text></view>
        <view class="home-pet-meta">
          <button class="home-button" bindtap="openWeightTrend" hover-class="home-pressed">{{pet.weight ? pet.weight + ' kg' : '完善体重'}} <text>›</text></button>
          <text class="meta-dot">·</text>
          <button class="home-button" bindtap="openFestivals" hover-class="home-pressed">{{pet.togetherSince ? '相伴 ' + daysTogether + ' 天' : '记录相伴日期'}} <text>›</text></button>
        </view>
      </view>
    </view>
  </view>

  <view class="home-weather {{weather.status === 'privacy' ? 'weather-needs-privacy' : ''}}">
    <view class="weather-top">
      <view class="weather-place">{{weather.live ? weather.location : '本地天气'}}</view>
      <view class="weather-current" wx:if="{{weather.live}}"><text>{{weather.icon}}</text><text>{{weather.temperature}}°</text><text>{{weather.condition}}</text></view>
      <text class="weather-status" wx:else>{{weatherLoading ? '正在定位天气…' : weather.status === 'privacy' || weather.status === 'denied' ? '需要位置授权' : '暂不可用'}}</text>
      <button class="home-button weather-refresh" wx:if="{{weather.status === 'privacy'}}" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onWeatherPrivacyAgreed">开启天气</button>
      <button class="home-button weather-refresh" wx:elif="{{weather.status === 'denied'}}" open-type="openSetting" bindopensetting="onWeatherSettings">去授权</button>
      <button class="home-button weather-refresh" wx:else bindtap="refreshWeather" disabled="{{weatherLoading}}" aria-label="重新定位并刷新天气">{{weatherLoading ? '更新中' : weather.live ? '刷新' : '重试'}}</button>
    </view>
    <button class="home-button weather-forecast" bindtap="openWeatherDetails" disabled="{{weatherLoading}}" aria-label="{{weather.rainText + '，' + homeDashboard.weatherTip + '，点击查看天气详情'}}"><text>{{weatherLoading ? '正在获取当前位置天气…' : weather.rainText + (homeDashboard.weatherTip ? '；' + homeDashboard.weatherTip : '')}}</text><text>›</text></button>
    <button class="home-button weather-privacy" wx:if="{{weather.status === 'privacy'}}" bindtap="openWeatherPrivacy" aria-label="大致位置用于 Open-Meteo 天气查询和 BigDataCloud 城市识别，查看隐私保护指引">大致位置用于天气与城市识别 · 隐私说明 ›</button>
    <button class="home-button weather-source" wx:if="{{weather.live}}" bindtap="copyWeatherSources">体感 {{weather.apparent}}° · {{weather.updatedLabel}} 更新 · Open-Meteo</button>
  </view>

  <view class="home-discovery">
    <view class="home-section-head discovery-heading"><view>一起发现</view><text>左右滑动</text></view>
    <swiper class="discovery-swiper" current="{{discoveryIndex}}" bindchange="onDiscoveryChange" autoplay="{{false}}" circular="{{true}}" duration="250" indicator-dots="{{true}}" indicator-color="#DCE6DD" indicator-active-color="#8CAD96" aria-label="一起发现，左右滑动切换功能">
      <swiper-item wx:for="{{discoverySlides}}" wx:key="tool">
        <button class="home-button discovery-panel discovery-panel-{{item.tool}}" data-tool="{{item.tool}}" bindtap="openDiscovery" hover-class="home-pressed" aria-label="{{item.label + '，' + item.description}}">
          <view class="discovery-copy"><text class="discovery-label">{{item.label}} <text>›</text></text><view class="discovery-title">{{item.title}}</view><text class="discovery-description">{{item.description}}</text></view>
          <view class="outing-art" wx:if="{{item.tool === 'outings'}}" aria-hidden="true"></view>
          <view class="discovery-art" wx:else aria-hidden="true"><view class="home-icon home-icon-{{item.icon}}"></view></view>
        </button>
      </swiper-item>
    </swiper>
  </view>

  <view class="home-daily">
    <view class="home-section-head daily-heading"><view>今日概况</view><button class="home-button section-link" bindtap="goRecords" hover-class="home-pressed">{{readOnly ? '查看记录' : '去记录'}} ›</button></view>
    <view class="daily-metrics">
      <button class="home-button daily-metric metric-{{item.action}}" wx:for="{{homeDashboard.statusCards}}" wx:key="action" data-index="{{index}}" bindtap="openStatusDetail" hover-class="home-pressed" aria-label="{{item.label + '，' + (item.value === '—' ? '未记录' : item.value + item.unit) + '，' + item.detail + '，点击查看记录'}}">
        <view class="metric-label"><view class="metric-icon" aria-hidden="true"></view><text>{{item.label}}</text></view>
        <view class="metric-value {{item.value === '—' ? 'metric-empty' : ''}}">{{item.value}}<text wx:if="{{item.value !== '—'}}">{{item.unit}}</text></view>
        <text class="metric-detail {{item.tone === 'attention' ? 'attention-text' : ''}}">{{item.compactDetail}}</text>
      </button>
    </view>
  </view>

  <view class="home-recent">
    <view class="home-section-head recent-heading"><view>近期情况</view><view class="insight-range-switch"><button class="home-button {{insightRange === 7 ? 'active' : ''}}" data-range="7" bindtap="setInsightRange">7 天</button><button class="home-button {{insightRange === 14 ? 'active' : ''}}" data-range="14" bindtap="setInsightRange">14 天</button></view></view>
    <view class="recent-findings">
      <button class="home-button finding-card finding-card-{{item.id}} {{item.tone === 'attention' ? 'finding-attention' : ''}}" wx:for="{{homeDashboard.findings}}" wx:key="id" data-index="{{index}}" bindtap="openFinding" hover-class="home-pressed" aria-label="{{item.label + '，' + item.title + '，' + item.text + '，' + item.note + '，点击查看记录'}}">
        <view class="finding-heading"><text class="finding-label">{{item.label}}</text><text>›</text></view>
        <view class="finding-title {{item.tone === 'attention' ? 'attention-text' : ''}}">{{item.compactTitle}}</view>
        <text class="finding-summary">{{item.compactSummary}}</text>
      </button>
    </view>
    <button class="home-button record-note" bindtap="openRecent">日均按有记录天数计算 · 查看摘要 ›</button>
  </view>
  <button class="home-button recent-compact-entry" bindtap="openRecent" hover-class="home-pressed"><text>近期情况</text><text>近 {{insightRange}} 天 · 查看摘要 ›</text></button>

  <view class="home-footer">
    <button class="home-button knowledge-entry" bindtap="openKnowledge" hover-class="home-pressed" aria-label="{{'每日知识，' + homeDashboard.knowledge.title}}"><view class="home-icon home-icon-book"></view><view class="knowledge-entry-copy"><text>每日知识</text><view>{{homeDashboard.knowledge.title}}</view></view><text>›</text></button>
  </view>
</view>

<button class="home-button care-float {{homeDashboard.careReminders.length ? 'has-reminders' : ''}}" wx:if="{{!recentOpen && !careRemindersOpen && !knowledgeOpen && !festivalOpen && !healthTipOpen && !weightTrendOpen && !feedDetailOpen && !stoolDetailOpen}}" bindtap="openCareReminders" hover-class="home-pressed" aria-label="照护提醒，{{homeDashboard.careReminders.length ? homeDashboard.careReminders.length + '项待处理' : '暂无到期事项'}}">
  <view class="care-bell" aria-hidden="true"></view>
  <text class="care-float-count" wx:if="{{homeDashboard.careReminders.length}}">{{homeDashboard.careReminders.length}}</text>
</button>

<view class="overlay {{largeText ? 'home-large-text' : ''}}" wx:if="{{recentOpen}}" catchtap="closeRecent" catchtouchmove="noop">
  <view class="sheet recent-sheet" catchtap="noop">
    <view class="sheet-head"><text>近期情况</text><button class="home-button close" bindtap="closeRecent" aria-label="关闭近期情况">×</button></view>
    <view class="insight-range-switch"><button class="home-button {{insightRange === 7 ? 'active' : ''}}" data-range="7" bindtap="setInsightRange">近 7 天</button><button class="home-button {{insightRange === 14 ? 'active' : ''}}" data-range="14" bindtap="setInsightRange">近 14 天</button></view>
    <scroll-view class="recent-detail-scroll" scroll-y enhanced show-scrollbar="false">
      <button class="home-button finding-row" wx:for="{{homeDashboard.findings}}" wx:key="id" data-index="{{index}}" bindtap="openFinding" hover-class="home-pressed">
        <view class="finding-heading"><text class="finding-label">{{item.label}}</text><view class="finding-title {{item.tone === 'attention' ? 'attention-text' : ''}}">{{item.title}}</view><text>›</text></view>
        <text class="finding-summary">{{item.text}}</text><text class="finding-note">{{item.note}}</text>
      </button>
      <text class="finding-note">仅统计已保存记录，不代表健康判断。</text>
    </scroll-view>
  </view>
</view>

<view class="overlay" wx:if="{{careRemindersOpen}}" catchtap="closeCareReminders" catchtouchmove="noop">
  <view class="sheet care-reminder-sheet" catchtap="noop">
    <view class="sheet-head"><text>照护提醒<text class="care-sheet-count" wx:if="{{homeDashboard.careReminders.length}}">{{homeDashboard.careReminders.length}} 项</text></text><button class="home-button close" bindtap="closeCareReminders" aria-label="关闭照护提醒">×</button></view>
    <scroll-view class="care-reminder-scroll" style="height: {{homeDashboard.careReminders.length > 3 ? '45vh' : homeDashboard.careReminders.length * 150 + 'rpx'}}" wx:if="{{homeDashboard.careReminders.length}}" scroll-y enhanced show-scrollbar="false">
      <view class="care-reminders">
        <button class="home-button care-reminder" wx:for="{{homeDashboard.careReminders}}" wx:key="key" data-key="{{item.key}}" bindtap="openCareReminder" hover-class="home-pressed">
          <view class="care-marker {{item.overdue ? 'overdue' : ''}}"><view class="home-icon home-icon-calendar"></view></view>
          <view class="care-copy"><view>{{item.label}}<text class="{{item.overdue ? 'attention-text' : ''}}">{{item.summary}}</text></view><text>{{item.detail}}</text></view>
          <text class="care-action">{{readOnly ? '查看' : '去记录'}} ›</text>
        </button>
      </view>
    </scroll-view>
    <view class="care-sheet-empty" wx:else><view class="care-bell"></view><view>暂时没有到期事项</view><text>照护安排都在这里，有提醒时会显示数量。</text></view>
    <button class="home-button care-sheet-all" bindtap="goCare" hover-class="home-pressed">查看全部照护计划 <text>›</text></button>
  </view>
</view>

<view class="overlay" wx:if="{{knowledgeOpen}}" catchtap="closeKnowledge">
  <view class="sheet knowledge-sheet" catchtap="noop">
    <view class="sheet-head"><text>今日养宠知识</text><text class="close" bindtap="closeKnowledge">×</text></view>
    <view class="knowledge-hero"><text>{{homeDashboard.knowledge.icon}}</text><view><view>{{homeDashboard.knowledge.title}}</view><text>{{homeDashboard.knowledge.summary}}</text></view></view>
    <view class="knowledge-points">
      <view wx:for="{{homeDashboard.knowledge.detail}}" wx:key="*this"><text>{{index + 1}}</text><view>{{item}}</view></view>
    </view>
    <view class="medical-note">内容用于日常养护参考；出现精神不佳、呼吸急促或其他异常时，请及时咨询兽医。</view>
    <button class="primary-btn" bindtap="closeKnowledge">我知道了</button>
  </view>
</view>

<view class="overlay" wx:if="{{stoolDetailOpen}}" catchtap="closeStoolDetail">
  <view class="sheet stool-sheet" catchtap="noop">
    <view class="sheet-head"><text>今日排便</text><text class="close" bindtap="closeStoolDetail">×</text></view>
    <view class="stool-summary {{todayStoolAbnormalCount ? 'has-warning' : ''}}">
      <view class="stool-summary-icon">💩</view>
      <view><text>今日记录</text><view>{{todayStoolCount}}<text>次</text></view></view>
      <view class="stool-summary-status">{{todayStoolStatus}}</view>
    </view>
    <scroll-view class="today-stool-list" wx:if="{{todayStools.length}}" scroll-y enhanced show-scrollbar="false">
      <view class="today-stool-row" wx:for="{{todayStools}}" wx:key="id">
        <view class="today-stool-state {{item.abnormal ? 'warning' : ''}}">{{item.abnormal ? '!' : '✓'}}</view>
        <view class="today-stool-copy">
          <view>{{item.conditionText}}<text>{{item.colorText}}</text></view>
          <text>{{item.noteText || item.statusText}}</text>
        </view>
        <view class="today-stool-meta"><view class="{{item.abnormal ? 'warning' : ''}}">{{item.statusText}}</view><text>{{item.timeText}}</text><text wx:if="{{item.attributionText}}">{{item.attributionText}}</text></view>
      </view>
    </scroll-view>
    <view class="stool-empty" wx:else><text>💩</text><view>今天还没有排便记录</view><text>记录状态后，这里会自动同步</text></view>
    <button class="primary-btn stool-manage-btn" bindtap="goStool">{{todayStools.length ? '查看完整记录' : '去记录排便'}}</button>
    <view class="stool-sync-note">与排便详情中的记录同步</view>
  </view>
</view>

<view class="overlay" wx:if="{{feedDetailOpen}}" catchtap="closeFeedDetail">
  <view class="sheet feed-sheet" catchtap="noop">
    <view class="sheet-head"><text>今日喂食</text><text class="close" bindtap="closeFeedDetail">×</text></view>
    <view class="feed-summary">
      <view class="feed-summary-icon">🥣</view>
      <view><text>今日累计</text><view>{{todayFeedTotal}}<text>g</text></view></view>
      <view class="feed-summary-count">{{todayFeedCount}} 次喂食</view>
    </view>
    <scroll-view class="today-feed-list" wx:if="{{todayFeeds.length}}" scroll-y enhanced show-scrollbar="false">
      <view class="today-feed-row" wx:for="{{todayFeeds}}" wx:key="id">
        <view class="today-feed-icon">{{item.iconText}}</view>
        <view class="today-feed-copy"><view>{{item.type}}</view><text>{{item.foodText}}</text></view>
        <view class="today-feed-meta"><view>{{item.amountText}}</view><text>{{item.timeText}}</text><text wx:if="{{item.attributionText}}">{{item.attributionText}}</text></view>
      </view>
    </scroll-view>
    <view class="feed-empty" wx:else><text>🥣</text><view>今天还没有喂食记录</view><text>记录时间与分量，方便回顾每天的饮食</text></view>
    <button class="primary-btn feed-manage-btn" bindtap="goFeed">{{todayFeeds.length ? '查看完整记录' : '去记录喂食'}}</button>
    <view class="feed-sync-note">与喂食详情中的记录同步</view>
  </view>
</view>

<include src="../shared/weight-sheet.wxml" />

<view class="overlay" wx:if="{{healthTipOpen}}" catchtap="closeHealthTip">
  <view class="sheet health-sheet" catchtap="noop">
    <view class="sheet-head"><text>日常小贴士</text><text class="close" bindtap="closeHealthTip">×</text></view>
    <view class="health-detail-head">
      <view class="detail-icon">{{selectedHealthTip.icon}}</view>
      <view><view>{{selectedHealthTip.title}}</view><text>{{lifeStage}} · {{selectedHealthTip.badge}}</text></view>
    </view>
    <view class="detail-summary">{{selectedHealthTip.desc}}</view>
    <view class="care-home-link" wx:if="{{selectedHealthTip.type === 'care'}}" bindtap="goCare">
      <view><text>📋</text><view><view>护理与疫苗记录</view><text>历史记录、完成日期和提醒周期统一在“我的 · 照护”管理</text></view></view>
      <text>›</text>
    </view>
    <view class="detail-title">给{{pet.name}}的详细建议</view>
    <view class="advice-list">
      <view class="advice-item" wx:for="{{selectedHealthTip.detail}}" wx:key="*this"><text>✓</text><view>{{item}}</view></view>
    </view>
    <view class="medical-note">提醒根据年龄、品种和生活方式生成，仅用于健康管理参考，不能替代兽医检查与诊断。</view>
    <button class="primary-btn" bindtap="closeHealthTip">我知道了</button>
  </view>
</view>

<view class="overlay" wx:if="{{festivalOpen}}" catchtap="closeFestivals">
  <view class="sheet festival-sheet" catchtap="noop">
    <view class="sheet-head"><text>相伴纪念</text><text class="close" bindtap="closeFestivals">×</text></view>
    <view class="together-hero">
      <view class="together-paw">🐾</view>
      <view>我们已经相伴</view>
      <view class="together-number">{{daysTogether}}<text>天</text></view>
      <text>从 {{togetherLabel}} 开始，每一天都值得收藏</text>
    </view>
    <scroll-view class="festival-scroll" scroll-y enhanced show-scrollbar="false">
      <view class="milestone-title birthday-timeline-title">每岁生日</view>
      <view class="festival-event birthday-event {{item.state}}" wx:for="{{birthdayItems}}" wx:key="age">
        <view class="event-line birthday-line" wx:if="{{index < birthdayItems.length - 1}}"></view>
        <view class="event-icon">{{item.state === 'today' ? '🎉' : item.state === 'upcoming' ? '🎂' : '✓'}}</view>
        <view class="event-copy"><view>{{pet.name}} {{item.age}} 岁生日</view><text>{{item.date}}</text></view>
        <view class="event-status {{item.state}}">{{item.status}}</view>
      </view>
      <view class="milestone-title">百日纪念时间轴</view>
      <view class="festival-event {{item.state}}" wx:for="{{festivalItems}}" wx:key="days">
        <view class="event-line" wx:if="{{index < festivalItems.length - 1}}"></view>
        <view class="event-icon">{{item.state === 'today' ? '🎊' : item.state === 'upcoming' ? '✨' : '✓'}}</view>
        <view class="event-copy"><view>相伴 {{item.days}} 天</view><text>{{item.date}}</text></view>
        <view class="event-status {{item.state}}">{{item.status}}</view>
      </view>
    </scroll-view>
  </view>
</view>

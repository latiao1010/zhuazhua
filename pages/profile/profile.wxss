@import "../shared/weight-sheet.wxss";
/* 页面样式按原有级联顺序整理；媒体规则独立保留。 */
.peach { background: #ffe6d9; }
.blue { background: #e3f3ff; }
.green { background: #e2f7e9; }
.yellow { background: #fff1bd; }
.health-detail-head { display: flex; align-items: center; padding: 24rpx; border-radius: 26rpx; background: var(--cream); }
.detail-icon { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin-right: 18rpx; border-radius: 23rpx; background: #ffe1d3; font-size: 36rpx; }
.health-detail-head>view:last-child>view { font-size: 29rpx; font-weight: 600; }
.health-detail-head>view:last-child>text { display: block; margin-top: 6rpx; color: #b36c50; font-size: 22rpx; }
.detail-summary { margin: 20rpx 4rpx; color: #6f655e; font-size: 26rpx; line-height: 1.7; }
.care-editor { margin: 8rpx 0 20rpx; padding: 0 18rpx; border-radius: 26rpx; background: #fff7ed; }
.care-editor>.detail-title { padding-top: 18rpx; }
.care-edit-row { display: flex; align-items: center; padding: 14rpx 0; border-top: 1rpx solid #f1dfd0; }
.care-edit-row>text { margin-right: 13rpx; font-size: 28rpx; }
.care-edit-row>view:nth-child(2) { flex: 1; }
.care-edit-row>view:nth-child(2)>view { font-size: 22rpx; font-weight: 600; }
.care-edit-row>view:nth-child(2)>text { display: block; margin-top: 3rpx; color: var(--muted); font-size: 22rpx; }
.care-date { align-items: center; color: #ae704a; font-size: 22rpx; font-weight: 700; }
.care-date text { margin-left: 8rpx; color: #c2b3a8; font-size: 30rpx; }
.detail-title { margin: 24rpx 0 12rpx; font-size: 25rpx; font-weight: 600; }
.advice-list { display: flex; flex-direction: column; gap: 12rpx; }
.advice-item { display: flex; padding: 17rpx; border-radius: 26rpx; background: #faf6f2; color: #665d56; font-size: 25rpx; line-height: 1.7; }
.advice-item>text { display: flex; align-items: center; justify-content: center; flex: none; width: 32rpx; height: 32rpx; margin-right: 12rpx; border-radius: 50%; color: #fff; background: #70bf89; font-size: 22rpx; }
.medical-note { margin: 20rpx 0; padding: 17rpx; border-radius: 26rpx; color: #8c765f; background: #fff5dd; font-size: 22rpx; line-height: 1.5; }
.health-sheet { max-height: 88vh; overflow-y: auto; }
.close { color: var(--muted); font-size: 42rpx; font-weight: 400; }
.care-editor { padding-bottom: 16rpx; }
.care-date { display: block; }
.care-manage { display: flex; align-items: center; justify-content: center; margin-top: 10rpx; padding: 15rpx; border-radius: 16rpx; color: #8d664e; background: #fff; font-size: 22rpx; font-weight: 600; }
.care-manage text { margin-left: 8rpx; font-size: 28rpx; }
.festival-sheet { padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); max-height: 88vh; overflow-y: auto; }
.together-hero { padding: 30rpx; border-radius: 30rpx; text-align: center; color: #665044; background: #fff0e5; }
.together-paw { font-size: 38rpx; display: none; }
.together-hero>view:nth-child(2) { margin-top: 7rpx; font-size: 22rpx; }
.together-number { margin: 4rpx 0; font-size: 66rpx; font-weight: 600; color: #cb7958; }
.together-number text { margin-left: 6rpx; font-size: 25rpx; }
.together-hero>text { font-size: 22rpx; opacity: .86; }
.festival-scroll { height: 44vh; margin-top: 22rpx; }
.festival-event { position: relative; display: flex; align-items: center; min-height: 92rpx; padding: 8rpx 6rpx; }
.event-line { position: absolute; z-index: 0; left: 33rpx; top: 68rpx; bottom: -28rpx; width: 2rpx; background: #eadfd6; }
.birthday-line { background: #f0d8c8; }
.event-icon { z-index: 1; display: flex; align-items: center; justify-content: center; flex: none; width: 62rpx; height: 62rpx; border-radius: 26rpx; background: #fff3ec; font-size: 27rpx; }
.birthday-event .event-icon { background: #ffead9; }
.festival-event.upcoming .event-icon { background: #fff0c8; }
.festival-event.today .event-icon { background: #ffe0d5; }
.event-copy { flex: 1; margin-left: 16rpx; min-width: 0; }
.event-copy view { font-size: 24rpx; font-weight: 600; }
.event-copy text { display: block; margin-top: 5rpx; color: var(--muted); font-size: 22rpx; }
.event-status { padding: 7rpx 12rpx; border-radius: 99rpx; color: #8e847c; background: #fff3ec; font-size: 22rpx; flex: none; margin-left: 12rpx; }
.event-status.upcoming { color: #b17a32; background: #fff0cc; }
.event-status.today { color: #dd6243; background: #ffe5dc; font-weight: 600; }
.milestone-title { margin: 26rpx 0 10rpx; font-size: 25rpx; font-weight: 600; }
.birthday-timeline-title { margin-top: 4rpx; }
.feed-sheet { max-height: 88vh; overflow: hidden; overflow-y: auto; }
.feed-summary { display: flex; align-items: center; padding: 24rpx; border-radius: 26rpx; background: var(--cream); }
.feed-summary-icon { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin-right: 18rpx; border-radius: 24rpx; background: #dff1fc; font-size: 38rpx; }
.feed-summary>view:nth-child(2) { flex: 1; }
.feed-summary>view:nth-child(2)>text { color: #87949b; font-size: 22rpx; }
.feed-summary>view:nth-child(2)>view { margin-top: 2rpx; color: #3c4549; font-size: 43rpx; font-weight: 600; }
.feed-summary>view:nth-child(2)>view text { margin-left: 5rpx; font-size: 22rpx; }
.feed-summary-count { padding: 9rpx 14rpx; border-radius: 99rpx; color: #568ba6; background: rgba(255,255,255,.8); font-size: 22rpx; font-weight: 600; }
.today-feed-list { max-height: 370rpx; margin-top: 18rpx; border: 1rpx solid #edf0f1; border-radius: 24rpx; background: #fff; }
.today-feed-row { display: flex; align-items: flex-start; min-height: 104rpx; padding: 20rpx; border-bottom: 1rpx solid #f0ece9; gap: 12rpx; }
.today-feed-row:last-child { border-bottom: 0; }
.today-feed-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 58rpx; height: 58rpx; border-radius: 26rpx; background: #e8f5fc; font-size: 29rpx; }
.today-feed-copy { min-width: 0; flex: 1; margin-left: 16rpx; }
.today-feed-copy view { font-size: 23rpx; font-weight: 600; }
.today-feed-copy text { display: block; overflow: visible; margin-top: 5rpx; color: #958b84; font-size: 22rpx; text-overflow: ellipsis; white-space: normal; line-height: 1.5; }
.today-feed-meta { text-align: right; flex: none; max-width: 180rpx; }
.today-feed-meta view { color: #f27653; font-size: 23rpx; font-weight: 600; }
.today-feed-meta text { display: block; margin-top: 5rpx; color: var(--muted); font-size: 22rpx; }
.feed-empty { display: flex; align-items: center; flex-direction: column; padding: 48rpx 0 32rpx; color: var(--muted); }
.feed-empty>text:first-child { font-size: 53rpx; }
.feed-empty>view { margin-top: 12rpx; color: #5d5550; font-size: 24rpx; font-weight: 600; }
.feed-empty>text:last-child { margin-top: 7rpx; font-size: 22rpx; }
.feed-manage-btn { margin-top: 20rpx; }
.feed-sync-note { margin-top: 12rpx; color: var(--muted); text-align: center; font-size: 22rpx; }
.stool-sheet { max-height: 88vh; overflow: hidden; overflow-y: auto; }
.stool-summary { display: flex; align-items: center; padding: 24rpx; border-radius: 26rpx; background: var(--cream); }
.stool-summary.has-warning { background: var(--cream); }
.stool-summary-icon { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin-right: 18rpx; border-radius: 24rpx; background: #ddf3e5; font-size: 38rpx; }
.has-warning .stool-summary-icon { background: #ffe3d3; }
.stool-summary>view:nth-child(2) { flex: 1; }
.stool-summary>view:nth-child(2)>text { color: #82948a; font-size: 22rpx; }
.stool-summary>view:nth-child(2)>view { margin-top: 2rpx; color: #3c4740; font-size: 43rpx; font-weight: 600; }
.stool-summary>view:nth-child(2)>view text { margin-left: 5rpx; font-size: 22rpx; }
.stool-summary-status { padding: 9rpx 14rpx; border-radius: 99rpx; color: #588c69; background: rgba(255,255,255,.82); font-size: 22rpx; font-weight: 600; }
.has-warning .stool-summary-status { color: #cc7652; }
.today-stool-list { max-height: 370rpx; margin-top: 18rpx; border: 1rpx solid #e9f0eb; border-radius: 24rpx; background: #fff; }
.today-stool-row { display: flex; align-items: flex-start; min-height: 108rpx; padding: 20rpx; border-bottom: 1rpx solid #f0ece9; gap: 12rpx; }
.today-stool-row:last-child { border-bottom: 0; }
.today-stool-state { display: flex; align-items: center; justify-content: center; flex: none; width: 54rpx; height: 54rpx; border-radius: 26rpx; color: #fff; background: #70bc88; font-size: 22rpx; font-weight: 600; }
.today-stool-state.warning { background: #ee926d; }
.today-stool-copy { min-width: 0; flex: 1; margin-left: 15rpx; }
.today-stool-copy>view { font-size: 22rpx; font-weight: 600; }
.today-stool-copy>view text { margin-left: 9rpx; color: #9b9189; font-size: 22rpx; font-weight: 400; }
.today-stool-copy>text { display: block; overflow: visible; margin-top: 5rpx; color: #958b84; font-size: 22rpx; text-overflow: ellipsis; white-space: normal; line-height: 1.5; }
.today-stool-meta { text-align: right; flex: none; max-width: 180rpx; }
.today-stool-meta view { color: #60a879; font-size: 22rpx; font-weight: 600; }
.today-stool-meta view.warning { color: #dc7450; }
.today-stool-meta text { display: block; margin-top: 7rpx; color: var(--muted); font-size: 22rpx; }
.stool-empty { display: flex; align-items: center; flex-direction: column; padding: 48rpx 0 32rpx; color: var(--muted); }
.stool-empty>text:first-child { font-size: 53rpx; }
.stool-empty>view { margin-top: 12rpx; color: #5d5550; font-size: 24rpx; font-weight: 600; }
.stool-empty>text:last-child { margin-top: 7rpx; font-size: 22rpx; }
.stool-manage-btn { margin-top: 20rpx; }
.stool-sync-note { margin-top: 12rpx; color: var(--muted); text-align: center; font-size: 22rpx; }
.care-home-link { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 0 20rpx; padding: 18rpx 20rpx; border-radius: 26rpx; background: #fff7ed; }
.care-home-link>view { display: flex; align-items: center; min-width: 0; }
.care-home-link>view>text { margin-right: 14rpx; font-size: 30rpx; }
.care-home-link>view>view>view { font-size: 22rpx; font-weight: 600; }
.care-home-link>view>view>text { display: block; margin-top: 5rpx; color: #9e8d80; font-size: 22rpx; }
.care-home-link>text { margin-left: 12rpx; color: #c3b3a8; font-size: 34rpx; }
.knowledge-sheet { max-height: 88vh; overflow-y: auto; }
.knowledge-hero { display: flex; align-items: center; padding: 24rpx; border-radius: 26rpx; background: var(--cream); }
.knowledge-hero>text { display: flex; align-items: center; justify-content: center; flex: none; width: 76rpx; height: 76rpx; margin-right: 17rpx; border-radius: 23rpx; background: #ffe7b7; font-size: 36rpx; }
.knowledge-hero>view>view { font-size: 27rpx; font-weight: 600; }
.knowledge-hero>view>text { display: block; margin-top: 7rpx; color: #8e7c6c; font-size: 22rpx; line-height: 1.45; }
.knowledge-points { margin: 18rpx 0; }
.knowledge-points>view { display: flex; align-items: flex-start; padding: 15rpx 4rpx; border-bottom: 1rpx solid #f0e8e1; color: #625952; font-size: 26rpx; line-height: 1.7; }
.knowledge-points>view>text { display: flex; align-items: center; justify-content: center; flex: none; width: 31rpx; height: 31rpx; margin: 1rpx 12rpx 0 0; border-radius: 50%; color: #fff; background: #ef8a64; font-size: 22rpx; font-weight: 600; }

/* 首页：暖白底、清晰的记录数字、固定的功能入口。 */
page { --ink:#2f3e38; --muted:#6f7d75; --line:#e9eee9; --cream:#fafcf9; --orange:#d7755c; background:#fafcf9; }
.journal-home { display:flex; flex-direction:column; justify-content:space-between; gap:6px; height:100vh; min-height:0; max-width:480px; margin:0 auto; padding:12px 16px 10px; box-sizing:border-box; background:#fafcf9; }
.home-button { display:block; width:auto!important; min-height:0; margin:0!important; padding:0; border:0; border-radius:0; background:transparent; color:inherit; font-size:28rpx; font-weight:400; text-align:left; line-height:1.5; box-sizing:border-box; }
.home-button::after { border:0; }
.home-pressed { opacity:.7; }
.home-topline { display:flex; align-items:center; justify-content:space-between; gap:8px; height:20px; color:var(--muted); font-size:11px; }
.home-topline>text:first-child { flex:1; min-width:0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.demo-badge { flex:none; padding:2px 6px; border-radius:99px; background:#fff0e9; color:#a35640; font-size:10px; }
.shared-badge { background:#eaf2ee; color:#547563; }
.home-pet-head { display:flex; align-items:center; gap:12px; height:56px; }
.pet-avatar { flex:none; width:48px!important; height:48px; border-radius:16px; overflow:hidden; border:2px solid #fff; background:#fff0e4; box-shadow:0 0 0 1px #f2e7db,0 3px 9px rgba(137,103,72,.08); }
.pet-avatar image { display:block; width:100%; height:100%; }
.home-pet-copy { flex:1; min-width:0; }
.home-title { overflow:hidden; color:#2f3e38; font-size:22px; font-weight:600; line-height:1.35; text-overflow:ellipsis; white-space:nowrap; }
.home-title>text { margin-left:7px; color:#748478; font-weight:400; font-size:15px; }
.home-pet-meta { display:flex; align-items:center; gap:8px; min-width:0; color:#68796d; }
.home-pet-meta button { min-width:0; padding:3px 7px; border-radius:7px; background:#f0f4ee; color:#627367; font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.home-pet-meta button>text { margin-left:5rpx; color:#8e9b92; }
.meta-dot { display:none; }
.home-notice { flex:none; padding:2px 5px; border-radius:6px; background:#fff0e9; color:#98553e; font-size:10px; white-space:nowrap; }
.home-section-head { display:flex; align-items:center; justify-content:space-between; gap:8px; height:30px; margin:0 0 4px; }
.home-section-head>view:first-child { color:#2f3e38; font-size:16px; font-weight:600; }
.home-section-head>text { min-width:0; color:var(--muted); font-size:11px; text-align:right; }
.home-section-head .section-link { flex:none; padding:6px 0 6px 8px; color:#6f7d75; font-size:12px; }
.discovery-heading { flex:none; }
.discovery-swiper { flex:1; min-height:0; }
.discovery-panel { display:flex; align-items:center; justify-content:space-between; gap:12px; width:100%!important; height:calc(100% - 20px); padding:10px 14px; border:1px solid #e7ebe3; border-radius:14px; background:#fffaf5; }
.discovery-panel-outings { border-color:#d9e9d9; background:linear-gradient(115deg,#e3f2e4,#f1f7e9); }
.discovery-panel-age { border-color:#f1e1d5; background:linear-gradient(115deg,#fff0e6,#fff8ee); }
.discovery-panel-personality { border-color:#e5e1ed; background:linear-gradient(115deg,#f0edf8,#f9f5fa); }
.discovery-panel-bingo { border-color:#dce9ec; background:linear-gradient(115deg,#eaf5f6,#f1f8f8); }
.discovery-panel-personality .discovery-art { background:#e8e1f2; }
.discovery-panel-bingo .discovery-art { background:#dfeef0; }
.outing-art { width:72px; height:72px; flex:none; background-position:center; background-repeat:no-repeat; background-size:contain; }
.discovery-art { display:flex; align-items:center; justify-content:center; flex:none; width:56px; height:56px; border-radius:18px; background:#fff0e5; }
.discovery-art .home-icon { width:28px; height:28px; }
.discovery-copy { flex:1; min-width:0; }
.discovery-label { display:inline-flex; align-items:center; padding:2px 7px; border-radius:99px; background:rgba(255,255,255,.65); color:#52745b; font-size:10px; line-height:1.35; }
.discovery-label>text { margin-left:6rpx; }
.discovery-title { margin-top:2px; color:#38533f; font-size:17px; font-weight:600; line-height:1.4; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.discovery-description { display:block; margin-top:3px; color:#657b67; font-size:11px; line-height:1.4; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.daily-heading { margin-bottom:4px; }
.daily-metrics { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); padding:9px 0; border:1px solid #e5ece5; border-radius:12px; background:#fff; box-shadow:0 3px 10px rgba(49,76,55,.025); }
.daily-metric { position:relative; min-width:0; min-height:44px; padding:0 4px; text-align:center; }
.daily-metric+.daily-metric { border-left:1rpx solid #edf1ec; }
.metric-label { display:flex; align-items:center; justify-content:center; gap:4px; height:1.35em; color:#65766a; font-size:12px; line-height:1.35; }
.metric-icon { display:block; flex:none; width:16px; height:16px; background:center / contain no-repeat; }
.metric-feed .metric-icon { background-image:url("data:image/svg+xml;base64,"); }
.metric-water .metric-icon { background-image:url("data:image/svg+xml;base64,"); }
.metric-stool .metric-icon { background-image:url("data:image/svg+xml;base64,"); }
.metric-walk .metric-icon { background-image:url("data:image/svg+xml;base64,"); }
.metric-value { margin-top:2px; color:#304d3d; font-size:19px; font-weight:600; line-height:1.3; font-variant-numeric:tabular-nums; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.metric-value>text { margin-left:2px; color:#6f7d75; font-size:10px; font-weight:400; }
.metric-value.metric-empty { color:#7a8980; }
.metric-detail { display:inline-block; margin-top:2px; padding:0 4px; color:#6f7d75; font-size:10px; line-height:1.35; white-space:nowrap; }
.metric-detail.attention-text { border-radius:4px; background:#fff0e7; }
.attention-text { color:#b3573f!important; }
.care-reminders { padding:0 20rpx; border:1rpx solid #ede9e0; border-radius:22rpx; background:#fff; }
.care-reminder { display:flex; align-items:center; gap:14rpx; min-height:114rpx; padding:18rpx 0; }
.care-reminder+.care-reminder { border-top:1rpx solid #eef0e9; }
.care-marker { flex:none; display:flex; align-items:center; justify-content:center; width:56rpx; height:56rpx; border-radius:18rpx; background:#eef5ed; }
.care-marker.overdue { background:#fff0e8; }
.care-marker .home-icon { width:32rpx; height:32rpx; }
.care-copy { flex:1; min-width:0; }
.care-copy>view { display:flex; flex-wrap:wrap; align-items:center; gap:6rpx 12rpx; font-size:27rpx; font-weight:600; }
.care-copy>view>text { color:#7b8473; font-size:22rpx; font-weight:400; }
.care-copy>text { display:block; margin-top:5rpx; color:var(--muted); font-size:22rpx; line-height:1.5; }
.care-action { flex:none; color:#b35f46; font-size:23rpx; }
.insight-range-switch { display:flex; gap:2px; flex:none; padding:2px; border:1px solid #e9ede7; border-radius:99px; background:#f0f4ee; }
.insight-range-switch>button { display:flex; align-items:center; justify-content:center; min-width:38px; min-height:24px; padding:2px 7px; border-radius:99px; color:#728071; font-size:12px; }
.insight-range-switch>button.active { background:#557460; color:#fff; font-weight:600; box-shadow:0 2px 4px rgba(70,91,70,.08); }
.recent-heading { height:32px; margin-bottom:4px; }
.recent-findings { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
.finding-row { width:100%; min-height:44px; padding:16rpx 0; }
.finding-row+.finding-row { border-top:1rpx solid #edf1ec; }
.finding-heading { display:flex; align-items:center; gap:14rpx; color:#62796a; }
.finding-label { flex:none; font-size:23rpx; }
.finding-heading>text:last-child { flex:none; color:#8b9a8c; font-size:26rpx; }
.finding-title { flex:1; min-width:0; color:#38533f; font-size:25rpx; font-weight:600; line-height:1.5; }
.finding-summary { display:block; margin-top:3rpx; color:#6f7d70; font-size:22rpx; line-height:1.5; }
.finding-note { display:block; margin-top:3rpx; color:#79847a; font-size:21rpx; line-height:1.5; }
.record-note { display:flex; align-items:center; width:100%!important; min-height:32px; margin-top:0!important; color:#596f61; font-size:12px; line-height:1.4; }
.knowledge-entry { display:flex; align-items:center; gap:8px; width:100%!important; height:44px; padding:6px 10px; border:1px solid #f0e5db; border-radius:12px; background:#fff5ed; }
.knowledge-entry>.home-icon { width:24px; height:24px; }
.knowledge-entry-copy { flex:1; min-width:0; }
.knowledge-entry-copy>text { display:block; color:#687d5b; font-size:10px; line-height:1.4; }
.knowledge-entry-copy>view { color:#405536; font-size:12px; line-height:1.4; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.knowledge-entry>text { color:#7b9270; font-size:18px; }
.home-icon { display:block; flex:none; width:38rpx; height:38rpx; background-position:center; background-repeat:no-repeat; background-size:contain; }

.home-icon-age{background-image:url("data:image/svg+xml;base64,")}
.home-icon-heart{background-image:url("data:image/svg+xml;base64,")}
.home-icon-grid{background-image:url("data:image/svg+xml;base64,")}
.home-icon-calendar{background-image:url("data:image/svg+xml;base64,")}
.home-icon-book{background-image:url("data:image/svg+xml;base64,")}
.outing-art{background-image:url("data:image/svg+xml;base64,")}

/* 自动定位天气；授权与失败状态在原位置展示。 */
.home-weather { padding:3px 10px 7px; border:1px solid #e6ece5; border-radius:12px; background:linear-gradient(110deg,#fff,#f6f9f3); }
.weather-top { display:flex; align-items:center; gap:7px; height:32px; }
.weather-current { display:flex; align-items:center; flex:1; gap:4px; min-width:0; color:#415c49; font-size:12px; overflow:hidden; white-space:nowrap; }
.weather-current>text:nth-child(2) { font-size:20px; font-weight:600; }
.weather-status { flex:1; min-width:0; color:#748172; font-size:12px; }
.weather-refresh { display:flex; align-items:center; justify-content:flex-end; flex:none; min-width:36px; height:32px; color:#698070; font-size:12px; }
.weather-refresh[disabled] { background:transparent; color:#99a698; }
.weather-forecast { display:flex; align-items:center; justify-content:space-between; gap:8px; width:100%!important; min-height:28px; color:#4e6857; font-size:12px; line-height:1.5; }
.weather-source { display:block; color:#5e7162; font-size:11px; line-height:1.5; }

/* 照护入口悬浮在原生导航上方，详情按需展开。 */
.care-float { position:fixed; z-index:15; right:16px; bottom:10px; display:flex; align-items:center; justify-content:center; width:44px!important; height:44px; border:2px solid #fff; border-radius:50%; background:#edf5ee; box-shadow:0 3px 10px rgba(53,79,60,.14); overflow:visible; }
.care-float.has-reminders { background:#fff0e7; }
.care-bell { flex:none; display:block; width:22px; height:22px; background:center / contain no-repeat; }
.care-float-count { position:absolute; top:-4rpx; right:-4rpx; display:flex; align-items:center; justify-content:center; min-width:30rpx; height:30rpx; padding:0 4rpx; box-sizing:border-box; border:2rpx solid #fff; border-radius:99rpx; background:#d97559; color:#fff; font-size:20rpx; font-weight:600; line-height:1; }
.care-reminder-sheet { max-width:760px; margin:0 auto; background:#fafcf9; }
.care-reminder-sheet .sheet-head { margin-bottom:18rpx; color:#344c3b; font-size:32rpx; }
.care-reminder-sheet .close { width:72rpx!important; min-width:44px; min-height:44px; }
.care-sheet-count { margin-left:14rpx; color:#9b6a53; font-size:24rpx; font-weight:400; }
.care-reminder-scroll { max-height:45vh; }
.care-reminder-sheet .care-reminders { border:0; padding:0 4rpx; background:transparent; }
.care-reminder-sheet .care-reminder { min-height:132rpx; box-sizing:border-box; }
.care-sheet-empty { padding:24rpx 0 32rpx; text-align:center; }
.care-sheet-empty>.care-bell { margin:0 auto 18rpx; }
.care-sheet-empty>view:not(.care-bell) { color:#405d47; font-size:29rpx; }
.care-sheet-empty>text { display:block; margin-top:10rpx; color:#7a8777; font-size:24rpx; line-height:1.6; }
.care-sheet-all { display:flex; align-items:center; justify-content:center; gap:16rpx; margin-top:20rpx!important; min-height:88rpx; padding:20rpx; border:1rpx solid #e0e8dc; border-radius:18rpx; background:#edf5ec; color:#48664f; font-size:26rpx; }
.care-bell{background-image:url("data:image/svg+xml;base64,")}
.weather-place { max-width:30%; min-width:0; color:#45634e; font-size:13px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.weather-privacy { min-height:24px; color:#5e7162; font-size:11px; line-height:24px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }


/* 首屏按可用高度排版；短屏将近期详情收进抽屉，内容仍可完整查看。 */
page { height:100%; overflow:hidden; }
.journal-home>view { flex-shrink:0; }
.home-badges { display:flex; align-items:center; gap:4px; flex:none; }
.journal-home>.home-discovery { display:flex; flex-direction:column; flex:1 1 auto; min-height:128px; max-height:154px; }
.weather-forecast>text:first-child { flex:1; min-width:0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.weather-forecast[disabled] { background:transparent; color:#788777; }
.finding-card { min-width:0; padding:8px 10px; border:1px solid #e5ece5; border-radius:12px; background:#fff; }
.finding-card-water { border-color:#e0ecee; background:#f0f7f8; }
.finding-attention { border-color:#f0e4db; background:#fff5ee; }
.finding-card .finding-heading { justify-content:space-between; }
.finding-card .finding-label { color:#62796a; font-size:11px; }
.finding-card .finding-heading>text:last-child { font-size:14px; }
.finding-card .finding-title { color:#38533f; font-size:14px; line-height:1.4; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.finding-card .finding-summary { margin-top:2px; color:#5d7063; font-size:11px; line-height:1.4; }
.recent-compact-entry { display:none; }
.home-footer { margin-top:0; padding-right:56px; }
.recent-sheet { max-width:480px; margin:0 auto; }
.recent-sheet>.insight-range-switch { width:max-content; margin-bottom:12px; }
.recent-sheet .close { width:44px!important; height:44px; }
.recent-detail-scroll { height:36vh; }
.recent-sheet .finding-row { padding:16px 0; }
.recent-sheet .finding-heading { flex-wrap:wrap; }
.recent-sheet .finding-title { flex:1; }
/* 较高屏幕把余量分配给卡片和区块间距，底部不再单独留出一大块空白。 */
@media (min-height:700px) {
  .journal-home { gap:clamp(6px,calc(6vh - 36px),12px); }
  .home-pet-head { height:clamp(56px,9vh,70px); }
  .pet-avatar { width:clamp(48px,7.5vh,58px)!important; height:clamp(48px,7.5vh,58px); border-radius:19px; }
  .home-title { font-size:24px; }
  .home-title>text { font-size:17px; }
  .home-section-head>view:first-child { font-size:17px; }
  .home-weather { padding:6px 12px 10px; border-radius:15px; }
  .journal-home>.home-discovery { max-height:clamp(154px,22vh,186px); }
  .discovery-panel { padding:12px 16px; border-radius:17px; }
  .discovery-title { font-size:19px; margin-top:4px; }
  .discovery-description { font-size:12px; margin-top:5px; }
  .outing-art { width:80px; height:80px; }
  .discovery-art { width:64px; height:64px; border-radius:22px; }
  .discovery-art .home-icon { width:32px; height:32px; }
  .daily-metrics { padding:clamp(9px,calc(8vh - 43px),17px) 0; border-radius:15px; }
  .metric-value { margin-top:4px; font-size:23px; }
  .metric-label { font-size:13px; }
  .metric-detail { margin-top:4px; font-size:11px; }
  .finding-card { padding:clamp(8px,calc(6vh - 31px),14px) 12px; border-radius:15px; }
  .finding-card .finding-label { font-size:12px; }
  .finding-card .finding-title { margin-top:3px; font-size:16px; }
  .finding-card .finding-summary { margin-top:4px; font-size:11px; }
  .knowledge-entry { height:54px; padding:8px 12px; gap:10px; border-radius:15px; }
  .knowledge-entry>.home-icon { width:28px; height:28px; }
  .knowledge-entry-copy>text { font-size:11px; }
  .knowledge-entry-copy>view { margin-top:2px; font-size:13px; }
  .care-float { bottom:15px; }
}
@media (min-width:480px) {
  .care-float { right:calc((100vw - 480px) / 2 + 16px); }
}
@media (max-height:650px) {
  .journal-home { gap:4px; padding-top:8px; padding-bottom:8px; }
  .home-topline { height:18px; }
  .home-pet-head { height:50px; }
  .pet-avatar { width:44px!important; height:44px; }
  .home-title { font-size:20px; }
  .home-section-head { height:26px; margin-bottom:2px; }
  .home-section-head>view:first-child { font-size:15px; }
  .journal-home>.home-discovery { min-height:110px; max-height:124px; }
  .discovery-panel { padding:6px 12px; }
  .outing-art { width:56px; height:56px; }
  .discovery-description { margin-top:1px; }
  .discovery-title { font-size:16px; }
  .daily-metrics { padding:6px 0; }
  .finding-card { padding-top:6px; padding-bottom:6px; }
  .recent-heading { height:30px; }
  .home-footer { padding-right:52px; }
  .care-float { bottom:8px; }
}
@media (max-height:560px) {
  .home-recent { display:none; }
  .recent-compact-entry { display:flex; flex:none; align-items:center; justify-content:space-between; height:36px; padding:0 10px; border:1px solid #e5ece5; border-radius:10px; background:#fff; }
  .recent-compact-entry>text:first-child { color:#38533f; font-size:14px; font-weight:600; }
  .recent-compact-entry>text:last-child { color:#6f7d75; font-size:11px; }
}
@media (max-height:480px) {
  .journal-home { gap:3px; padding-top:6px; padding-bottom:6px; }
  .home-pet-head { height:44px; }
  .pet-avatar { width:38px!important; height:38px; border-radius:13px; }
  .home-title { font-size:18px; }
  .home-title>text { font-size:14px; }
  .home-pet-meta button { font-size:11px; padding:1px 0; }
  .weather-top { height:28px; }
  .weather-source { display:none; }
  .weather-needs-privacy .weather-forecast { display:none; }
  .journal-home>.home-discovery { min-height:92px; max-height:102px; }
  .discovery-description { display:none; }
  .outing-art,.discovery-art { width:44px; height:44px; }
  .home-section-head { height:24px; }
  .daily-metrics { padding:4px 0; }
  .metric-value { font-size:17px; }
  .care-float { bottom:6px; }
  .recent-compact-entry { height:32px; }
}
@media (max-height:420px) and (min-width:600px) {
  .journal-home { display:grid; max-width:760px; grid-template-columns:minmax(0,1fr) minmax(0,1fr); grid-template-rows:auto minmax(0,1fr) auto; gap:6px 12px; }
  .journal-home>.home-discovery { min-height:92px; max-height:none; }
  .home-daily { align-self:center; }
  .home-footer { margin-top:0; }
  .care-float { right:16px; }
}

/* 微信大字体档使用更易读的字号；短屏摘要继续通过入口展开。 */
.home-large-text .home-topline { font-size:12px; }
.home-large-text .home-pet-head { height:52px; }
.home-large-text .home-title { font-size:24px; line-height:1.2; }
.home-large-text .home-title>text { font-size:18px; }
.home-large-text .home-pet-meta button { font-size:14px; padding:1px 5px; }
.home-large-text .home-weather { padding:2px 10px 6px; }
.home-large-text .weather-top { height:32px; }
.home-large-text .weather-place,.home-large-text .weather-current,.home-large-text .weather-status,.home-large-text .weather-refresh { font-size:14px; }
.home-large-text .weather-current>text:nth-child(2) { font-size:22px; }
.home-large-text .weather-forecast { font-size:14px; }
.home-large-text .weather-source,.home-large-text .weather-privacy { font-size:12px; }
.home-large-text .home-section-head { height:30px; margin-bottom:2px; }
.home-large-text .home-section-head>view:first-child { font-size:17px; }
.home-large-text .home-section-head>text { font-size:12px; }
.home-large-text .section-link { font-size:14px; padding:3px 0 3px 8px; }
.journal-home.home-large-text>.home-discovery { min-height:104px; max-height:124px; }
.home-large-text .discovery-title { font-size:18px; }
.home-large-text .discovery-label { font-size:12px; padding:0 6px; }
.home-large-text .discovery-description { display:none; }
.home-large-text .outing-art,.home-large-text .discovery-art { width:44px; height:44px; }
.home-large-text .daily-metrics { padding:5px 0; }
.home-large-text .metric-label { font-size:14px; }
.home-large-text .metric-value { font-size:22px; }
.home-large-text .metric-value>text,.home-large-text .metric-detail { font-size:12px; }
.home-large-text .recent-compact-entry { height:36px; }
.home-large-text .recent-compact-entry>text:last-child { font-size:13px; }
.home-large-text .finding-summary,.home-large-text .record-note { font-size:12px; }
.home-large-text .knowledge-entry { padding-top:4px; padding-bottom:4px; }
.home-large-text .knowledge-entry-copy>text { font-size:12px; line-height:1.25; }
.home-large-text .knowledge-entry-copy>view { font-size:14px; line-height:1.25; }
.home-large-text .recent-sheet .sheet-head { font-size:20px; }
.home-large-text .recent-sheet .finding-label,.home-large-text .recent-sheet .finding-title { font-size:16px; }
.home-large-text .recent-sheet .finding-summary,.home-large-text .recent-sheet .finding-note { font-size:14px; }
.home-large-text .recent-sheet .insight-range-switch>button { font-size:14px; min-height:32px; }
@media (max-height:700px) {
  .home-large-text .home-recent { display:none; }
  .home-large-text .recent-compact-entry { display:flex; flex:none; align-items:center; justify-content:space-between; padding:0 10px; border:1px solid #e5ece5; border-radius:10px; background:#fff; }
  .home-large-text .recent-compact-entry>text:first-child { color:#38533f; font-size:16px; font-weight:600; }
  .home-large-text .recent-compact-entry>text:last-child { color:#596f61; }
}
@media (max-height:480px) {
  .journal-home.home-large-text { gap:2px; }
  .home-large-text .home-pet-head { height:50px; }
  .home-large-text .home-section-head { height:26px; }
  .home-large-text .daily-metrics { padding:4px 0; }
}

.home-page{height:100vh;min-height:0;overflow:hidden;display:flex;flex-direction:column;padding-bottom:24rpx}.home-page>.topbar,.home-page>.stats,.home-page>.section-title,.home-page>.weather-card{flex-shrink:0}.notify{ width: 72rpx; height: 72rpx; border-radius: 50%; background: #fff; box-shadow: 0 8rpx 24rpx rgba(80,60,45,.08); text-align: center; line-height: 72rpx; font-size: 36rpx; }
.stats{ display: grid; grid-template-columns: repeat(4,1fr); gap: 12rpx; margin-top: 0; }
.stat{ padding: 20rpx 6rpx; text-align: center; }
.festival-stat{background:linear-gradient(145deg,#fff9e9,#fff)}
.stat-icon{ width: 54rpx; height: 54rpx; margin: 0 auto 12rpx; border-radius: 18rpx; line-height: 54rpx; }
.peach{ background: #ffe6d9; }.blue{ background: #e3f3ff; }.green{background:#e2f7e9}.yellow{ background: #fff1bd; }
.stat-number{ font-size: 29rpx; font-weight: 900; }.unit{ color: #8c8179; font-size: 18rpx; }.stat-label{ margin-top: 5rpx; color: #9f958d; font-size: 19rpx; }

.weather-card{padding:26rpx}.weather-top,.weather-main{display:flex;align-items:center}.weather-top{justify-content:space-between}.weather-main>view:last-child>text{display:block;margin-top:4rpx;color:#9b9189;font-size:20rpx}.weather-icon{margin-right:16rpx;font-size:48rpx}.temperature{font-size:42rpx;font-weight:900}.live-badge{padding:8rpx 13rpx;border-radius:99rpx;color:#5d9d72;background:#eaf8ef;font-size:18rpx}.rain-alert{display:flex;align-items:center;margin-top:22rpx;padding:20rpx;border-radius:20rpx;color:#4f8b67;background:#edf9f1}.rain-alert.has-rain{color:#5f65aa;background:#eeeeff}.rain-alert>text{margin-right:16rpx;font-size:34rpx}.rain-alert view view{font-size:23rpx;font-weight:800}.rain-alert view text{display:block;margin-top:6rpx;opacity:.75;font-size:19rpx}.season-tip{margin-top:18rpx;padding-top:18rpx;border-top:1rpx dashed #e8ddd5}.season-tip>text{color:#a56d43;font-size:21rpx;font-weight:800}.season-tip view{margin-top:9rpx;color:#766c65;font-size:22rpx;line-height:1.6}.water-line{margin-top:16rpx;padding:14rpx 17rpx;border-radius:16rpx;color:#4e8ba8;background:#edf8ff;font-size:21rpx}
.health-section-title{margin:24rpx 0 12rpx}.health-list{display:grid;flex:1;min-height:0;grid-template-rows:repeat(3,minmax(0,1fr));gap:10rpx}.health-tip{display:flex;align-items:center;min-height:0;padding:14rpx 20rpx}.health-icon{display:flex;align-items:center;justify-content:center;flex:none;width:62rpx;height:62rpx;border-radius:19rpx;background:#fff1e9;font-size:30rpx}.health-copy{min-width:0;flex:1;margin-left:16rpx}.health-copy view{font-size:24rpx;font-weight:800}.health-copy text{display:-webkit-box;overflow:hidden;margin-top:5rpx;color:#938981;font-size:19rpx;line-height:1.4;-webkit-box-orient:vertical;-webkit-line-clamp:2}.health-side{display:flex;align-items:center;margin-left:10rpx}.health-side>text{margin-left:8rpx;color:#c2b6ae;font-size:34rpx}.health-badge{padding:7rpx 11rpx;border-radius:99rpx;color:#c27050;background:#ffede3;font-size:17rpx;white-space:nowrap}.health-detail-head{display:flex;align-items:center;padding:22rpx;border-radius:24rpx;background:linear-gradient(135deg,#fff1e9,#fff)}.detail-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;margin-right:18rpx;border-radius:23rpx;background:#ffe1d3;font-size:36rpx}.health-detail-head>view:last-child>view{font-size:29rpx;font-weight:900}.health-detail-head>view:last-child>text{display:block;margin-top:6rpx;color:#b36c50;font-size:20rpx}.detail-summary{margin:20rpx 4rpx;color:#6f655e;font-size:23rpx;line-height:1.7}.care-editor{margin:8rpx 0 20rpx;padding:0 18rpx;border-radius:22rpx;background:#fff7ed}.care-editor>.detail-title{padding-top:18rpx}.care-edit-row{display:flex;align-items:center;padding:14rpx 0;border-top:1rpx solid #f1dfd0}.care-edit-row>text{margin-right:13rpx;font-size:28rpx}.care-edit-row>view:nth-child(2){flex:1}.care-edit-row>view:nth-child(2)>view{font-size:22rpx;font-weight:800}.care-edit-row>view:nth-child(2)>text{display:block;margin-top:3rpx;color:#a18f81;font-size:18rpx}.care-date{display:flex;align-items:center;color:#ae704a;font-size:20rpx;font-weight:700}.care-date text{margin-left:8rpx;color:#c2b3a8;font-size:30rpx}.detail-title{margin:24rpx 0 12rpx;font-size:25rpx;font-weight:900}.advice-list{display:flex;flex-direction:column;gap:12rpx}.advice-item{display:flex;padding:17rpx;border-radius:18rpx;background:#faf6f2;color:#665d56;font-size:22rpx;line-height:1.55}.advice-item>text{display:flex;align-items:center;justify-content:center;flex:none;width:32rpx;height:32rpx;margin-right:12rpx;border-radius:50%;color:#fff;background:#70bf89;font-size:18rpx}.medical-note{margin:20rpx 0;padding:17rpx;border-radius:18rpx;color:#8c765f;background:#fff5dd;font-size:19rpx;line-height:1.5}.health-sheet{max-height:85vh;overflow-y:auto}
.close{ color:#aaa; font-size:42rpx; font-weight:400; }
.care-editor{padding-bottom:16rpx}.care-date{display:block}.care-manage{display:flex;align-items:center;justify-content:center;margin-top:10rpx;padding:15rpx;border-radius:16rpx;color:#8d664e;background:#fff;font-size:20rpx;font-weight:800}.care-manage text{margin-left:8rpx;font-size:28rpx}
.festival-sheet{padding-bottom:calc(20rpx + env(safe-area-inset-bottom))}.together-hero{padding:25rpx;border-radius:28rpx;text-align:center;color:#fff;background:linear-gradient(135deg,#ff8b64,#f2654a)}.together-paw{font-size:38rpx}.together-hero>view:nth-child(2){margin-top:7rpx;font-size:22rpx}.together-number{margin:4rpx 0;font-size:66rpx;font-weight:900}.together-number text{margin-left:6rpx;font-size:25rpx}.together-hero>text{font-size:19rpx;opacity:.86}.festival-scroll{height:54vh;margin-top:22rpx}.festival-event{position:relative;display:flex;align-items:center;min-height:92rpx;padding:8rpx 6rpx}.event-line{position:absolute;z-index:0;left:33rpx;top:68rpx;bottom:-28rpx;width:2rpx;background:#eadfd6}.event-icon{z-index:1;display:flex;align-items:center;justify-content:center;flex:none;width:62rpx;height:62rpx;border-radius:20rpx;background:#f1ece7;font-size:27rpx}.birthday-event .event-icon{background:#ffead9}.festival-event.upcoming .event-icon{background:#fff0c8}.festival-event.today .event-icon{background:#ffe0d5}.event-copy{flex:1;margin-left:16rpx}.event-copy view{font-size:24rpx;font-weight:800}.event-copy text{display:block;margin-top:5rpx;color:#a0968e;font-size:19rpx}.event-status{padding:7rpx 12rpx;border-radius:99rpx;color:#8e847c;background:#f1ece7;font-size:18rpx}.event-status.upcoming{color:#b17a32;background:#fff0cc}.event-status.today{color:#dd6243;background:#ffe5dc;font-weight:800}.milestone-title{margin:26rpx 0 10rpx;font-size:25rpx;font-weight:900}

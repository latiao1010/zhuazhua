.next-task-card{display:flex;align-items:center;margin-top:7rpx;padding:13rpx 14rpx;border:1rpx solid #f0e0d5;border-radius:22rpx;background:linear-gradient(135deg,#fff 0%,#fff7f0 100%);box-shadow:0 8rpx 22rpx rgba(103,76,53,.05)}.next-time{display:flex;align-items:center;justify-content:center;flex:none;width:108rpx;height:68rpx;flex-direction:column;border-radius:17rpx;color:#b85e42;background:#ffe9de}.next-time>text{font-size:24rpx;font-weight:900}.next-time>view{margin-top:2rpx;font-size:14rpx}.next-task-copy{min-width:0;flex:1;margin-left:13rpx}.next-task-copy>view{overflow:hidden;font-size:24rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.next-task-copy>view>text{margin-right:6rpx}.next-task-copy>text{display:block;margin-top:3rpx;color:#a0948b;font-size:17rpx}.next-task-card>button{display:flex;align-items:center;justify-content:center;width:94rpx;height:58rpx;margin:0;padding:0;border-radius:17rpx;color:#fff;background:#ff7453;font-size:19rpx;font-weight:900;line-height:1}
.status-grid{display:grid;margin-top:7rpx;grid-template-columns:repeat(2,minmax(0,1fr));gap:7rpx}.status-card{display:flex;align-items:center;min-width:0;height:76rpx;box-sizing:border-box;padding:0 11rpx 0 14rpx;border:1rpx solid #eee6df;border-radius:19rpx;background:rgba(255,255,255,.9)}.status-icon{flex:none;margin-right:10rpx;font-size:25rpx;line-height:1}.status-card>view:nth-child(2){min-width:0;flex:1}.status-card>view:nth-child(2)>text{display:block;color:#9f948c;font-size:14rpx}.status-card>view:nth-child(2)>view{overflow:hidden;margin-top:2rpx;color:#5f5650;font-size:17rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.status-card>text{margin-left:5rpx;color:#c4b9b1;font-size:24rpx}.status-card.good{border-color:#dfeee3;background:#f5fbf7}.status-card.good>view:nth-child(2)>view{color:#58886a}.status-card.watch{border-color:#f2dfd2;background:#fff8f3}.status-card.watch>view:nth-child(2)>view{color:#c36b4d}.status-card.attention{border-color:#f0d6cf;background:#fff2ee}.status-card.attention>view:nth-child(2)>view{color:#c8584b}.status-card.neutral{background:#fbf9f7}
.task-block{min-height:0}.task-progress{height:6rpx;margin:7rpx 2rpx 8rpx;overflow:hidden;border-radius:99rpx;background:#f1e9e3}.task-progress>view{height:100%;border-radius:99rpx;background:linear-gradient(90deg,#ff9a78,#ff704f);transition:width .2s}.task-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7rpx}.task-item{display:flex;align-items:center;min-width:0;height:67rpx;padding:0 10rpx;border:1rpx solid #eee6df;border-radius:17rpx;background:rgba(255,255,255,.88)}.task-item.done{border-color:#e3eee5;background:#f8fcf9}.task-check{display:flex;align-items:center;justify-content:center;flex:none;width:26rpx;height:26rpx;margin-right:8rpx;border:2rpx solid #d8ccc4;border-radius:8rpx;color:#fff;font-size:16rpx;font-weight:900}.task-item.done .task-check{border-color:#6fb482;background:#6fb482}.task-copy{min-width:0;flex:1}.task-copy>view{overflow:hidden;color:#4b443f;font-size:19rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.task-copy>view>text{margin-right:4rpx;font-size:18rpx}.task-copy>text{display:block;overflow:hidden;margin-top:2rpx;color:#a69a91;font-size:14rpx;text-overflow:ellipsis;white-space:nowrap}.task-item.done .task-copy>view{color:#6f7d73}.task-arrow{margin-left:4rpx;color:#c8bdb5;font-size:24rpx}
.finding-block{display:flex;flex-direction:column;min-height:0;flex:1 1 auto}.finding-list{display:grid;min-height:0;flex:1 1 auto;align-content:space-between;margin-top:9rpx;grid-template-columns:1fr;grid-template-rows:repeat(4,minmax(56rpx,96rpx));gap:8rpx}.knowledge-card{margin-top:auto}.finding-row{display:flex;align-items:center;min-width:0;min-height:0;padding:0 16rpx;box-sizing:border-box;border:1rpx solid #eee4dc;border-radius:18rpx;background:rgba(255,255,255,.9);box-shadow:0 5rpx 15rpx rgba(94,71,51,.035)}.finding-row>text{display:flex;align-items:center;justify-content:center;flex:none;width:34rpx;height:34rpx;margin-right:12rpx;border-radius:11rpx;font-size:19rpx}.finding-row>view{overflow:hidden;min-width:0;color:#695f59;font-size:18rpx;white-space:nowrap;text-overflow:ellipsis}.finding-row.blue>text{background:#e9f6fc}.finding-row.green>text{background:#eaf7ee}.finding-row.purple>text{background:#efefff}.finding-row.orange>text{background:#fff0e5}.finding-row.cream>text{background:#fff7e5}
.knowledge-card{display:flex;align-items:center;flex:none;min-height:70rpx;margin-top:13rpx;padding:10rpx 14rpx;border:1rpx solid #efe2d5;border-radius:21rpx;background:linear-gradient(135deg,#fff7e7,#fff)}.knowledge-icon{display:flex;align-items:center;justify-content:center;flex:none;width:47rpx;height:47rpx;margin-right:11rpx;border-radius:15rpx;background:#ffeccb;font-size:25rpx}.knowledge-card>view:nth-child(2){min-width:0;flex:1}.knowledge-card>view:nth-child(2)>text{color:#a1764f;font-size:15rpx;font-weight:800}.knowledge-card>view:nth-child(2)>view{overflow:hidden;margin-top:2rpx;color:#443c36;font-size:20rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.knowledge-card>text{color:#c5b4a7;font-size:30rpx}
.knowledge-sheet{max-height:82vh;overflow-y:auto}.knowledge-hero{display:flex;align-items:center;padding:23rpx;border-radius:25rpx;background:linear-gradient(135deg,#fff4dc,#fffaf2)}.knowledge-hero>text{display:flex;align-items:center;justify-content:center;flex:none;width:76rpx;height:76rpx;margin-right:17rpx;border-radius:23rpx;background:#ffe7b7;font-size:36rpx}.knowledge-hero>view>view{font-size:27rpx;font-weight:900}.knowledge-hero>view>text{display:block;margin-top:7rpx;color:#8e7c6c;font-size:19rpx;line-height:1.45}.knowledge-points{margin:18rpx 0}.knowledge-points>view{display:flex;align-items:flex-start;padding:15rpx 4rpx;border-bottom:1rpx solid #f0e8e1;color:#625952;font-size:21rpx;line-height:1.55}.knowledge-points>view>text{display:flex;align-items:center;justify-content:center;flex:none;width:31rpx;height:31rpx;margin:1rpx 12rpx 0 0;border-radius:50%;color:#fff;background:#ef8a64;font-size:16rpx;font-weight:900}

@import "../shared/weight-sheet.wxss";
.records-page{padding:32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}
.records-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.records-heading>view{min-width:0}.records-heading .eyebrow{font-size:24rpx;letter-spacing:0;font-weight:400;color:var(--muted)}.records-heading>text{font-size:23rpx;color:var(--muted);flex:none}.records-heading .page-title{font-size:40rpx;margin-top:12rpx}.records-intro{margin:20rpx 0 28rpx;font-size:25rpx;color:var(--muted);line-height:1.6}.records-readonly{margin-bottom:22rpx;padding:20rpx;border-radius:20rpx;background:#edf8f2;color:#628674;font-size:24rpx;line-height:1.6}
.record-overview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.record-overview{overflow:hidden;min-width:0;border:1rpx solid var(--line);border-radius:28rpx;background:#fff}.record-overview.peach{background:#fff2e9}.record-overview.mint{background:#f0faf5}.record-overview.cream{background:#fff8eb}.record-overview.blue{background:#f1f8fb}.record-overview-link{padding:24rpx 22rpx 18rpx}.record-overview-title{display:flex;justify-content:space-between;font-size:29rpx;font-weight:600}.record-overview-title>text{color:#b69d8e}.record-overview-value{margin:20rpx 0 8rpx;font-size:42rpx;font-weight:600;word-break:break-all}.record-overview-value>text{font-size:23rpx;font-weight:400;margin-left:8rpx;color:var(--muted)}.record-overview-caption{font-size:23rpx;color:var(--muted);line-height:1.5}.record-overview-history{margin-top:14rpx;font-size:22rpx;color:#a0806c;line-height:1.5}.record-overview button{width:calc(100% - 40rpx)!important;margin:0 20rpx 20rpx;padding:16rpx 8rpx;border-radius:18rpx;background:#fff;color:#985e46;line-height:1.5;font-size:25rpx}
.weight-entry{padding:26rpx}.weight-entry-link{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.weight-entry-link>view>text{font-size:24rpx;color:var(--muted)}.weight-entry-link>view:first-child>view{margin-top:10rpx;font-size:40rpx;font-weight:600}.weight-entry-link>view:first-child>view>text{font-size:23rpx;margin-left:8rpx;font-weight:400}.weight-entry-link>view:last-child{min-width:0;text-align:right}.weight-entry-link>view:last-child>view{margin-top:12rpx;font-size:24rpx;color:#a66c52}.weight-entry button{width:100%!important;margin:24rpx 0 0;padding:18rpx;border-radius:20rpx;background:#fff0e5;color:#995e45;font-size:25rpx;line-height:1.5}.records-export{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:28rpx;padding:28rpx;border:1rpx solid var(--line);border-radius:26rpx;background:#fff}.records-export>view>view{font-size:28rpx;font-weight:600}.records-export>view>text{display:block;margin-top:8rpx;font-size:23rpx;line-height:1.6;color:var(--muted)}.records-export>text{color:#b2917b;font-size:32rpx}
@media(max-width:360px){.records-page{padding-left:22rpx;padding-right:22rpx}.record-overview-grid{gap:12rpx}.record-overview-link{padding:22rpx 18rpx}.weight-entry-link{align-items:flex-start}}

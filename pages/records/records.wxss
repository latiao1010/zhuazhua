@import "../shared/weight-sheet.wxss";
@import "../account/account.wxss";

/* 记录页：紧凑的日常卡片、整组护理面板和独立用品入口。 */
page { height:100%; overflow:hidden; background:var(--cream); }
/* 固定一屏；保留模块排列，日常卡片随剩余高度伸缩。底部留给悬浮入口。 */
.records-screen { height:100vh; overflow:hidden; }
.records-page { --record-ink:#354b40; display:flex; flex-direction:column; height:100%; min-height:0; max-width:960rpx; margin:0 auto; padding:12rpx 28rpx 64px; color:var(--record-ink); }
.records-page>view,.records-page>button { flex-shrink:0; }
.record-button { display:block; width:auto!important; min-height:0; margin:0; padding:0; border:0; border-radius:0; background:transparent; color:inherit; font-size:26rpx; font-weight:400; line-height:1.4; text-align:left; box-sizing:border-box; }
.record-button::after { border:0; }
.record-pressed { opacity:.65; }
.records-header { padding:0 4rpx; }
.records-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.records-kicker { color:#899185; font-size:22rpx; letter-spacing:2rpx; }
.records-date { color:#727f72; font-size:22rpx; font-variant-numeric:tabular-nums; padding:6rpx 14rpx; border-radius:999rpx; background:var(--brand-soft); }
.records-identity { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-top:8rpx; }
.records-identity>view { flex:1; min-width:0; }
.records-title { color:#304d3d; font-size:34rpx; font-weight:600; line-height:1.3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.records-subtitle { display:block; margin-top:2rpx; color:#7c887b; font-size:22rpx; line-height:1.5; }
.records-avatar { flex:none; width:66rpx; height:66rpx; border:4rpx solid #fff; border-radius:50%; background:#f8eddf; }
.records-readonly { margin-top:8rpx; padding:6rpx 14rpx; border-radius:12rpx; background:#eaf1e5; color:#61765b; font-size:21rpx; line-height:1.4; }
.weight-strip { display:flex; align-items:center; gap:16rpx; margin-top:12rpx; padding:0 22rpx; border:1rpx solid #dce8df; border-radius:28rpx; background:linear-gradient(110deg,#e8f2eb,#f2f7f1); }
.weight-detail { display:flex; align-items:center; justify-content:space-between; flex:1; min-width:0; gap:12rpx; min-height:98rpx; padding:14rpx 0; }
.weight-copy>view { color:#506749; font-size:24rpx; font-weight:500; }
.weight-copy>text { display:block; margin-top:3rpx; color:#71806b; font-size:22rpx; line-height:1.4; }
.weight-number { color:#385438; font-size:39rpx; font-weight:600; white-space:nowrap; }
.weight-number>text { margin-left:5rpx; color:#75846b; font-size:22rpx; font-weight:400; }
.weight-update { flex:none; padding:12rpx 16rpx; border-radius:999rpx; background:#fff; color:#53664a; font-size:21rpx; line-height:1.5; }
.records-section-head,.records-care .care-compact-heading { display:flex; flex-wrap:nowrap; align-items:center; justify-content:space-between; gap:10rpx; margin:18rpx 4rpx 10rpx; }
.records-section-head>view,.records-care .care-compact-heading>view { color:#3e5043; font-size:26rpx; font-weight:600; line-height:1.4; }
.records-section-head>text,.records-care .care-compact-heading>text { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#7c8779; font-size:22rpx; line-height:1.5; }
.records-page>.daily-ledger { flex:1; min-height:0; }
.daily-ledger { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); grid-template-rows:repeat(2,minmax(0,1fr)); gap:12rpx; }
.ledger-row { position:relative; min-width:0; border:1rpx solid var(--line); border-radius:24rpx; background:#fff; overflow:hidden; }
.ledger-detail { display:flex; flex-direction:column; justify-content:center; width:100%!important; height:100%; min-height:0; padding:12rpx 20rpx; }
.ledger-heading { display:flex; align-items:center; gap:8rpx; color:#64715f; font-size:23rpx; }
.ledger-icon { display:flex; align-items:center; justify-content:center; flex:none; width:30rpx; height:30rpx; }
.record-icon { width:30rpx; height:30rpx; background:center/contain no-repeat; }
.ledger-chevron { margin-left:auto; color:#a8b29f; font-size:25rpx; }
.ledger-number { margin-top:4rpx; padding-right:52rpx; color:#354e3d; font-size:34rpx; font-weight:600; line-height:1.2; font-variant-numeric:tabular-nums; }
.ledger-number>text { margin-left:5rpx; color:#788371; font-size:19rpx; font-weight:400; }
.ledger-number.ledger-empty { color:#9ca894; }
.ledger-caption { display:block; margin-top:3rpx; padding-right:46rpx; color:#7b8574; font-size:22rpx; line-height:1.4; }
.ledger-add { position:absolute; right:8rpx; bottom:4rpx; display:flex; align-items:center; justify-content:center; width:72rpx!important; height:80rpx; }
.ledger-add>text { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; border-radius:50%; background:var(--brand-soft); color:#65815c; font-size:32rpx; line-height:1; }
.records-care .care-compact-grid { gap:0; padding:4rpx; border:1rpx solid var(--line); border-radius:26rpx; background:#fff; overflow:hidden; }
.records-care { display:flex; flex-direction:column; }
.records-care .care-compact-item { min-width:0; margin:2rpx; padding:12rpx 14rpx; border:0; border-radius:18rpx; background:transparent; }
.records-care .care-compact-item>view { color:#50624b; font-size:24rpx; font-weight:500; line-height:1.4; }
.records-care .care-compact-item>view>text { color:#b1baa8; font-size:23rpx; }
.records-care .care-compact-item>text { margin-top:3rpx; color:#7a8870; font-size:22rpx; line-height:1.5; }
.records-care .care-compact-item.needs-attention { background:#fff0df; }
.records-care .care-compact-item>.today,.records-care .care-compact-item>.overdue { color:#b56f42; font-weight:600; }
.records-care .care-compact-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; padding:0; background:transparent; border-radius:0; }
.records-care .care-compact-row { position:relative; display:block; min-height:92rpx; padding:14rpx 38rpx 14rpx 20rpx; border:1rpx solid var(--line); border-radius:22rpx; background:#fff; }
.records-care .care-compact-row+.care-compact-row { border-top:1rpx solid var(--line); }
.records-care .care-compact-row>view { color:#53634c; font-size:24rpx; }
.records-care .care-compact-row>text { display:block; max-width:none; margin-top:4rpx; color:#7d876f; font-size:21rpx; text-align:left; }
.records-care .care-compact-row>text:last-child { position:absolute; right:16rpx; top:24rpx; color:#aab49d; font-size:25rpx; margin:0; }
.records-advisor-float { position:fixed; right:16px; bottom:12px; z-index:10; display:flex; align-items:center; justify-content:center; gap:8px; width:144px; height:44px; padding:0 12px; border:1px solid #d6e4d9; border-radius:99px; background:#edf4ee; color:var(--brand); box-shadow:0 4px 14px rgba(53,80,63,.12); box-sizing:border-box; font-size:14px; font-weight:500; white-space:nowrap; }
.advisor-float-arrow { color:#8ca394; font-size:20px; line-height:1; }
.records-advisor-float.advisor-float-hidden { display:none; }
.records-export { display:flex; align-items:center; width:100%!important; gap:16rpx; margin-top:12rpx; padding:14rpx 20rpx; border:1rpx solid var(--line); border-radius:24rpx; background:#fff; }
.export-icon { display:flex; align-items:center; justify-content:center; flex:none; width:48rpx; height:52rpx; }
.export-copy { flex:1; min-width:0; }
.export-copy>view { color:var(--ink); font-size:25rpx; font-weight:500; }
.export-copy>text { display:block; margin-top:5rpx; color:var(--muted); font-size:22rpx; line-height:1.5; }
.export-arrow { color:#8ca394; font-size:29rpx; }
/* 短屏只压缩尺寸与留白，不改变列数、内容顺序或功能入口。 */
@media(max-height:660px) {
  .records-page { padding-top:8rpx; }
  .records-date { padding-top:2rpx; padding-bottom:2rpx; }
  .records-identity { margin-top:4rpx; }
  .records-title { font-size:30rpx; }
  .records-avatar { width:54rpx; height:54rpx; }
  .weight-strip { margin-top:8rpx; }
  .weight-detail { min-height:80rpx; padding-top:6rpx; padding-bottom:6rpx; }
  .records-section-head,.records-care .care-compact-heading { margin-top:12rpx; margin-bottom:8rpx; }
  .daily-ledger { gap:8rpx; }
  .ledger-detail { padding-top:6rpx; padding-bottom:6rpx; }
  .ledger-number { font-size:30rpx; margin-top:2rpx; }
  .ledger-caption { margin-top:2rpx; font-size:20rpx; }
  .records-care .care-compact-item { padding-top:6rpx; padding-bottom:6rpx; }
  .records-care .care-compact-row { min-height:76rpx; padding-top:8rpx; padding-bottom:8rpx; }
  .records-export { margin-top:8rpx; padding-top:8rpx; padding-bottom:8rpx; }
  .export-copy>text { margin-top:2rpx; }
}
@media(max-height:560px) {
  .records-page { padding-top:4rpx; }
  .records-kicker,.records-date { font-size:20rpx; }
  .records-title { font-size:28rpx; }
  .records-subtitle { font-size:20rpx; line-height:1.3; }
  .records-avatar { width:48rpx; height:48rpx; }
  .records-section-head,.records-care .care-compact-heading { margin-top:8rpx; margin-bottom:6rpx; }
  .records-section-head>view,.records-care .care-compact-heading>view { font-size:24rpx; }
  .weight-copy>text { margin-top:0; font-size:20rpx; }
  .weight-detail { min-height:72rpx; padding-top:4rpx; padding-bottom:4rpx; }
  .ledger-icon,.record-icon { width:26rpx; height:26rpx; }
  .ledger-number { font-size:28rpx; }
  .ledger-caption { line-height:1.2; }
  .ledger-add { width:64rpx!important; height:64rpx; bottom:0; right:4rpx; }
  .ledger-add>text { width:42rpx; height:42rpx; }
  .records-care .care-compact-item { padding-top:4rpx; padding-bottom:4rpx; }
  .records-care .care-compact-item>text { font-size:20rpx; line-height:1.3; }
  .records-care .care-compact-row { min-height:68rpx; padding-top:6rpx; padding-bottom:6rpx; }
  .records-care .care-compact-row>text { margin-top:2rpx; font-size:20rpx; line-height:1.3; }
  .records-export { padding-top:6rpx; padding-bottom:6rpx; }
  .export-copy>text { font-size:20rpx; line-height:1.3; }
  .records-readonly-page .records-section-head,.records-readonly-page .care-compact-heading { margin-top:4rpx; }
}
@media(max-width:360px) {
  .records-page { padding-left:22rpx; padding-right:22rpx; }
  .weight-strip { gap:10rpx; padding-left:16rpx; padding-right:16rpx; }
  .weight-update { padding-left:12rpx; padding-right:12rpx; }
  .weight-number { font-size:35rpx; }
  .ledger-detail { padding-left:16rpx; padding-right:16rpx; }
  .records-care .care-compact-item { padding-left:10rpx; padding-right:10rpx; }
}

@import "../shared/weight-sheet.wxss";
@import "../account/account.wxss";

/* 记录页：紧凑的日常卡片、整组护理面板和独立用品入口。 */
page { background:#f6f5f0; }
.records-page { --record-ink:#354b40; max-width:960rpx; margin:0 auto; padding:16rpx 28rpx 96rpx; color:var(--record-ink); }
.record-button { display:block; width:auto!important; min-height:0; margin:0; padding:0; border:0; border-radius:0; background:transparent; color:inherit; font-size:26rpx; font-weight:400; line-height:1.4; text-align:left; box-sizing:border-box; }
.record-button::after { border:0; }
.record-pressed { opacity:.65; }
.records-header { padding:0 4rpx; }
.records-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.records-kicker { color:#899185; font-size:20rpx; letter-spacing:2rpx; }
.records-date { color:#727f72; font-size:20rpx; font-variant-numeric:tabular-nums; padding:6rpx 14rpx; border-radius:999rpx; background:#eaece4; }
.records-identity { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-top:8rpx; }
.records-identity>view { flex:1; min-width:0; }
.records-title { color:#304d3d; font-size:34rpx; font-weight:600; line-height:1.3; overflow-wrap:break-word; }
.records-subtitle { display:block; margin-top:2rpx; color:#7c887b; font-size:22rpx; line-height:1.5; }
.records-avatar { flex:none; width:66rpx; height:66rpx; border:4rpx solid #fff; border-radius:50%; background:#f8eddf; }
.records-readonly { margin-top:16rpx; padding:14rpx 18rpx; border-radius:16rpx; background:#eaf1e5; color:#61765b; font-size:22rpx; line-height:1.5; }
.weight-strip { display:flex; align-items:center; gap:16rpx; margin-top:12rpx; padding:0 22rpx; border:1rpx solid #dce6d8; border-radius:28rpx; background:linear-gradient(110deg,#e5ecdd,#edf1e8); }
.weight-detail { display:flex; align-items:center; justify-content:space-between; flex:1; min-width:0; gap:12rpx; min-height:98rpx; padding:14rpx 0; }
.weight-copy>view { color:#506749; font-size:24rpx; font-weight:500; }
.weight-copy>text { display:block; margin-top:3rpx; color:#71806b; font-size:20rpx; line-height:1.4; }
.weight-number { color:#385438; font-size:39rpx; font-weight:600; white-space:nowrap; }
.weight-number>text { margin-left:5rpx; color:#75846b; font-size:20rpx; font-weight:400; }
.weight-update { flex:none; padding:12rpx 16rpx; border-radius:999rpx; background:#fffaf0; color:#53664a; font-size:21rpx; line-height:1.5; }
.records-section-head,.records-care .care-compact-heading { display:flex; align-items:center; justify-content:space-between; gap:10rpx; margin:24rpx 4rpx 12rpx; }
.records-section-head>view,.records-care .care-compact-heading>view { color:#3e5043; font-size:26rpx; font-weight:600; line-height:1.4; }
.records-section-head>text,.records-care .care-compact-heading>text { color:#7c8779; font-size:20rpx; line-height:1.5; }
.daily-ledger { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; }
.ledger-row { position:relative; min-width:0; border:1rpx solid #e7e8df; border-radius:24rpx; background:#fffefa; overflow:hidden; }
.ledger-detail { display:block; width:100%!important; min-height:162rpx; padding:20rpx 20rpx; }
.ledger-heading { display:flex; align-items:center; gap:8rpx; color:#64715f; font-size:23rpx; }
.ledger-icon { display:flex; align-items:center; justify-content:center; flex:none; width:30rpx; height:30rpx; }
.record-icon { width:30rpx; height:30rpx; background:center/contain no-repeat; }
.ledger-chevron { margin-left:auto; color:#a8b29f; font-size:25rpx; }
.ledger-number { margin-top:4rpx; padding-right:52rpx; color:#354e3d; font-size:34rpx; font-weight:600; line-height:1.2; font-variant-numeric:tabular-nums; }
.ledger-number>text { margin-left:5rpx; color:#788371; font-size:19rpx; font-weight:400; }
.ledger-number.ledger-empty { color:#9ca894; }
.ledger-caption { display:block; margin-top:3rpx; padding-right:46rpx; color:#7b8574; font-size:20rpx; line-height:1.4; }
.ledger-add { position:absolute; right:8rpx; bottom:4rpx; display:flex; align-items:center; justify-content:center; width:72rpx!important; height:80rpx; }
.ledger-add>text { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; border-radius:50%; background:#edf1e6; color:#65815c; font-size:32rpx; line-height:1; }
.records-care .care-compact-grid { gap:0; padding:4rpx; border:1rpx solid #e7e8df; border-radius:26rpx; background:#fffefa; overflow:hidden; }
.records-care .care-compact-item { min-width:0; margin:2rpx; padding:16rpx 14rpx; border:0; border-radius:18rpx; background:transparent; }
.records-care .care-compact-item>view { color:#50624b; font-size:24rpx; font-weight:500; line-height:1.4; }
.records-care .care-compact-item>view>text { color:#b1baa8; font-size:23rpx; }
.records-care .care-compact-item>text { margin-top:3rpx; color:#7a8870; font-size:20rpx; line-height:1.5; }
.records-care .care-compact-item.needs-attention { background:#fff0df; }
.records-care .care-compact-item>.today,.records-care .care-compact-item>.overdue { color:#b56f42; font-weight:600; }
.records-care .care-compact-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; padding:0; background:transparent; border-radius:0; }
.records-care .care-compact-row { position:relative; display:block; min-height:92rpx; padding:14rpx 38rpx 14rpx 20rpx; border:1rpx solid #e7e8df; border-radius:22rpx; background:#fffefa; }
.records-care .care-compact-row+.care-compact-row { border-top:1rpx solid #e7e8df; }
.records-care .care-compact-row>view { color:#53634c; font-size:24rpx; }
.records-care .care-compact-row>text { display:block; max-width:none; margin-top:4rpx; color:#7d876f; font-size:21rpx; text-align:left; }
.records-care .care-compact-row>text:last-child { position:absolute; right:16rpx; top:24rpx; color:#aab49d; font-size:25rpx; margin:0; }
.records-care .care-advisor-heading { display:none; }
.records-care .care-advisor-card { position:fixed; right:24rpx; bottom:112rpx; z-index:20; display:flex; align-items:center; gap:8rpx; width:212rpx; height:70rpx; min-height:70rpx; margin:0; padding:0 17rpx; border:1rpx solid #efdfcf; border-radius:999rpx; background:#fffaf3; box-shadow:0 9rpx 22rpx rgba(106,88,66,.14); box-sizing:border-box; }
.records-care .care-advisor-copy { flex:1; min-width:0; }
.records-care .care-advisor-copy>view { color:#725b48; font-size:24rpx; font-weight:600; white-space:nowrap; }
.records-care .care-advisor-arrow { color:#bd9b7a; font-size:26rpx; }
.records-export { display:flex; align-items:center; width:100%!important; gap:16rpx; margin-top:12rpx; padding:12rpx 20rpx; border:1rpx solid #e9e4d8; border-radius:24rpx; background:#f0ede4; }
.export-icon { display:flex; align-items:center; justify-content:center; flex:none; width:48rpx; height:52rpx; }
.export-copy { flex:1; min-width:0; }
.export-copy>view { color:#6f614c; font-size:25rpx; font-weight:500; }
.export-copy>text { display:block; margin-top:5rpx; color:#8b816e; font-size:20rpx; line-height:1.5; }
.export-arrow { color:#a99170; font-size:29rpx; }
/* 小屏仅适度调整外部留白，保留卡片内的阅读空间。 */
@media(max-height:620px) {
  .records-page { padding-top:14rpx; padding-bottom:92rpx; }
  .records-section-head,.records-care .care-compact-heading { margin-top:22rpx; }
}
@media(max-width:360px) {
  .records-page { padding-left:22rpx; padding-right:22rpx; }
  .weight-strip { gap:10rpx; padding-left:16rpx; padding-right:16rpx; }
  .weight-update { padding-left:12rpx; padding-right:12rpx; }
  .weight-number { font-size:35rpx; }
  .ledger-detail { padding-left:16rpx; padding-right:16rpx; }
  .records-care .care-compact-item { padding-left:10rpx; padding-right:10rpx; }
}

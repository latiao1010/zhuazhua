  <view class="care-compact-heading"><view>护理计划</view><text>点选项目查看记录与提醒</text></view>
  <view class="care-compact-grid">
    <view class="care-compact-item {{careView.deworming.attentionClass}}" data-key="deworming" bindtap="openCareDetail"><view>驱虫<text>›</text></view><text class="{{careView.deworming.countdownClass}}">{{careView.deworming.countdown}}</text></view>
    <view class="care-compact-item {{careView.medicine.attentionClass}}" data-key="medicine" bindtap="openCareDetail"><view>用药<text>›</text></view><text class="{{careView.medicine.countdownClass}}">{{careView.medicine.countdown}}</text></view>
    <view class="care-compact-item {{careView.vaccine.attentionClass}}" data-key="vaccine" bindtap="openCareDetail"><view>疫苗<text>›</text></view><text class="{{careView.vaccine.countdownClass}}">{{careView.vaccine.countdown}}</text></view>
    <view class="care-compact-item {{careView.bath.attentionClass}}" data-key="bath" bindtap="openCareDetail"><view>洗澡<text>›</text></view><text class="{{careView.bath.countdownClass}}">{{careView.bath.countdown}}</text></view>
    <view class="care-compact-item {{careView.dental.attentionClass}}" data-key="dental" bindtap="openCareDetail"><view>刷牙<text>›</text></view><text class="{{careView.dental.countdownClass}}">{{careView.dental.countdown}}</text></view>
    <view class="care-compact-item {{careView.nail.attentionClass}}" data-key="nail" bindtap="openCareDetail"><view>剪指甲<text>›</text></view><text class="{{careView.nail.countdownClass}}">{{careView.nail.countdown}}</text></view>
  </view>
  <view class="care-compact-heading"><view>用品与咨询</view></view>
  <view class="care-compact-list">
    <view class="care-compact-row" data-key="dogFood" bindtap="openSupply"><view>狗粮余量</view><text>{{supplyView.dogFood.daysText}}</text><text>›</text></view>
    <view class="care-compact-row" data-key="snack" bindtap="openSupply"><view>零食余量</view><text>{{supplyView.snack.daysText}}</text><text>›</text></view>
    <view class="care-compact-row" bindtap="openAdvisor"><view>养护问答</view><text>结合日常记录给建议</text><text>›</text></view>
  </view>

.weight-sheet { max-height: 88vh; overflow: hidden; overflow-y: auto; }
.weight-hero { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; border-radius: 26rpx; background: var(--cream); }
.weight-hero>view:first-child>text,.weight-change>text { color: #9d8b80; font-size: 22rpx; }
.weight-hero>view:first-child>view { margin-top: 4rpx; color: #3d342f; font-size: 48rpx; font-weight: 600; }
.weight-hero>view:first-child>view text { margin-left: 5rpx; font-size: 22rpx; }
.weight-change { padding: 12rpx 16rpx; border-radius: 26rpx; text-align: right; background: rgba(255,255,255,.7); }
.weight-change>view { margin-top: 4rpx; font-size: 22rpx; font-weight: 600; }
.weight-change.up>view { color: #d27655; }
.weight-change.down>view { color: #5d9271; }
.weight-change.stable>view { color: #81756d; }
.weight-chart-card { margin-top: 20rpx; padding: 21rpx 18rpx 17rpx; border: 1rpx solid #f0e5de; border-radius: 25rpx; background: #fff; }
.weight-chart-title { display: flex; align-items: center; justify-content: space-between; }
.weight-chart-title>view { font-size: 22rpx; font-weight: 600; }
.weight-chart-title>text { color: #a3978e; font-size: 22rpx; }
.weight-chart { display: flex; align-items: flex-end; justify-content: space-around; height: 220rpx; margin-top: 13rpx; padding: 0 5rpx; border-bottom: 1rpx solid #eee3dc; }
.weight-column { display: flex; align-items: center; flex: 1; min-width: 0; flex-direction: column; }
.weight-value { height: 32rpx; color: #80746c; font-size: 22rpx; font-weight: 600; }
.weight-bar-area { display: flex; align-items: flex-end; justify-content: center; width: 100%; height: 125rpx; }
.weight-bar { width: 26rpx; min-height: 12rpx; border-radius: 99rpx 99rpx 8rpx 8rpx; background: #f3c3ab; }
.weight-bar.latest { background: var(--orange); box-shadow: none; }
.weight-date { margin-top: 10rpx; color: #a19790; font-size: 20rpx; }
.weight-empty-tip { margin-top: 14rpx; color: #a0948c; text-align: center; font-size: 22rpx; }
.weight-history-title { margin: 22rpx 3rpx 9rpx; font-size: 23rpx; font-weight: 600; }
.weight-history { border-radius: 26rpx; background: var(--cream); }
.weight-history-row { display: flex; align-items: center; padding: 0 18rpx; border-bottom: 1rpx solid #eee5df; color: #80756d; font-size: 22rpx; gap: 16rpx; }
.weight-history-row>view { color: #3e3631; font-size: 22rpx; font-weight: 600; }
.weight-history-row>view text { margin-left: 4rpx; color: var(--muted); font-size: 22rpx; font-weight: 400; }
.weight-note { margin-top: 16rpx; padding: 14rpx 16rpx; border-radius: 16rpx; color: #8d7d72; background: #fff4e5; font-size: 22rpx; line-height: 1.5; }
.weight-history { height: 240rpx; background: var(--cream); }
.weight-history-row { justify-content: space-between; min-height: 96rpx; padding: 0 18rpx; gap: 16rpx; }
.weight-history-copy { min-width: 0; flex: 1; }
.weight-history-row>.weight-history-copy { color: #3e3631; font-size: 22rpx; font-weight: 600; }
.weight-history-copy>text { display: block; }
.weight-history-copy>view { overflow: hidden; margin-top: 4rpx; color: #948981; font-size: 22rpx; font-weight: 500; text-overflow: ellipsis; white-space: normal; line-height: 1.5; }
.weight-history-row>.weight-history-value { flex: none; margin-left: 18rpx; color: #3e3631; font-size: 22rpx; font-weight: 600; }
.weight-history-value>text { margin-left: 4rpx; color: #8d827a; font-size: 22rpx; font-weight: 500; }

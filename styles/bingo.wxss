.bingo-heading{display:flex;justify-content:space-between;gap:16rpx;margin:32rpx 0 18rpx;font-size:24rpx;color:var(--muted)}.bingo-heading>text:last-child{color:#718d75;padding:0 8rpx}.bingo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin:20rpx 0}.bingo-cell{position:relative;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;width:100%!important;min-width:0;min-height:146rpx;margin:0!important;padding:18rpx 6rpx!important;border:2rpx solid #eee9e2;border-radius:20rpx;background:#f8f6f2;color:#8d8178;font-size:24rpx!important;font-weight:400;line-height:1.5!important;word-break:break-all}.bingo-cell::after{border:0}.bingo-cell.checked{background:#eaf4e6;border-color:#c0d6b8;color:#4f7158}.bingo-cell.winning{border-color:#83ab87;box-shadow:inset 0 0 0 1rpx #83ab87}.bingo-check{display:flex;align-items:center;justify-content:center;width:32rpx;height:32rpx;border-radius:50%;background:#fff;color:#b7a99b;font-size:23rpx}.checked .bingo-check{background:#8faf89;color:#fff}.bingo-summary{font-size:25rpx;color:#6e8b72;line-height:1.8;text-align:center;margin:16rpx 0 28rpx}.bingo-summary>text{font-size:22rpx}.bingo-result-title{font-size:28rpx;color:#8b9f80;margin-top:22rpx}.bingo-result-count{font-size:30rpx;color:#67866d;margin:14rpx 0 26rpx}.bingo-result-count>text{font-size:58rpx;font-weight:600}.result-card.bingo{background:#fdfffb;border-color:#dfeddf}
.bingo-invite{padding:24rpx;margin-top:28rpx;border-radius:20rpx;background:#f0f5e9;color:#668069;font-size:28rpx;font-weight:600}.bingo-invite>text{display:block;font-size:23rpx;line-height:1.7;color:#8b9680;margin-top:12rpx;font-weight:400}.bingo-peer{font-size:25rpx;color:#748b6e;word-break:break-all;line-height:1.8;margin:16rpx 0}.bingo-peer>text{display:block;font-size:23rpx;color:#8a9b82}.bingo-cell.common{background:#dcecd4;border-color:#89ad80}.bingo-cell.peer-only{background:#fff0e1;border-color:#ead0af;color:#a07b53}.bingo-check.compare-check{width:auto;min-width:48rpx;padding:0 8rpx;border-radius:10rpx;font-size:19rpx}.bingo-compare-invite{padding:28rpx;margin:24rpx 0;border-radius:24rpx;background:#eff6e9;text-align:center;color:#607b5c;font-size:29rpx}.bingo-compare-invite>text{display:block;font-size:22rpx;color:#87977d;margin-top:16rpx}.bingo-compare-invite button{margin-top:20rpx;white-space:normal;word-break:break-all}
